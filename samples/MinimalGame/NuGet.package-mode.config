<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The package lane names this file on its restore. Its own packages folder keeps the 0.0.0 pack out of
       the machine's, where a stale copy would outlive the next pack. -->
  <config>
    <add key="globalPackagesFolder" value="../../artifacts/package-consumer-cache" />
  </config>
  <packageSources>
    <clear />
    <add key="capsule-local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
