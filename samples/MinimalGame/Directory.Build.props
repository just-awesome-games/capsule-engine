<Project>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- What sitting inside the engine repository forces, and nothing a game copies. The packages are
       the ones this tree just packed into artifacts/packages, at the engine's VersionPrefix, and the
       release lane passes its own CapsuleVersion. The sample builds from this engine source unless
       -p:CapsuleSourcePath= empties the path. Source mode restores without the local feed, which
       exists only after a pack and which NuGet rejects when missing (NU1301). Under the engine's
       solution the sample takes the engine's configuration, and the engine's pack walks it. -->
  <PropertyGroup>
    <CapsuleVersion Condition="'$(CapsuleVersion)' == ''">0.0.0</CapsuleVersion>
    <CapsuleSourcePath Condition="'$(CapsuleSourcePath)' == '' and Exists('$(MSBuildThisFileDirectory)../../build/Capsule.Build.props')">../..</CapsuleSourcePath>
    <RestoreSources Condition="'$(CapsuleSourcePath)' != ''">https://api.nuget.org/v3/index.json</RestoreSources>
    <CapsuleEngineRepository Condition="'$(SolutionName)' == 'Capsule'">true</CapsuleEngineRepository>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <Import Project="$(CapsuleSourcePath)/build/Capsule.Build.props" Condition="'$(CapsuleSourcePath)' != ''" />
</Project>
