<Project>
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Matches the engine's VersionPrefix rather than a release: package mode here always means
         the packages this tree just packed into artifacts/packages, never nuget.org. A copy of the
         sample outside this repository must set a real pin; see docs/consuming-capsule.md. -->
    <CapsuleVersion>0.0.0</CapsuleVersion>
    <!-- Inside the engine repository the sample is the consumer proof, so it builds from engine
         source by default. CapsuleUsePackages forces the package lane. -->
    <CapsuleSourcePath Condition="'$(CapsuleSourcePath)' == '' and Exists('$(MSBuildThisFileDirectory)../../build/Capsule.Build.targets')">../..</CapsuleSourcePath>
    <CapsuleSourceRoot Condition="'$(CapsuleUsePackages)' != 'true' and '$(CapsuleSourcePath)' != ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '$(CapsuleSourcePath)'))</CapsuleSourceRoot>
    <!-- The engine's own dotnet pack walks its solution, which the sample is a member of. -->
    <IsPackable>false</IsPackable>
    <!-- Source mode resolves the engine through project references and must restore without the
         local feed in NuGet.config: NuGet rejects a missing local source (NU1301) even when nothing
         resolves from it, and the feed exists only after a pack. -->
    <RestoreSources Condition="'$(CapsuleSourceRoot)' != ''">https://api.nuget.org/v3/index.json</RestoreSources>
    <!-- This file shadows the repository's own, which declares the same for everything else here.
         Under the engine's solution the sample is part of the engine's build and takes its
         configuration; on its own root it is an ordinary consumer and gets the optimised engine. -->
    <CapsuleEngineRepository Condition="'$(SolutionName)' == 'Capsule'">true</CapsuleEngineRepository>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup Condition="'$(CapsuleSourceRoot)' == ''">
    <PackageReference Include="JAG.Capsule.Build"
                      Version="[$(CapsuleVersion)]"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
