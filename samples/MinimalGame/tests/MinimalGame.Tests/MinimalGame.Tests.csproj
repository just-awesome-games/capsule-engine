<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The shell is referenced for its CapsuleBoot. A headless run boots through the registries a
       windowed run does. The runtime is referenced for EngineBuilder.RunHeadless. -->
  <ItemGroup>
    <PackageReference Include="JAG.Capsule.Runtime" Version="[$(CapsuleVersion)]" />
    <ProjectReference Include="../../src/MinimalGame.Game/MinimalGame.Game.csproj" />
    <ProjectReference Include="../../src/MinimalGame.Shell/MinimalGame.Shell.csproj" />
  </ItemGroup>

  <!-- xunit.v3 brings the test platform's usage telemetry, and the build leaves it unregistered. -->
  <ItemGroup>
    <TestingPlatformBuilderHook Remove="98058041-B5B6-4A75-9834-58E6DF796A22" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Recorded playtests, each replayed headless by RecordingTests. -->
  <ItemGroup>
    <None Include="Recordings/*.recording" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
