<Project>

  <!-- CI's proofs over the shipped package, run here because this is the one consumer CI builds in
       package mode. A copy of this sample drops the import. -->

  <Target Name="CapsuleRejectBackendCompileAsset" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_CapsuleBackendCompileReference Include="@(ReferencePath)"
                                       Condition="'%(Filename)' == 'MonoGame.Framework'" />
    </ItemGroup>
    <Error Condition="'@(_CapsuleBackendCompileReference)' != ''"
           Text="Capsule package leaked MonoGame as a compile reference." />
  </Target>

  <!-- The backend looks the window icon up by its exact manifest resource name. A name derived from
       the root namespace would silently fall back to the backend's icon. A shell built without
       Capsule's application manifest silently takes the compiler's, which leaves Windows stretching
       the window. The built assembly is checked, in every consumption mode. -->
  <UsingTask TaskName="CapsuleAssertExecutableResources"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <AssemblyPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Reflection" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // From bytes. The build never holds the shell open. Manifest names load no reference.
        byte[] assembly = File.ReadAllBytes(AssemblyPath);
        string[] names = Assembly.Load(assembly).GetManifestResourceNames();
        if (Array.IndexOf(names, "Icon.bmp") < 0)
        {
            Log.LogError(
                "'" + AssemblyPath + "' embeds no manifest resource named exactly 'Icon.bmp'; it has: "
                + string.Join(", ", names) + ".");
            return false;
        }

        // The Win32 manifest is stored as its UTF-8 text.
        if (System.Text.Encoding.ASCII.GetString(assembly).IndexOf("PerMonitorV2", StringComparison.Ordinal) < 0)
        {
            Log.LogError("'" + AssemblyPath + "' carries no application manifest declaring PerMonitorV2 display awareness.");
            return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- The stamp is touched only after a pass. A shell that failed is asserted again on the next build. -->
  <Target Name="CapsuleAssertExecutableResourcesEmbedded"
          AfterTargets="Build"
          Inputs="$(TargetPath)"
          Outputs="$(IntermediateOutputPath)executable-resources.stamp">
    <CapsuleAssertExecutableResources AssemblyPath="$(TargetPath)" />
    <Touch Files="$(IntermediateOutputPath)executable-resources.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)executable-resources.stamp" />
    </ItemGroup>
  </Target>

  <!-- The host mixes its own sound and plays it through SDL. A publish carrying MonoGame's sound
       library, or the source its license asked to travel with it, has lost the engine's exclusion. -->
  <Target Name="CapsuleRejectUnusedSoundLibrary" AfterTargets="Publish">
    <PropertyGroup>
      <_CapsuleProofPublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_CapsuleProofPublishDirectory>
    </PropertyGroup>
    <ItemGroup>
      <_CapsuleUnusedSoundLibrary Include="$(_CapsuleProofPublishDirectory)**/*openal*" />
      <_CapsuleUnusedSoundLibrary Include="$(_CapsuleProofPublishDirectory)licenses/openal-soft-source/**" />
    </ItemGroup>
    <Error Condition="'@(_CapsuleUnusedSoundLibrary)' != ''"
           Text="The publish carries an OpenAL file Capsule never loads: @(_CapsuleUnusedSoundLibrary->'%(RecursiveDir)%(Filename)%(Extension)', ', ')." />
  </Target>

</Project>
