<Project>

  <PropertyGroup>
    <!-- Keep repository source consumers on the solution configuration. -->
    <CapsuleEngineRepository>true</CapsuleEngineRepository>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- Preserve parent configuration across external ProjectReference edges. -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
    <!-- Release packing overrides this constant; it must equal the sample's CapsuleVersion. -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <Authors>JAG Studios</Authors>
    <PackageTags>game-engine;2d;monogame;deterministic</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/just-awesome-games/capsule-engine</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/just-awesome-games/capsule-engine</RepositoryUrl>
    <!-- PACKAGE.md uses links that resolve on nuget.org. -->
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>capsule-package-icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- XML documentation is the consumer API reference. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)PACKAGE.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)docs/assets/capsule-package-icon.png"
          Pack="true"
          PackagePath="/"
          Visible="false" />
  </ItemGroup>

</Project>
