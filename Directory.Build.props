<Project>

  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <VersionPrefix>0.4.0</VersionPrefix>
    <Authors>JAG Studios</Authors>
    <PackageTags>game-engine;2d;monogame;deterministic</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/just-awesome-games/capsule-engine</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/just-awesome-games/capsule-engine</RepositoryUrl>
    <!-- PACKAGE.md, not README.md: nuget.org resolves neither a relative image nor a relative
         document link, so the packed readme carries absolute ones. -->
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>capsule-package-icon.png</PackageIcon>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- The XML docs are the API reference a consumer reads in their editor; CS1591 holds every
         public member of a reference assembly to carrying one. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)PACKAGE.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)docs/assets/capsule-package-icon.png"
          Pack="true"
          PackagePath="/"
          Visible="false" />
  </ItemGroup>

</Project>
