<Project Sdk="Microsoft.NET.Sdk">

  <!-- The world container: a scene, the entities on it and their components. Substrate-free —
       Core and Maps only — so it passes the purity admission test and a game's logic and its
       headless tests reference it directly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Scenes</RootNamespace>
    <PackageId>JAG.Capsule.Scenes</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capsule.Core\Capsule.Core.csproj" />
    <ProjectReference Include="..\Capsule.Maps\Capsule.Maps.csproj" />
  </ItemGroup>

</Project>
