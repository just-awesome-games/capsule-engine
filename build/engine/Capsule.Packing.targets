<Project>

  <!-- How the engine's projects pack: every package carries a README pinned to its release, and
       depends on the other packages of that release at their exact version. -->

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CapsulePinPackageReadme</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <!-- The repository PACKAGE.md links to main. The copy every package carries links to the tag it
       was packed at, so a consumer reading a version's README reads that version's docs. A pack at
       the placeholder version has no tag to point at and keeps main. -->
  <Target Name="CapsulePinPackageReadme">
    <PropertyGroup>
      <_CapsuleReadme>$(IntermediateOutputPath)PACKAGE.md</_CapsuleReadme>
      <_CapsuleBlobRoot>$(RepositoryUrl)/blob/</_CapsuleBlobRoot>
      <_CapsuleRawRoot>https://raw.githubusercontent.com/just-awesome-games/capsule-engine/</_CapsuleRawRoot>
      <_CapsuleReadmeText>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../PACKAGE.md'))</_CapsuleReadmeText>
      <_CapsuleReadmeText Condition="'$(Version)' != '$(VersionPrefix)'">$(_CapsuleReadmeText.Replace('$(_CapsuleBlobRoot)main/', '$(_CapsuleBlobRoot)v$(Version)/').Replace('$(_CapsuleRawRoot)main/', '$(_CapsuleRawRoot)v$(Version)/'))</_CapsuleReadmeText>
    </PropertyGroup>
    <WriteLinesToFile File="$(_CapsuleReadme)"
                      Lines="$([MSBuild]::Escape($(_CapsuleReadmeText)))"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(_CapsuleReadme)" />
      <TfmSpecificPackageFile Include="$(_CapsuleReadme)" PackagePath="/" />
    </ItemGroup>
  </Target>

  <!-- NuGet emits a project reference as a minimum-version dependency, but the packages of one
       release are a matched set. The Error is the tripwire for NuGet's item going away, so this
       does not silently revert to the open range. -->
  <Target Name="CapsulePinProjectReferenceDependencies"
          AfterTargets="_GetProjectReferenceVersions"
          Condition="'$(IsPackable)' != 'false' and '@(ProjectReference)' != ''">
    <Error Condition="'@(_ProjectReferencesWithVersions)' == ''"
           Text="$(PackageId) could not pin its project-reference dependencies: NuGet no longer exposes _ProjectReferencesWithVersions." />
    <ItemGroup>
      <_ProjectReferencesWithVersions ProjectVersion="[$(PackageVersion)]" />
    </ItemGroup>
  </Target>

</Project>
