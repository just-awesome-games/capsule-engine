<Project>

  <!-- The XML documentation each engine project writes is its API reference. It lists the public
       surface only, and a source consumer finds it beside the reference assembly. -->

  <UsingTask TaskName="CapsuleTrimGeneratedDocumentation"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <DocumentationPath ParameterType="System.String" Required="true" />
      <GeneratedInternalTypes ParameterType="System.String[]" />
      <DocumentedTypes ParameterType="System.String[]" />
    </ParameterGroup>
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)CapsuleTrimGeneratedDocumentation.cs" />
    </Task>
  </UsingTask>

  <!-- The compiler writes every documentation comment it sees, whatever the member's accessibility,
       so generator output for an internal type is dropped before the reference leaves obj/. A
       project lists those types as CapsuleGeneratedInternalType items. A project whose internal
       types carry documentation comments lists its public types as CapsuleDocumentedType items,
       and every other entry is dropped. The trim rewrites its own input. A marker touched after it
       records the last trimmed file, and the target runs again only when the compiler writes a new one. -->
  <Target Name="CapsuleTrimDocumentationToPublicSurface"
          AfterTargets="CoreCompile"
          Condition="'$(GenerateDocumentationFile)' == 'true' and ('@(CapsuleGeneratedInternalType)' != '' or '@(CapsuleDocumentedType)' != '') and Exists('$(DocumentationFile)')"
          Inputs="$(DocumentationFile);$(MSBuildAllProjects);$(MSBuildThisFileDirectory)CapsuleTrimGeneratedDocumentation.cs"
          Outputs="$(IntermediateOutputPath)$(TargetName).doctrim.stamp">
    <CapsuleTrimGeneratedDocumentation DocumentationPath="$(DocumentationFile)"
                                       GeneratedInternalTypes="@(CapsuleGeneratedInternalType)"
                                       DocumentedTypes="@(CapsuleDocumentedType)" />
    <Touch Files="$(IntermediateOutputPath)$(TargetName).doctrim.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)$(TargetName).doctrim.stamp" />
    </ItemGroup>
  </Target>

  <!-- Keep source-consumer IntelliSense documentation beside the reference assembly. -->
  <Target Name="CapsulePlaceDocumentationBesideReferenceAssembly"
          AfterTargets="CoreCompile"
          DependsOnTargets="CapsuleTrimDocumentationToPublicSurface"
          Condition="'$(GenerateDocumentationFile)' == 'true' and '$(TargetRefPath)' != '' and Exists('$(DocumentationFile)') and Exists('$(TargetRefPath)')">
    <PropertyGroup>
      <_CapsuleReferenceDocumentation>$([System.IO.Path]::ChangeExtension('$(TargetRefPath)', '.xml'))</_CapsuleReferenceDocumentation>
    </PropertyGroup>
    <Copy SourceFiles="$(DocumentationFile)"
          DestinationFiles="$(_CapsuleReferenceDocumentation)"
          SkipUnchangedFiles="true" />
    <ItemGroup>
      <FileWrites Include="$(_CapsuleReferenceDocumentation)" />
    </ItemGroup>
  </Target>

</Project>
