<Project>

  <!-- The JAG.Capsule package graph, one row per module: Admits lists the projects it may reference,
       and NoPackages marks a module whose dependency set is the framework alone. A package that
       excludes its compile and runtime assets puts no type in reach and is admitted. A module absent
       from the table is unconstrained. -->
  <ItemGroup>
    <CapsuleModule Include="Capsule.Core" Admits="" NoPackages="true" />
    <CapsuleModule Include="Capsule.Physics" Admits="Capsule.Core" NoPackages="true" />
    <CapsuleModule Include="Capsule.Scenes" Admits="Capsule.Core;Capsule.Physics" NoPackages="true" />
    <CapsuleModule Include="Capsule" Admits="Capsule.Core;Capsule.Physics;Capsule.Scenes" NoPackages="true" />
  </ItemGroup>

  <Target Name="CapsuleValidateModuleDependencies" BeforeTargets="ResolveReferences">
    <ItemGroup>
      <_CapsuleThisModule Include="@(CapsuleModule)" Condition="'%(Identity)' == '$(MSBuildProjectName)'" />
    </ItemGroup>

    <PropertyGroup>
      <_CapsuleAdmits>;@(_CapsuleThisModule->'%(Admits)');</_CapsuleAdmits>
    </PropertyGroup>

    <ItemGroup Condition="'@(_CapsuleThisModule)' != ''">
      <_CapsuleForbiddenProject Include="@(ProjectReference->'%(Filename)')"
          Condition="!$(_CapsuleAdmits.Contains(';%(Filename);'))" />
      <!-- Ignore SDK-injected references such as the NativeAOT compiler pack. -->
      <_CapsuleForbiddenPackage Include="@(PackageReference)"
          Condition="'@(_CapsuleThisModule->'%(NoPackages)')' == 'true' and '%(PackageReference.IsImplicitlyDefined)' != 'true' and !($([System.String]::Copy('%(PackageReference.ExcludeAssets)').Contains('compile')) and $([System.String]::Copy('%(PackageReference.ExcludeAssets)').Contains('runtime')))" />
    </ItemGroup>

    <Error Condition="'@(_CapsuleForbiddenProject)' != '' and '@(_CapsuleThisModule->'%(Admits)')' == ''"
           Text="$(MSBuildProjectName) must reference no project; drop the reference to @(_CapsuleForbiddenProject)." />
    <Error Condition="'@(_CapsuleForbiddenProject)' != '' and '@(_CapsuleThisModule->'%(Admits)')' != ''"
           Text="$(MSBuildProjectName) must not reference @(_CapsuleForbiddenProject); the package graph admits @(_CapsuleThisModule->'%(Admits)') only." />
    <Error Condition="'@(_CapsuleForbiddenPackage)' != ''"
           Text="$(MSBuildProjectName) must not reference the package @(_CapsuleForbiddenPackage); drop it or move the code to a module that may take a dependency." />
  </Target>

</Project>
