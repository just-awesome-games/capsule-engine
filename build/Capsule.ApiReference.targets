<Project>

  <!-- Stage source-consumer API documentation before compilation. -->

  <PropertyGroup Condition="'$(CapsuleSourceRoot)' != ''">
    <!-- Resolve overrides against the consumer repository root. -->
    <CapsuleApiReferenceDirectory Condition="'$(CapsuleApiReferenceDirectory)' == ''">artifacts/capsule-api</CapsuleApiReferenceDirectory>
    <CapsuleApiReferenceDirectory>$([MSBuild]::NormalizePath('$([System.IO.Path]::GetDirectoryName("$(DirectoryBuildTargetsPath)"))', '$(CapsuleApiReferenceDirectory)'))</CapsuleApiReferenceDirectory>
  </PropertyGroup>

  <Target Name="CapsuleStageApiReference"
          Condition="'$(CapsuleSourceRoot)' != ''"
          DependsOnTargets="ResolveReferences"
          BeforeTargets="CoreCompile">

    <!-- Stage only resolved Capsule references. -->
    <ItemGroup>
      <_CapsuleApiReferenceFile Include="@(ReferenceCopyLocalPaths->WithMetadataValue('Extension', '.xml'))"
                               Condition="$([System.String]::Copy('%(Filename)').StartsWith('Capsule.'))" />
    </ItemGroup>

    <!-- Parallel role projects share this destination. -->
    <Copy SourceFiles="@(_CapsuleApiReferenceFile)"
          DestinationFolder="$(CapsuleApiReferenceDirectory)"
          SkipUnchangedFiles="true"
          Retries="3"
          RetryDelayMilliseconds="100" />
  </Target>

</Project>
