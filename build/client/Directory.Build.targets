<Project>

  <!-- Capsule's build hooks live in the engine clone. Importing the one aggregating entry point
       means a hook the engine adds never changes a line here. -->

  <PropertyGroup>
    <!-- Forward slashes: this property feeds raw Exists() conditions, where MSBuild does not
         repair separators on Linux; Windows accepts / natively. -->
    <CapsuleBuildTargets>$(MSBuildThisFileDirectory)../capsule-engine/build/Capsule.Build.targets</CapsuleBuildTargets>
  </PropertyGroup>

  <Import Project="$(CapsuleBuildTargets)" Condition="Exists('$(CapsuleBuildTargets)')" />

  <!-- A missing import is silent, and the failures downstream of it name neither the engine nor
       the layout that was expected. -->
  <Target Name="CapsuleRequireBuildTargets" BeforeTargets="Restore;Build">
    <Error Condition="!Exists('$(CapsuleBuildTargets)')"
           Text="Capsule: the engine build targets were not found at '$(CapsuleBuildTargets)'. A Capsule game consumes capsule-engine as a sibling clone, so capsule-engine/ must sit beside this repository — clone https://github.com/just-awesome-games/capsule-engine there (CI does the same, at the ref in capsule-engine.pin) and build again." />
  </Target>

</Project>
