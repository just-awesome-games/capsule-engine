<Project>

  <!-- The derivation contract is docs/build-and-publish.md#build-derivations. -->

  <!-- A tool built from a clone joins the game's graph and adds nothing to its output.
       Capsule.SourceConsumer.targets gives it the build tool's configuration. A package's targets are
       imported ahead of this file, so its derivations are already declared here. The declaration's
       metadata is cleared, since a ProjectReference reads Properties as global properties. -->
  <ItemGroup Condition="'$(CapsuleBuildAssets)' == 'true'">
    <ProjectReference Include="@(CapsuleDerivation->Metadata('ToolProject')->Exists()->ClearMetadata())"
                      CapsuleTool="true"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      ExcludeAssets="all"
                      PrivateAssets="all"
                      Private="false" />
  </ItemGroup>

  <!-- An out directory no current declaration names is deleted, with its stamp and sources files.
       Removing a declaration, the last one included, then leaves nothing behind. A game that never
       declared one pays a single check for a directory that does not exist. -->
  <Target Name="CapsuleDeleteUndeclaredDerivations"
          Condition="'$(CapsuleBuildAssets)' == 'true'"
          DependsOnTargets="CapsuleAssetSourcesInit">

    <PropertyGroup>
      <_CapsuleDerivedDir>$(CapsuleObjDir)/derived</_CapsuleDerivedDir>
      <_CapsuleDeclaredDerivations>|@(CapsuleDerivation, '|')|</_CapsuleDeclaredDerivations>
    </PropertyGroup>

    <!-- Names compare ordinally, like the derived paths below. -->
    <ItemGroup Condition="Exists('$(_CapsuleDerivedDir)')">
      <_CapsuleDerivedDirectory Include="$([System.IO.Directory]::GetDirectories('$(_CapsuleDerivedDir)'))" />
      <_CapsuleUndeclaredDerivedDirectory Include="@(_CapsuleDerivedDirectory)"
                                          Condition="!$(_CapsuleDeclaredDerivations.Contains('|%(Filename)%(Extension)|'))" />
    </ItemGroup>

    <RemoveDir Directories="@(_CapsuleUndeclaredDerivedDirectory)" />
    <Delete Files="@(_CapsuleUndeclaredDerivedDirectory->'%(Identity).inputs.txt');@(_CapsuleUndeclaredDerivedDirectory->'%(Identity).sources.txt')" />
  </Target>

  <!-- Every source once per output, each carrying its derivation's name, every dependency and
       property, and every stale output removed. -->
  <Target Name="CapsuleDerivationsInit"
          Condition="'$(CapsuleBuildAssets)' == 'true' and '@(CapsuleDerivation)' != ''"
          DependsOnTargets="CapsuleDeleteUndeclaredDerivations">

    <PropertyGroup>
      <_CapsuleAssetRoot>$([MSBuild]::EnsureTrailingSlash('$(CapsuleAssetSourcesDir)'))</_CapsuleAssetRoot>
      <_CapsuleProjectDirectory>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</_CapsuleProjectDirectory>
    </PropertyGroup>

    <!-- One item per output extension, carrying its derivation's globs. -->
    <ItemGroup>
      <_CapsuleDerivationOutput Include="%(CapsuleDerivation.OutputExtensions)"
                                Derivation="%(CapsuleDerivation.Identity)"
                                Sources="%(CapsuleDerivation.Sources)" />
    </ItemGroup>

    <ItemGroup>
      <!-- Each glob rooted as Capsule.Assets.targets roots its own, so a source matches its authored
           item. A property function's result is escaped, and Unescape lets the wildcards expand. -->
      <_CapsuleDerivationSource Include="$([MSBuild]::Unescape($(CapsuleAssetSourcesDir)/$([System.String]::Copy('%(_CapsuleDerivationOutput.Sources)').Replace(';', ';$(CapsuleAssetSourcesDir)/'))))"
                                Derivation="%(_CapsuleDerivationOutput.Derivation)"
                                OutputExtension="%(_CapsuleDerivationOutput.Identity)" />
      <_CapsuleDerivationInput Include="$([MSBuild]::Unescape($(CapsuleAssetSourcesDir)/$([System.String]::Copy('%(CapsuleDerivation.DependsOn)').Replace(';', ';$(CapsuleAssetSourcesDir)/'))))"
                               Derivation="%(CapsuleDerivation.Identity)"
                               Condition="'%(CapsuleDerivation.DependsOn)' != ''" />
      <_CapsuleDerivationProperty Include="%(CapsuleDerivation.Properties)"
                                  Derivation="%(CapsuleDerivation.Identity)"
                                  Condition="'%(CapsuleDerivation.Properties)' != ''" />
      <_CapsuleDerivedFile Include="$(_CapsuleDerivedDir)/%(CapsuleDerivation.Identity)/**" />
    </ItemGroup>

    <!-- Each source's path below the asset root with forward slashes, and the output it stands for. -->
    <ItemGroup>
      <_CapsuleDerivationSource>
        <Below>$([MSBuild]::MakeRelative('$(_CapsuleAssetRoot)', '%(FullPath)').Replace('\', '/'))</Below>
        <ProjectRelativePath>$([MSBuild]::MakeRelative('$(_CapsuleProjectDirectory)', '%(FullPath)'))</ProjectRelativePath>
      </_CapsuleDerivationSource>
    </ItemGroup>
    <ItemGroup>
      <_CapsuleDerivationSource>
        <Derived>$([System.IO.Path]::ChangeExtension(%(Below), %(OutputExtension)))</Derived>
        <DerivedPath>$([MSBuild]::NormalizePath('$(_CapsuleDerivedDir)', '%(Derivation)', '$([System.IO.Path]::ChangeExtension(%(Below), %(OutputExtension)))'))</DerivedPath>
      </_CapsuleDerivationSource>
    </ItemGroup>

    <!-- Two sources that derive one output would overwrite each other, as hero.aseprite and hero.psd
         both derive hero.png. Outputs compare with case folded, since asset keys fold it and Hero.png
         and hero.png claim one key on every OS. Each source finds the first other source claiming its
         output, and the pair fails the build once. Sources compare ordinally, so a source two globs
         match claims its output twice and collides with nothing. -->
    <ItemGroup>
      <_CapsuleDerivationSource>
        <Claim>$([System.String]::Copy('%(DerivedPath)').ToLowerInvariant())</Claim>
      </_CapsuleDerivationSource>
    </ItemGroup>
    <PropertyGroup>
      <_CapsuleDerivedClaims>|@(_CapsuleDerivationSource->'%(Claim)>%(ProjectRelativePath)', '|')|</_CapsuleDerivedClaims>
    </PropertyGroup>
    <ItemGroup>
      <_CapsuleDerivationSource>
        <CollidesWith>$([System.Text.RegularExpressions.Regex]::Match('$(_CapsuleDerivedClaims)', '(?&lt;=\|$([System.Text.RegularExpressions.Regex]::Escape('%(Claim)'))>)(?!$([System.Text.RegularExpressions.Regex]::Escape('%(ProjectRelativePath)'))\|)[^|]+').Value)</CollidesWith>
      </_CapsuleDerivationSource>
    </ItemGroup>
    <Error Condition="'%(_CapsuleDerivationSource.CollidesWith)' != '' and $([System.String]::CompareOrdinal('%(_CapsuleDerivationSource.ProjectRelativePath)', '%(_CapsuleDerivationSource.CollidesWith)')) &lt; 0"
           Text="Capsule: the derivation '%(_CapsuleDerivationSource.Derivation)' derives '%(_CapsuleDerivationSource.Derived)' from both '%(_CapsuleDerivationSource.ProjectRelativePath)' and '%(_CapsuleDerivationSource.CollidesWith)', and one would overwrite the other. Rename one of the two sources." />

    <!-- A file in an out directory that no current source derives is stale: its source is gone or
         renamed, or the declaration changed. Paths compare ordinally, since an item Remove folds case
         and would keep Room.scene.json for a source renamed to room.tmj. -->
    <PropertyGroup>
      <_CapsuleExpectedDerived>|@(_CapsuleDerivationSource->'%(DerivedPath)', '|')|</_CapsuleExpectedDerived>
    </PropertyGroup>
    <ItemGroup>
      <_CapsuleStaleDerived Include="@(_CapsuleDerivedFile)"
                            Condition="!$(_CapsuleExpectedDerived.Contains('|%(FullPath)|'))" />
    </ItemGroup>
    <Delete Files="@(_CapsuleStaleDerived)" />

    <!-- MSBuild incrementality is file-based. The stamp holds what a derivation declares and the
         dependencies it found, so a change to either or a deleted dependency re-derives it. -->
    <ItemGroup>
      <_CapsuleDerivationStampLine Include="@(CapsuleDerivation->'%(Identity)|%(Sources)|%(DependsOn)|%(OutputExtensions)|%(ToolProject)|%(ToolAssembly)')"
                                   Derivation="%(CapsuleDerivation.Identity)" />
      <_CapsuleDerivationStampLine Include="@(_CapsuleDerivationProperty);@(_CapsuleDerivationInput->'%(FullPath)')" />
      <_CapsuleDerivationStamp Include="@(CapsuleDerivation->'$(_CapsuleDerivedDir)/%(Identity).inputs.txt')" />
    </ItemGroup>
    <MakeDir Directories="$(_CapsuleDerivedDir)" />
    <WriteLinesToFile File="$(_CapsuleDerivedDir)/%(_CapsuleDerivationStampLine.Derivation).inputs.txt"
                      Lines="@(_CapsuleDerivationStampLine)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <!-- Each tool, as its derivation's _CapsuleDerivationTool, found the way CapsuleResolveBuildTool
       finds Capsule's own. -->
  <Target Name="CapsuleResolveDerivationTools"
          Condition="'$(CapsuleBuildAssets)' == 'true' and '@(CapsuleDerivation)' != ''">
    <ItemGroup>
      <_CapsuleDerivationToolProject Include="%(CapsuleDerivation.ToolProject)"
                                     Derivation="%(CapsuleDerivation.Identity)"
                                     Condition="'%(CapsuleDerivation.ToolProject)' != '' and Exists('%(CapsuleDerivation.ToolProject)')" />
    </ItemGroup>

    <MSBuild Projects="@(_CapsuleDerivationToolProject)"
             Condition="'@(_CapsuleDerivationToolProject)' != ''"
             Targets="GetTargetPath"
             Properties="Configuration=$([MSBuild]::ValueOrDefault('$(CapsuleSourceConfiguration)', '$(Configuration)'))">
      <Output TaskParameter="TargetOutputs" ItemName="_CapsuleDerivationTool" />
    </MSBuild>

    <!-- A derivation whose tool project is absent runs its assembly. -->
    <ItemGroup>
      <_CapsuleAssemblyTool Include="@(CapsuleDerivation)"
                            Exclude="@(_CapsuleDerivationToolProject->'%(Derivation)')"
                            Condition="'%(CapsuleDerivation.ToolAssembly)' != '' and Exists('%(CapsuleDerivation.ToolAssembly)')" />
      <_CapsuleDerivationTool Include="@(_CapsuleAssemblyTool->'%(ToolAssembly)')"
                              Derivation="%(_CapsuleAssemblyTool.Identity)" />
      <_CapsuleToollessDerivation Include="@(CapsuleDerivation)" Exclude="@(_CapsuleDerivationTool->'%(Derivation)')" />
      <!-- Every assembly beside a tool is an input, so a change to one re-derives. -->
      <_CapsuleDerivationToolAssembly Include="%(_CapsuleDerivationTool.RootDir)%(_CapsuleDerivationTool.Directory)*.dll" />
    </ItemGroup>

    <Error Condition="'@(_CapsuleToollessDerivation)' != ''"
           Text="Capsule: the derivation '%(_CapsuleToollessDerivation.Identity)' names no tool that exists: neither ToolProject '%(_CapsuleToollessDerivation.ToolProject)' nor ToolAssembly '%(_CapsuleToollessDerivation.ToolAssembly)'. Restore the package that declares it, or point its source override at a clone that holds the tool project." />
  </Target>

  <!-- Partially incremental. MSBuild pairs each source item with its one output and hands the target
       only the pairs whose source is newer, and the tool runs once per derivation that has any,
       naming each source once. A missing output, a touched dependency, stamp or tool assembly
       re-derives every source. -->
  <Target Name="CapsuleRunDerivations"
          Condition="'$(CapsuleBuildAssets)' == 'true' and '@(CapsuleDerivation)' != ''"
          DependsOnTargets="CapsuleDerivationsInit;CapsuleResolveDerivationTools;ResolveProjectReferences"
          Inputs="@(_CapsuleDerivationSource);@(_CapsuleDerivationInput);@(_CapsuleDerivationStamp);@(_CapsuleDerivationToolAssembly)"
          Outputs="@(_CapsuleDerivationSource->'%(DerivedPath)')">

    <Error Condition="!Exists('%(_CapsuleDerivationTool.Identity)')"
           Text="Capsule: the tool of the derivation '%(_CapsuleDerivationTool.Derivation)' was not built (expected '%(_CapsuleDerivationTool.Identity)')." />

    <!-- The sources go through a file because cmd limits a command line to 8191 characters. -->
    <WriteLinesToFile File="$(_CapsuleDerivedDir)/%(_CapsuleDerivationSource.Derivation).sources.txt"
                      Lines="@(_CapsuleDerivationSource->'%(ProjectRelativePath)'->Distinct())"
                      Overwrite="true" />

    <!-- Batched by derivation over the tool, its properties and its stale sources. The out directory
         has no trailing separator, which on Windows would escape the closing quote. -->
    <Exec Condition="'@(_CapsuleDerivationSource)' != '' and '@(_CapsuleDerivationTool)' != ''"
          Command="&quot;$(CapsuleDotNetHost)&quot; &quot;@(_CapsuleDerivationTool)&quot; &quot;$(CapsuleAssetSourcesDir)&quot; &quot;$(_CapsuleDerivedDir)/%(Derivation)&quot; &quot;$(_CapsuleDerivedDir)/%(Derivation).sources.txt&quot;@(_CapsuleDerivationProperty->' &quot;%(Identity)&quot;', '')"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          LogStandardErrorAsError="true"
          StandardOutputImportance="normal" />
  </Target>

  <!-- What every derivation left, each file with the root it keys below. Runs on up-to-date builds
       too, from what is on disk. -->
  <Target Name="CapsuleCollectDerivedAssets"
          Condition="'$(CapsuleBuildAssets)' == 'true' and '@(CapsuleDerivation)' != ''"
          DependsOnTargets="CapsuleRunDerivations">
    <ItemGroup>
      <_CapsuleDerived Include="$(_CapsuleDerivedDir)/%(CapsuleDerivation.Identity)/**"
                       Root="$(_CapsuleDerivedDir)/%(CapsuleDerivation.Identity)" />
    </ItemGroup>
  </Target>

</Project>
