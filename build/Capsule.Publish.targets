<Project>

  <!-- What a shell's publish holds. Its symbols go beside it to CapsuleSymbolsDirectory, where a crash
       log decodes against them. A role-free project publishes as the SDK does. -->

  <!-- Defaults a project can override, for a native publish only. Its crash log's addresses decode
       against the native symbols, and a managed publish keeps its method names. Code compiled for
       speed runs the engine's steps and frame builds faster than code compiled for size or the SDK's
       default, for about a megabyte. A development publish compiles
       the same code a shipping one does, which it measures, and keeps its method names.
       CapsuleShipping is set in Capsule.Build.targets, ahead of this file. -->
  <PropertyGroup Condition="'$(CapsuleGameShell)' == 'true' and '$(CapsuleShipping)' == 'true' and '$(PublishAot)' == 'true'">
    <StackTraceSupport Condition="'$(StackTraceSupport)' == ''">false</StackTraceSupport>
    <UseSystemResourceKeys Condition="'$(UseSystemResourceKeys)' == ''">true</UseSystemResourceKeys>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CapsuleGameShell)' == 'true' and '$(PublishAot)' == 'true'">
    <OptimizationPreference Condition="'$(OptimizationPreference)' == ''">Speed</OptimizationPreference>
  </PropertyGroup>

  <!-- The executable names its pdb by file name alone, never the build machine's path. The pdb's
       signature, which a crash decodes against, is unchanged. A reproducible link stamps no time. The
       same sources then rebuild to the executable a crash log's hash names. -->
  <ItemGroup Condition="'$(CapsuleGameShell)' == 'true' and '$(PublishAot)' == 'true' and '$(OS)' == 'Windows_NT'">
    <LinkerArg Include="/PDBALTPATH:%25_PDB%25" />
    <LinkerArg Include="/Brepro" />
  </ItemGroup>

  <!-- Symbols are generated as usual and never copied into the publish directory, and neither is
       documentation, the shell's own or its references'. Imported after the SDK defaults, and
       command-line overrides still win. -->
  <PropertyGroup Condition="'$(CapsuleGameShell)' == 'true'">
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!-- The desktop platform the runtime identifier publishes for, or empty for none. -->
  <PropertyGroup Condition="'$(CapsuleGameShell)' == 'true'">
    <_CapsulePlatform Condition="$(RuntimeIdentifier.StartsWith('win-'))">windows</_CapsulePlatform>
    <_CapsulePlatform Condition="$(RuntimeIdentifier.StartsWith('linux-'))">linux</_CapsulePlatform>
    <_CapsulePlatform Condition="$(RuntimeIdentifier.StartsWith('osx-'))">macos</_CapsulePlatform>
  </PropertyGroup>

  <!-- The GPU formats a publish carries, by platform: those SDL's GPU drivers read there. A publish for
       no known platform carries every format, and a private platform module names its own. -->
  <PropertyGroup Condition="'$(CapsuleGameShell)' == 'true'">
    <_CapsuleEngineShaderFormats>spirv;dxil;msl</_CapsuleEngineShaderFormats>
    <CapsuleShaderFormats Condition="'$(CapsuleShaderFormats)' == '' and '$(_CapsulePlatform)' == 'windows'">dxil;spirv</CapsuleShaderFormats>
    <CapsuleShaderFormats Condition="'$(CapsuleShaderFormats)' == '' and '$(_CapsulePlatform)' == 'linux'">spirv</CapsuleShaderFormats>
    <CapsuleShaderFormats Condition="'$(CapsuleShaderFormats)' == '' and '$(_CapsulePlatform)' == 'macos'">msl</CapsuleShaderFormats>
  </PropertyGroup>

  <!-- A shader ships as <key>.<format>.shader. One in a format the publish does not carry leaves it. -->
  <Target Name="CapsuleDropUnreadShaderFormats"
          Condition="'$(CapsuleGameShell)' == 'true' and '$(CapsuleShaderFormats)' != ''"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_CapsuleShaderExtensions>;.$(CapsuleShaderFormats.Replace(';', ';.'));</_CapsuleShaderExtensions>
    </PropertyGroup>
    <ItemGroup>
      <_CapsuleUnreadShader Include="@(ResolvedFileToPublish)"
                            Condition="'%(Extension)' == '.shader' and !$(_CapsuleShaderExtensions.Contains(';$([System.IO.Path]::GetExtension(%(Filename)));'))" />
      <ResolvedFileToPublish Remove="@(_CapsuleUnreadShader)" />
    </ItemGroup>
  </Target>

  <!-- The engine embeds its own sprite shader in every format and the controller database once per
       desktop platform. A native publish removes the formats it does not carry and every platform's
       database but its own. The compiler ignores a resource the assembly does not hold. -->
  <Target Name="CapsuleRemoveUnreadEngineResources"
          Condition="'$(CapsuleGameShell)' == 'true' and '$(PublishAot)' == 'true'"
          BeforeTargets="WriteIlcRspFileForCompilation">
    <ItemGroup>
      <_CapsuleUnreadEngineShader Include="$(_CapsuleEngineShaderFormats)" Exclude="$(CapsuleShaderFormats)" Condition="'$(CapsuleShaderFormats)' != ''" />
      <_CapsuleUnreadEngineResource Include="@(_CapsuleUnreadEngineShader->'Capsule.Runtime.Rendering.Shaders.sprite.%(Identity).shader')" />
      <_CapsuleUnreadEngineResource Include="@(_CapsuleUnreadEngineShader->'Capsule.Runtime.Rendering.Shaders.vertex.%(Identity).shader')" />
      <_CapsuleUnreadGamepadMappings Include="windows;linux;macos" Exclude="$(_CapsulePlatform)" Condition="'$(_CapsulePlatform)' != ''" />
      <_CapsuleUnreadEngineResource Include="@(_CapsuleUnreadGamepadMappings->'Capsule.Runtime.Input.gamecontrollerdb.%(Identity).txt.gz')" />
      <_CapsuleUnreadEngineResourceLine Include="@(_CapsuleUnreadEngineResource->'    &lt;resource name=&quot;%(Identity)&quot; action=&quot;remove&quot; /&gt;')" />
    </ItemGroup>
    <WriteLinesToFile Condition="'@(_CapsuleUnreadEngineResource)' != ''"
                      File="$(IntermediateOutputPath)capsule-engine-resources.xml"
                      Lines="&lt;linker&gt;;  &lt;assembly fullname=&quot;Capsule.Runtime&quot;&gt;;@(_CapsuleUnreadEngineResourceLine);  &lt;/assembly&gt;;&lt;/linker&gt;"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup Condition="'@(_CapsuleUnreadEngineResource)' != ''">
      <IlcArg Include="--substitution:$(IntermediateOutputPath)capsule-engine-resources.xml" />
      <FileWrites Include="$(IntermediateOutputPath)capsule-engine-resources.xml" />
    </ItemGroup>
    <PropertyGroup>
      <_CapsuleEngineResourcesRemoved>true</_CapsuleEngineResourcesRemoved>
    </PropertyGroup>
  </Target>

  <!-- A native publish whose compiler skipped the removal fails rather than ship what it never reads. -->
  <Target Name="CapsuleRequireUnreadEngineResourcesRemoved"
          Condition="'$(CapsuleGameShell)' == 'true' and '$(PublishAot)' == 'true' and '$(NativeCompilationDuringPublish)' != 'false'"
          AfterTargets="Publish">
    <Error Condition="'$(_CapsuleEngineResourcesRemoved)' != 'true'"
           Text="The NativeAOT publish kept the engine shader formats and controller databases it never reads: the compiler no longer runs WriteIlcRspFileForCompilation. Hook the target that now writes its response file." />
  </Target>

  <!-- The publish directory's assets/ is the asset build's alone and is replaced whole. The SDK deletes
       only what its record of the last publish names, and that record lives in obj/. A record lost
       with obj/ leaves an earlier publish's assets for an installer to ship. -->
  <Target Name="CapsuleReplacePublishedAssets"
          Condition="'$(CapsuleGameShell)' == 'true'"
          AfterTargets="PrepareForPublish">
    <RemoveDir Directories="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)', 'assets'))" />
  </Target>

  <!-- Reference symbols leave the publish list. They are the build's symbols in a managed publish,
       and describe no code in a native one, where the native pdb replaces them. -->
  <Target Name="CapsuleCollectPublishSymbols"
          Condition="'$(CapsuleGameShell)' == 'true'"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_CapsuleReferenceSymbol Include="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(_CapsuleReferenceSymbol)" />

      <_CapsulePublishSymbol Include="@(_CapsuleReferenceSymbol)" Condition="'$(PublishAot)' != 'true'" />
      <!-- NativeAOT empties this list. It holds the entry pdb of a managed publish only. -->
      <_CapsulePublishSymbol Include="@(_DebugSymbolsIntermediatePath)" Condition="'$(_DebugSymbolsProduced)' == 'true'">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
      </_CapsulePublishSymbol>
    </ItemGroup>
  </Target>

  <!-- The licenses a player's copy carries: Capsule's own, the notices of what Capsule carries and
       redistributes, and, when the runtime ships with the game, the .NET runtime's from its runtime
       pack. Capsule's files sit beside the imported hooks' parent in source and package modes. -->
  <Target Name="CapsulePublishLicenses"
          Condition="'$(CapsuleGameShell)' == 'true'"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_CapsuleLicense Include="$(MSBuildThisFileDirectory)../LICENSE" RelativePath="licenses/LICENSE-Capsule.txt" />
      <_CapsuleLicense Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" RelativePath="licenses/THIRD-PARTY-NOTICES-Capsule.md" />
      <_CapsuleRuntimePack Include="@(ResolvedRuntimePack)"
                           Condition="'%(FrameworkName)' == 'Microsoft.NETCore.App' and ('$(SelfContained)' == 'true' or '$(PublishAot)' == 'true')" />
      <_CapsuleLicense Include="@(_CapsuleRuntimePack->'%(PackageDirectory)/LICENSE.TXT')" RelativePath="licenses/LICENSE-dotnet.txt" />
      <_CapsuleLicense Include="@(_CapsuleRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" RelativePath="licenses/THIRD-PARTY-NOTICES-dotnet.txt" />
      <ResolvedFileToPublish Include="@(_CapsuleLicense)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="CapsuleCopyPublishSymbols"
          Condition="'$(CapsuleGameShell)' == 'true'"
          AfterTargets="Publish">
    <PropertyGroup>
      <_CapsulePublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_CapsulePublishDirectory>
      <CapsuleSymbolsDirectory Condition="'$(CapsuleSymbolsDirectory)' == ''">$([System.IO.Path]::TrimEndingDirectorySeparator('$(_CapsulePublishDirectory)'))-symbols</CapsuleSymbolsDirectory>
      <CapsuleSymbolsDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(CapsuleSymbolsDirectory)'))</CapsuleSymbolsDirectory>

      <!-- The native symbols' name, as the NativeAOT publish targets spell it: a pdb on Windows,
           a .dbg file or a .dSYM bundle elsewhere. -->
      <_CapsuleNativeSymbols Condition="'$(PublishAot)' == 'true' and '$(OS)' == 'Windows_NT'">$(TargetName)$(NativeSymbolExt)</_CapsuleNativeSymbols>
      <_CapsuleNativeSymbols Condition="'$(PublishAot)' == 'true' and '$(OS)' != 'Windows_NT'">$(TargetName)$(NativeBinaryExt)$(NativeSymbolExt)</_CapsuleNativeSymbols>
    </PropertyGroup>

    <ItemGroup Condition="'$(_CapsuleNativeSymbols)' != ''">
      <_CapsulePublishSymbol Include="$(NativeOutputPath)$(_CapsuleNativeSymbols)" Condition="'$(NativeSymbolExt)' != '.dSYM' and Exists('$(NativeOutputPath)$(_CapsuleNativeSymbols)')">
        <RelativePath>$(_CapsuleNativeSymbols)</RelativePath>
      </_CapsulePublishSymbol>
      <!-- A .dSYM bundle is a directory. Its files keep their paths inside it. -->
      <_CapsuleNativeSymbolBundle Include="$(NativeOutputPath)$(_CapsuleNativeSymbols)/**/*" Condition="'$(NativeSymbolExt)' == '.dSYM'" />
      <_CapsulePublishSymbol Include="@(_CapsuleNativeSymbolBundle)">
        <RelativePath>$(_CapsuleNativeSymbols)/%(_CapsuleNativeSymbolBundle.RecursiveDir)%(_CapsuleNativeSymbolBundle.Filename)%(_CapsuleNativeSymbolBundle.Extension)</RelativePath>
      </_CapsulePublishSymbol>
    </ItemGroup>

    <Copy SourceFiles="@(_CapsulePublishSymbol)"
          DestinationFiles="@(_CapsulePublishSymbol->'$(CapsuleSymbolsDirectory)%(RelativePath)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Condition="'@(_CapsulePublishSymbol)' != ''" Text="$(MSBuildProjectName) symbols -> $(CapsuleSymbolsDirectory)" />
  </Target>

</Project>
