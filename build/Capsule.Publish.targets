<Project>

  <!-- What a shell's publish holds. It carries no symbols and no method names. The build's symbols go
       to CapsuleSymbolsDirectory beside it, where a crash log's addresses decode against them. Every
       part answers to the shell role, and a role-free project publishes as the SDK does. -->

  <!-- Defaults a project can override, for a native publish only. Its crash log's addresses decode
       against the native symbols, and a managed publish keeps its method names. CapsuleShipping is
       set in Capsule.Build.targets, ahead of this file. -->
  <PropertyGroup Condition="'$(CapsuleGameShell)' == 'true' and '$(CapsuleShipping)' == 'true' and '$(PublishAot)' == 'true'">
    <StackTraceSupport Condition="'$(StackTraceSupport)' == ''">false</StackTraceSupport>
    <UseSystemResourceKeys Condition="'$(UseSystemResourceKeys)' == ''">true</UseSystemResourceKeys>
  </PropertyGroup>

  <!-- The executable names its pdb by file name alone, never the build machine's path. The pdb's
       signature, which a crash decodes against, is unchanged. -->
  <ItemGroup Condition="'$(CapsuleGameShell)' == 'true' and '$(PublishAot)' == 'true' and '$(OS)' == 'Windows_NT'">
    <LinkerArg Include="/PDBALTPATH:%25_PDB%25" />
  </ItemGroup>

  <!-- Symbols are generated as usual and never copied into the publish directory, and neither is
       reference documentation. Imported after the SDK defaults, and command-line overrides still win. -->
  <PropertyGroup Condition="'$(CapsuleGameShell)' == 'true'">
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
  </PropertyGroup>

  <!-- Only when MonoGame is compiled in. The compiler fails a substitution naming an assembly it was
       not given, and ignores a resource the assembly does not hold. -->
  <Target Name="CapsuleRemoveSubstrateResources"
          Condition="'$(CapsuleGameShell)' == 'true' and '$(PublishAot)' == 'true'"
          BeforeTargets="WriteIlcRspFileForCompilation">
    <ItemGroup Condition="'@(IlcReference->WithMetadataValue('Filename', 'MonoGame.Framework'))' != ''">
      <IlcArg Include="--substitution:$(MSBuildThisFileDirectory)Capsule.SubstrateResources.xml" />
    </ItemGroup>
  </Target>

  <!-- The publish directory's assets/ is the asset build's alone and is replaced whole. The SDK deletes
       only what its record of the last publish names, and that record lives in obj/. A record lost
       with obj/ leaves an earlier publish's assets for an installer to ship. -->
  <Target Name="CapsuleReplacePublishedAssets"
          Condition="'$(CapsuleGameShell)' == 'true'"
          AfterTargets="PrepareForPublish">
    <RemoveDir Directories="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)', 'assets'))" />
  </Target>

  <!-- Reference symbols leave the publish list. They are the build's symbols in a managed publish,
       and describe no code in a native one, where the native pdb replaces them. -->
  <Target Name="CapsuleCollectPublishSymbols"
          Condition="'$(CapsuleGameShell)' == 'true'"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_CapsuleReferenceSymbol Include="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
      <ResolvedFileToPublish Remove="@(_CapsuleReferenceSymbol)" />

      <_CapsulePublishSymbol Include="@(_CapsuleReferenceSymbol)" Condition="'$(PublishAot)' != 'true'" />
      <!-- NativeAOT empties this list. It holds the entry pdb of a managed publish only. -->
      <_CapsulePublishSymbol Include="@(_DebugSymbolsIntermediatePath)" Condition="'$(_DebugSymbolsProduced)' == 'true'">
        <RelativePath>%(Filename)%(Extension)</RelativePath>
      </_CapsulePublishSymbol>
    </ItemGroup>
  </Target>

  <!-- The host mixes its own sound and plays it through SDL. MonoGame's sound library reaches a shell
       through the backend's package graph and is never loaded, and neither its build output nor its
       publish carries it. -->
  <Target Name="CapsuleDropUnusedSoundLibrary"
          Condition="'$(CapsuleGameShell)' == 'true'"
          AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'MonoGame.Library.OpenAL'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'MonoGame.Library.OpenAL'" />
    </ItemGroup>
  </Target>

  <!-- MonoGame's SDL2 reaches every project referencing the host through the backend's package graph,
       under the file names of the sdl2-compat bridge JAG.Capsule.Native.SDL3 carries. Its copy would
       land on the bridge's path. No project's build output or publish takes it. -->
  <Target Name="CapsuleDropSubstrateSdl" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NativeCopyLocalItems.NuGetPackageId)' == 'MonoGame.Library.SDL'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(RuntimeTargetsCopyLocalItems.NuGetPackageId)' == 'MonoGame.Library.SDL'" />
    </ItemGroup>
  </Target>

  <!-- The licenses a player's copy carries: Capsule's own, the notices of what Capsule carries and
       redistributes, and, when the runtime ships with the game, the .NET runtime's from its runtime
       pack. Capsule's files sit beside the imported hooks' parent in source and package modes. -->
  <Target Name="CapsulePublishLicenses"
          Condition="'$(CapsuleGameShell)' == 'true'"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_CapsuleLicense Include="$(MSBuildThisFileDirectory)../LICENSE" RelativePath="licenses/LICENSE-Capsule.txt" />
      <_CapsuleLicense Include="$(MSBuildThisFileDirectory)../THIRD-PARTY-NOTICES.md" RelativePath="licenses/THIRD-PARTY-NOTICES-Capsule.md" />
      <_CapsuleRuntimePack Include="@(ResolvedRuntimePack)"
                           Condition="'%(FrameworkName)' == 'Microsoft.NETCore.App' and ('$(SelfContained)' == 'true' or '$(PublishAot)' == 'true')" />
      <_CapsuleLicense Include="@(_CapsuleRuntimePack->'%(PackageDirectory)/LICENSE.TXT')" RelativePath="licenses/LICENSE-dotnet.txt" />
      <_CapsuleLicense Include="@(_CapsuleRuntimePack->'%(PackageDirectory)/THIRD-PARTY-NOTICES.TXT')" RelativePath="licenses/THIRD-PARTY-NOTICES-dotnet.txt" />
      <ResolvedFileToPublish Include="@(_CapsuleLicense)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="CapsuleCopyPublishSymbols"
          Condition="'$(CapsuleGameShell)' == 'true'"
          AfterTargets="Publish">
    <PropertyGroup>
      <_CapsulePublishDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(PublishDir)'))</_CapsulePublishDirectory>
      <CapsuleSymbolsDirectory Condition="'$(CapsuleSymbolsDirectory)' == ''">$([System.IO.Path]::TrimEndingDirectorySeparator('$(_CapsulePublishDirectory)'))-symbols</CapsuleSymbolsDirectory>
      <CapsuleSymbolsDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(CapsuleSymbolsDirectory)'))</CapsuleSymbolsDirectory>

      <!-- The native symbols' name, as the NativeAOT publish targets spell it: a pdb on Windows,
           a .dbg file or a .dSYM bundle elsewhere. -->
      <_CapsuleNativeSymbols Condition="'$(PublishAot)' == 'true' and '$(OS)' == 'Windows_NT'">$(TargetName)$(NativeSymbolExt)</_CapsuleNativeSymbols>
      <_CapsuleNativeSymbols Condition="'$(PublishAot)' == 'true' and '$(OS)' != 'Windows_NT'">$(TargetName)$(NativeBinaryExt)$(NativeSymbolExt)</_CapsuleNativeSymbols>
    </PropertyGroup>

    <ItemGroup Condition="'$(_CapsuleNativeSymbols)' != ''">
      <_CapsulePublishSymbol Include="$(NativeOutputPath)$(_CapsuleNativeSymbols)" Condition="'$(NativeSymbolExt)' != '.dSYM' and Exists('$(NativeOutputPath)$(_CapsuleNativeSymbols)')">
        <RelativePath>$(_CapsuleNativeSymbols)</RelativePath>
      </_CapsulePublishSymbol>
      <!-- A .dSYM bundle is a directory. Its files keep their paths inside it. -->
      <_CapsuleNativeSymbolBundle Include="$(NativeOutputPath)$(_CapsuleNativeSymbols)/**/*" Condition="'$(NativeSymbolExt)' == '.dSYM'" />
      <_CapsulePublishSymbol Include="@(_CapsuleNativeSymbolBundle)">
        <RelativePath>$(_CapsuleNativeSymbols)/%(_CapsuleNativeSymbolBundle.RecursiveDir)%(_CapsuleNativeSymbolBundle.Filename)%(_CapsuleNativeSymbolBundle.Extension)</RelativePath>
      </_CapsulePublishSymbol>
    </ItemGroup>

    <Copy SourceFiles="@(_CapsulePublishSymbol)"
          DestinationFiles="@(_CapsulePublishSymbol->'$(CapsuleSymbolsDirectory)%(RelativePath)')"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Condition="'@(_CapsulePublishSymbol)' != ''" Text="$(MSBuildProjectName) symbols -> $(CapsuleSymbolsDirectory)" />
  </Target>

</Project>
