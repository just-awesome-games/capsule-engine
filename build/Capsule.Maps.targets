<Project>

  <!-- Derives a map from every map source in the game's asset sources and ships it as content
       at Assets/Maps. The derived files live in obj/ and are never committed.

       A game repo's Directory.Build.targets reaches every project in the repo, so this hook is
       inert until a project asks for maps:

         <CapsuleImportMaps>true</CapsuleImportMaps>

       A shell is one by definition and needs no line. Anything else that has to read the maps a
       game ships — a test project, a headless smoke binary — opts in with that property, and
       gets the import and the content without a Capsule.Runtime reference, a window or a role.

       Sources are found by convention under $(CapsuleAssetSourcesDir)/maps, and dispatch is by
       extension: a second authoring tool becomes another item group here, never new wiring in
       the game. Two are wired today — Tiled's *.tmj, and *.map.json authored by hand in Capsule's
       own format. A native source is a source like any other: it is validated and re-emitted
       canonically rather than copied, so the shipped plane is wholly derived either way.

       An importing project may declare the one tile size every map is authored at, and a map
       whose own differs then fails the build:

         <CapsuleTileSize>16</CapsuleTileSize>

       Left unset, no size is imposed and each map keeps its own. -->

  <PropertyGroup Condition="'$(CapsuleImportMaps)' == 'true'">
    <CapsuleMapsCliProject Condition="'$(CapsuleMapsCliProject)' == '' and Exists('$(MSBuildThisFileDirectory)../Capsule.Maps.Cli/Capsule.Maps.Cli.csproj')">$(MSBuildThisFileDirectory)../Capsule.Maps.Cli/Capsule.Maps.Cli.csproj</CapsuleMapsCliProject>
    <CapsuleMapsCliAssembly Condition="'$(CapsuleMapsCliAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)../tools/net10.0/any/Capsule.Maps.Cli.dll')">$(MSBuildThisFileDirectory)../tools/net10.0/any/Capsule.Maps.Cli.dll</CapsuleMapsCliAssembly>
    <CapsuleDotNetHost Condition="'$(CapsuleDotNetHost)' == ''">$(DOTNET_HOST_PATH)</CapsuleDotNetHost>
    <CapsuleDotNetHost Condition="'$(CapsuleDotNetHost)' == ''">dotnet</CapsuleDotNetHost>
  </PropertyGroup>

  <ItemGroup Condition="'$(CapsuleImportMaps)' == 'true'">
    <CapsuleTiledMap Include="$(CapsuleAssetSourcesDir)/maps/**/*.tmj" />
    <CapsuleNativeMap Include="$(CapsuleAssetSourcesDir)/maps/**/*.map.json" />

    <!-- Not an import target of its own: a Tiled map's tilesets are read during its import, so
         they are the other half of what a derived map is up to date with respect to. The tool
         confines references to this recursively tracked tree. -->
    <CapsuleTiledTileset Include="$(CapsuleAssetSourcesDir)/**/*.tsj" />

    <!-- The tool rides the game's own restore and build graph, so it restores under the game's
         locked mode and contributes nothing to the game's output or publish set. -->
    <ProjectReference Include="$(CapsuleMapsCliProject)"
                      Condition="'$(CapsuleMapsCliProject)' != ''"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"
                      ExcludeAssets="all"
                      PrivateAssets="all"
                      Private="false" />
  </ItemGroup>

  <!-- Hooked into the build in its own right, not only through the import: the checks below
       must run whether or not there is anything to import. -->
  <Target Name="CapsuleMapsInit"
          Condition="'$(CapsuleImportMaps)' == 'true'"
          DependsOnTargets="CapsuleAssetSourcesInit"
          BeforeTargets="AssignTargetPaths">
    <Error Condition="('@(CapsuleTiledMap)' != '' or '@(CapsuleNativeMap)' != '') and '$(CapsuleMapsCliProject)' == '' and '$(CapsuleMapsCliAssembly)' == ''"
           Text="Capsule: the map importer is unavailable. Reference the Capsule.Build package, or import build/Capsule.Build.targets from a Capsule source clone." />

    <!-- A native source's %(Filename) is '<stem>.map', so the extension comes off it a second
         time: the two source kinds only collide detectably if they name their maps the same way. -->
    <ItemGroup>
      <_CapsuleMapSource Include="@(CapsuleTiledMap);@(CapsuleNativeMap)" />
      <_CapsuleNativeMapStem Include="@(CapsuleNativeMap)">
        <Stem>$([System.IO.Path]::GetFileNameWithoutExtension('%(Filename)'))</Stem>
      </_CapsuleNativeMapStem>
      <_CapsuleMapName Include="@(CapsuleTiledMap->'%(Filename)');@(_CapsuleNativeMapStem->'%(Stem)')" />
      <_CapsuleMapNameDistinct Include="@(_CapsuleMapName->Distinct())" />
    </ItemGroup>

    <!-- A map is named after its source and the output tree is flat, so a repeated source name
         would leave one map silently overwriting the other — across the source kinds as much as
         within one, since both derive into the same directory. -->
    <Error Condition="'@(_CapsuleMapName->Count())' != '@(_CapsuleMapNameDistinct->Count())'"
           Text="Capsule: two map sources under '$(CapsuleAssetSourcesDir)/maps' share a name, and a map is named after its source. Rename one of: @(_CapsuleMapSource, ' ')" />

    <!-- The importer runs from the importing project's directory, so the derived paths are made
         absolute rather than left relative to wherever MSBuild was launched. The out directory
         carries no trailing separator: it is spliced into a command line, where a trailing one
         would escape the closing quote on Windows. -->
    <PropertyGroup>
      <CapsuleImportProjectDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</CapsuleImportProjectDir>
      <CapsuleMapsObjDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'capsule'))</CapsuleMapsObjDir>
      <CapsuleMapsOutDir>$(CapsuleMapsObjDir)/maps</CapsuleMapsOutDir>
      <CapsuleMapsDerivedDir>$(CapsuleMapsOutDir)/</CapsuleMapsDerivedDir>
      <CapsuleMapsBatchFile>$(CapsuleMapsObjDir)/tiled-maps.txt</CapsuleMapsBatchFile>
      <CapsuleNativeMapsBatchFile>$(CapsuleMapsObjDir)/native-maps.txt</CapsuleNativeMapsBatchFile>
      <CapsuleMapsTileSizeStamp>$(CapsuleMapsObjDir)/tile-size.txt</CapsuleMapsTileSizeStamp>
      <CapsuleMapsDependencyStamp>$(CapsuleMapsObjDir)/tiled-dependencies.txt</CapsuleMapsDependencyStamp>
      <CapsuleMapsSourceStamp>$(CapsuleMapsObjDir)/map-sources.txt</CapsuleMapsSourceStamp>
      <CapsuleMapsDependencyRootArg>--dependency-root &quot;$(CapsuleAssetSourcesDir)&quot; </CapsuleMapsDependencyRootArg>
      <CapsuleTileSizeArg Condition="'$(CapsuleTileSize)' != ''">--tile-size &quot;$(CapsuleTileSize)&quot; </CapsuleTileSizeArg>
    </PropertyGroup>

    <MakeDir Directories="$(CapsuleMapsObjDir)" />

    <!-- The declared size is an input to every map's import, and MSBuild's incrementality is
         file-based: without this stamp, changing CapsuleTileSize would leave maps already
         derived under the old one up to date and unchecked. -->
    <WriteLinesToFile File="$(CapsuleMapsTileSizeStamp)"
                      Lines="$(CapsuleTileSize)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <!-- A file list is itself an input. Without it, deleting or renaming a tileset removes
         that path from Inputs and can make a stale derived map appear current. -->
    <WriteLinesToFile File="$(CapsuleMapsDependencyStamp)"
                      Lines="@(CapsuleTiledTileset->'%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <!-- Which source each map is derived from, kind included. The two kinds derive into one
         directory under one naming rule, and each import target tracks only its own sources:
         lifting a shipped map back in as a `.map.json` and deleting the `.tmj` leaves a derived
         map the native target never authored, and no source of its own is newer than it. This
         stamp is what puts that map out of date, so the lift is validated, re-emitted and stamped
         with its new provenance rather than skipped. -->
    <WriteLinesToFile File="$(CapsuleMapsSourceStamp)"
                      Lines="@(CapsuleTiledMap->'%(Filename)=%(FullPath)');@(_CapsuleNativeMapStem->'%(Stem)=%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />

    <!-- Resolved here rather than where it is used: the importer is an input to every derived
         map, and a target's Inputs are evaluated after its DependsOnTargets have run but before
         its own tasks. Asked from inside the import target, the path would arrive after the
         up-to-date check that needs it, and a rebuilt importer would leave every map untouched.

         The removed properties are the same set the ProjectReference above drops, and they must
         be: the tool is built without them, so asking with them would name an output directory
         nothing wrote — a runtime identifier alone moves it under a RID folder. -->
    <MSBuild Projects="$(CapsuleMapsCliProject)"
             Condition="'$(CapsuleMapsCliProject)' != ''"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_CapsuleMapsTool" />
    </MSBuild>

    <ItemGroup Condition="'$(CapsuleMapsCliAssembly)' != ''">
      <_CapsuleMapsTool Include="$(CapsuleMapsCliAssembly)" />
    </ItemGroup>

    <!-- The importer is the assembly graph it loads, not its entry point. Reference assemblies
         are on, so an implementation-only change in Capsule.Maps rebuilds Capsule.Maps.dll and
         never recompiles Capsule.Maps.Cli — the entry point's timestamp would call every derived
         map current while the tool now writes them differently. The tool's own output directory
         is that graph, so globbing it derives the closure instead of listing it and a dependency
         added later needs no line here.

         The names are read now, before this build rebuilds the tool; the timestamps behind them
         at the up-to-date check, after. A dependency added since the last build therefore joins
         the list one build late, which changes nothing: adding it also rebuilt an assembly the
         list already holds. -->
    <ItemGroup>
      <_CapsuleMapsToolAssembly Include="%(_CapsuleMapsTool.RootDir)%(_CapsuleMapsTool.Directory)*.dll" />
    </ItemGroup>
  </Target>

  <!-- Inputs/Outputs make this partially incremental: the Tiled maps correlate one-to-one with
       the derived maps, so MSBuild re-runs the target with only the stale ones in
       @(CapsuleTiledMap), and the whole batch goes to one process. Never one process per map —
       a few hundred rooms would spend most of a cold build in host startup.

       The tilesets, the two stamps and the importer's assemblies are discrete inputs, correlating
       with nothing: touching any of them puts every map out of date and re-derives the lot. That
       is the honest dependency — a tile's Class is what a map's palette is made of, and the
       importer is what turns one into the other, so a game consuming Capsule from a sibling clone
       must not keep maps a changed importer would now write differently. A full re-derive is one
       process either way. -->
  <Target Name="CapsuleImportTiledMaps"
          Condition="'$(CapsuleImportMaps)' == 'true' and '@(CapsuleTiledMap)' != ''"
          DependsOnTargets="CapsuleMapsInit;ResolveProjectReferences"
          Inputs="@(CapsuleTiledMap);@(CapsuleTiledTileset);$(CapsuleMapsDependencyStamp);$(CapsuleMapsSourceStamp);$(CapsuleMapsTileSizeStamp);@(_CapsuleMapsTool);@(_CapsuleMapsToolAssembly)"
          Outputs="@(CapsuleTiledMap->'$(CapsuleMapsDerivedDir)%(Filename).map.json')">

    <Error Condition="!Exists('@(_CapsuleMapsTool)')"
           Text="Capsule: the map importer was not built (expected '@(_CapsuleMapsTool)')." />

    <!-- The batch goes through a file, not the command line: Exec runs through cmd, whose
         8191-character line limit a couple of hundred map paths blow past — and the error when
         they do names neither the limit nor a map.

         The Tiled maps are named relative to the importing project, and the tool runs from there.
         It
         stamps each path into its map's source block verbatim, so this is what decides that
         provenance reads '../asset-sources/maps/room.tmj' rather than a walk out of obj/. -->

    <!-- Metadata, not a transform: a property function inside @(->'') sees %(FullPath) as text. -->
    <ItemGroup>
      <_CapsuleTiledMapArg Include="@(CapsuleTiledMap)">
        <ProjectRelativePath>$([MSBuild]::MakeRelative($(CapsuleImportProjectDir), %(FullPath)))</ProjectRelativePath>
      </_CapsuleTiledMapArg>
    </ItemGroup>

    <WriteLinesToFile File="$(CapsuleMapsBatchFile)"
                      Lines="@(_CapsuleTiledMapArg->'%(ProjectRelativePath)')"
                      Overwrite="true" />

    <!-- LogStandardErrorAsError surfaces the tool's own per-map messages verbatim as build
         errors, each already anchored to the map that failed. -->
    <Exec Command="&quot;$(CapsuleDotNetHost)&quot; &quot;@(_CapsuleMapsTool)&quot; import-tiled --out &quot;$(CapsuleMapsOutDir)&quot; $(CapsuleMapsDependencyRootArg)$(CapsuleTileSizeArg)--maps-from &quot;$(CapsuleMapsBatchFile)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          LogStandardErrorAsError="true"
          StandardOutputImportance="normal" />
  </Target>

  <!-- As the Tiled import, minus the tilesets: a native source references nothing, so it, the
       stamps and the importer are the whole dependency. The derived name falls out of
       %(Filename) — '<stem>.map' — plus the .json this re-emits it as. -->
  <Target Name="CapsuleImportNativeMaps"
          Condition="'$(CapsuleImportMaps)' == 'true' and '@(CapsuleNativeMap)' != ''"
          DependsOnTargets="CapsuleMapsInit;ResolveProjectReferences"
          Inputs="@(CapsuleNativeMap);$(CapsuleMapsSourceStamp);$(CapsuleMapsTileSizeStamp);@(_CapsuleMapsTool);@(_CapsuleMapsToolAssembly)"
          Outputs="@(CapsuleNativeMap->'$(CapsuleMapsDerivedDir)%(Filename).json')">

    <Error Condition="!Exists('@(_CapsuleMapsTool)')"
           Text="Capsule: the map importer was not built (expected '@(_CapsuleMapsTool)')." />

    <ItemGroup>
      <_CapsuleNativeMapArg Include="@(CapsuleNativeMap)">
        <ProjectRelativePath>$([MSBuild]::MakeRelative($(CapsuleImportProjectDir), %(FullPath)))</ProjectRelativePath>
      </_CapsuleNativeMapArg>
    </ItemGroup>

    <WriteLinesToFile File="$(CapsuleNativeMapsBatchFile)"
                      Lines="@(_CapsuleNativeMapArg->'%(ProjectRelativePath)')"
                      Overwrite="true" />

    <Exec Command="&quot;$(CapsuleDotNetHost)&quot; &quot;@(_CapsuleMapsTool)&quot; import-native --out &quot;$(CapsuleMapsOutDir)&quot; $(CapsuleTileSizeArg)--maps-from &quot;$(CapsuleNativeMapsBatchFile)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          LogStandardErrorAsError="true"
          StandardOutputImportance="normal" />
  </Target>

  <!-- Separate from the imports so the content is wired on an up-to-date build too, where they
       are skipped entirely. -->
  <Target Name="CapsuleAddMapsToOutput"
          Condition="'$(CapsuleImportMaps)' == 'true' and ('@(CapsuleTiledMap)' != '' or '@(CapsuleNativeMap)' != '')"
          DependsOnTargets="CapsuleImportTiledMaps;CapsuleImportNativeMaps"
          BeforeTargets="AssignTargetPaths">

    <!-- Named in two steps on purpose: %() in the Content metadata below batches over the item
         the Include names, so a transform there would resolve %(Filename) against the source. -->
    <ItemGroup>
      <_CapsuleDerivedMap Include="@(CapsuleTiledMap->'$(CapsuleMapsDerivedDir)%(Filename).map.json')" />
      <_CapsuleDerivedMap Include="@(CapsuleNativeMap->'$(CapsuleMapsDerivedDir)%(Filename).json')" />
    </ItemGroup>

    <ItemGroup>
      <Content Include="@(_CapsuleDerivedMap)">
        <Link>Assets/Maps/%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
  </Target>

</Project>
