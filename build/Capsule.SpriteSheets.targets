<Project>

  <!-- Validates every sprite sheet document a game authors, re-emits it canonically under obj/, and
       renders the whole set as one generated C# file the game compiles. Nothing derived is
       committed, and nothing ships: a sheet is a table of integers, so the build turns it into
       typed frames and clips and a misspelt frame is a compile error.

       That is why this hook belongs to the logic role rather than the shell:

         <CapsuleImportSprites>true</CapsuleImportSprites>

       A logic assembly is one by definition and needs no line. Anything else that has to compile
       against a game's frames and clips — a test assembly building a scene in code — opts in with
       that property.

       The engine wires one format: *.sheet.json, found by convention under
       $(CapsuleAssetSourcesDir)/sprites. A packer's output or an editor's file enters through an
       authoring module — a package whose targets derive a *.sheet.json per source into their own
       obj space and add each derived document to the CapsuleSheetDocument item from a target that
       runs BeforeTargets="CapsuleCollectSheetDocuments". Those documents then take the same path
       as hand-authored ones. A document that arrives with a source block keeps it.

       A module reads Capsule's properties only inside its targets: NuGet imports a package's
       targets in no promised order, so at evaluation time CapsuleImportSprites may not yet be what
       the logic role makes it, while every target runs after evaluation has settled. The
       BeforeTargets hook is resolved at execution for the same reason; a module that is imported
       after this file may append to $(CapsuleCollectSheetDocumentsDependsOn) instead. -->

  <PropertyGroup Condition="'$(CapsuleImportSprites)' == 'true'">
    <CapsuleCollectSheetDocumentsDependsOn Condition="'$(CapsuleCollectSheetDocumentsDependsOn)' == ''"></CapsuleCollectSheetDocumentsDependsOn>
  </PropertyGroup>

  <ItemGroup Condition="'$(CapsuleImportSprites)' == 'true'">
    <CapsuleNativeSheet Include="$(CapsuleAssetSourcesDir)/sprites/**/*.sheet.json" />
  </ItemGroup>

  <!-- The seam an authoring module hooks: its derivation targets run here, before the engine reads
       the CapsuleSheetDocument item. -->
  <Target Name="CapsuleCollectSheetDocuments"
          Condition="'$(CapsuleImportSprites)' == 'true'"
          DependsOnTargets="CapsuleAssetSourcesInit;$(CapsuleCollectSheetDocumentsDependsOn)" />

  <!-- Every target here is conditioned on the property alone. A target's own condition is
       evaluated before its DependsOnTargets are built, so one asked about an item another target
       fills would never let that target run; whether there is anything to import is decided
       task by task inside them. -->
  <Target Name="CapsuleSheetDocumentsInit"
          Condition="'$(CapsuleImportSprites)' == 'true'"
          DependsOnTargets="CapsuleCollectSheetDocuments;CapsuleAssetsInit;CapsuleResolveBuildTool">

    <Error Condition="('@(CapsuleNativeSheet)' != '' or '@(CapsuleSheetDocument)' != '') and '$(CapsuleBuildToolProject)' == '' and '$(CapsuleBuildToolAssembly)' == ''"
           Text="Capsule: the sprite sheet importer is unavailable. Reference the Capsule.Build package, or import build/Capsule.Build.targets from a Capsule source clone." />

    <!-- A source's %(Filename) is '<stem>.sheet', so the extension comes off it a second time. -->
    <ItemGroup>
      <_CapsuleSheetSource Include="@(CapsuleNativeSheet);@(CapsuleSheetDocument)">
        <Stem>$([System.IO.Path]::GetFileNameWithoutExtension('%(Filename)'))</Stem>
      </_CapsuleSheetSource>
      <_CapsuleSheetName Include="@(_CapsuleSheetSource->'%(Stem)')" />
      <_CapsuleSheetNameDistinct Include="@(_CapsuleSheetName->Distinct())" />
    </ItemGroup>

    <!-- A sheet is named after its source and its generated class is named after the sheet, so a
         repeated name would be two classes of one name — across a hand-authored document and a
         module's as much as within one origin. -->
    <Error Condition="'@(_CapsuleSheetName->Count())' != '@(_CapsuleSheetNameDistinct->Count())'"
           Text="Capsule: two sprite sheet sources share a name, and a sheet's generated class is named after its source. Rename one of: @(_CapsuleSheetSource, ' ')" />

    <!-- The textures a sheet may cut from are exactly the ones this game ships, so the list is the
         asset hook's own texture domain rather than a second enumeration. -->
    <ItemGroup>
      <_CapsuleSheetTextureAsset Include="@(CapsuleAsset)" Condition="'%(CapsuleAsset.CapsuleAssetDomain)' == 'textures'" />
      <_CapsuleSheetTextureName Include="@(_CapsuleSheetTextureAsset->'%(Filename)%(Extension)')" />
    </ItemGroup>

    <!-- The importer runs from the importing project's directory, so the derived paths are made
         absolute rather than left relative to wherever MSBuild was launched. The out directory
         carries no trailing separator: it is spliced into a command line, where a trailing one
         would escape the closing quote on Windows. -->
    <PropertyGroup>
      <CapsuleSheetProjectDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</CapsuleSheetProjectDir>
      <CapsuleSheetDocumentsObjDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'capsule'))</CapsuleSheetDocumentsObjDir>
      <CapsuleSheetDocumentsOutDir>$(CapsuleSheetDocumentsObjDir)/sprites</CapsuleSheetDocumentsOutDir>
      <CapsuleSheetDocumentsBatchFile>$(CapsuleSheetDocumentsObjDir)/sheet-documents.txt</CapsuleSheetDocumentsBatchFile>
      <CapsuleSheetTextureStamp>$(CapsuleSheetDocumentsObjDir)/sheet-textures.txt</CapsuleSheetTextureStamp>
      <CapsuleSheetSourceStamp>$(CapsuleSheetDocumentsObjDir)/sheet-sources.txt</CapsuleSheetSourceStamp>
      <CapsuleSpriteRegistryFile>$(CapsuleSheetDocumentsObjDir)/CapsuleGameSprites.g.cs</CapsuleSpriteRegistryFile>
    </PropertyGroup>

    <MakeDir Directories="$(CapsuleSheetDocumentsObjDir)" Condition="'@(_CapsuleSheetSource)' != ''" />

    <!-- Both lists are inputs to the import, and MSBuild's incrementality is file-based: without
         these stamps, renaming a texture or moving a sheet from a module's format to a
         hand-authored document would leave the generated registry up to date and unchecked. -->
    <WriteLinesToFile File="$(CapsuleSheetTextureStamp)"
                      Lines="@(_CapsuleSheetTextureName)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Condition="'@(_CapsuleSheetSource)' != ''" />

    <WriteLinesToFile File="$(CapsuleSheetSourceStamp)"
                      Lines="@(_CapsuleSheetSource->'%(Stem)=%(FullPath)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Condition="'@(_CapsuleSheetSource)' != ''" />
  </Target>

  <!-- One output for the whole set, so this is all-or-nothing rather than partially incremental:
       every sheet is declared on one generated class, and a single changed frame rewrites it.
       Never one process per sheet, and none at all for a game that has authored none. -->
  <Target Name="CapsuleImportSheetDocuments"
          Condition="'$(CapsuleImportSprites)' == 'true'"
          DependsOnTargets="CapsuleSheetDocumentsInit;ResolveProjectReferences"
          Inputs="@(_CapsuleSheetSource);$(CapsuleSheetSourceStamp);$(CapsuleSheetTextureStamp);@(_CapsuleBuildTool);@(_CapsuleBuildToolAssembly)"
          Outputs="$(CapsuleSpriteRegistryFile)">

    <Error Condition="'@(_CapsuleSheetSource)' != '' and !Exists('@(_CapsuleBuildTool)')"
           Text="Capsule: the sprite sheet importer was not built (expected '@(_CapsuleBuildTool)')." />

    <!-- The batch goes through a file, not the command line: Exec runs through cmd, whose
         8191-character line limit a couple of hundred paths blow past — and the error when they do
         names neither the limit nor a sheet.

         Sources are named relative to the importing project, and the tool runs from there, so a
         failure names a path a person can open. -->

    <!-- Metadata, not a transform: a property function inside @(->'') sees %(FullPath) as text. -->
    <ItemGroup>
      <_CapsuleSheetSourceArg Include="@(_CapsuleSheetSource)">
        <ProjectRelativePath>$([MSBuild]::MakeRelative($(CapsuleSheetProjectDir), %(FullPath)))</ProjectRelativePath>
      </_CapsuleSheetSourceArg>
    </ItemGroup>

    <WriteLinesToFile File="$(CapsuleSheetDocumentsBatchFile)"
                      Lines="@(_CapsuleSheetSourceArg->'%(ProjectRelativePath)')"
                      Overwrite="true"
                      Condition="'@(_CapsuleSheetSource)' != ''" />

    <!-- LogStandardErrorAsError surfaces the tool's own per-source messages verbatim as build
         errors, each already anchored to the source that failed. -->
    <Exec Command="&quot;$(CapsuleDotNetHost)&quot; &quot;@(_CapsuleBuildTool)&quot; --out &quot;$(CapsuleSheetDocumentsOutDir)&quot; --sheets-from &quot;$(CapsuleSheetDocumentsBatchFile)&quot; --textures &quot;$(CapsuleSheetTextureStamp)&quot; --generated &quot;$(CapsuleSpriteRegistryFile)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          LogStandardErrorAsError="true"
          StandardOutputImportance="normal"
          Condition="'@(_CapsuleSheetSource)' != ''" />
  </Target>

  <!-- Separate from the import so the file is compiled on an up-to-date build too, where the import
       is skipped entirely. Both BeforeTargets are named because a design-time build reaches
       CoreCompile without running BeforeCompile's usual chain, and IntelliSense over a game's
       frames and clips depends on the item being there. -->
  <Target Name="CapsuleAddSpriteRegistryToCompile"
          Condition="'$(CapsuleImportSprites)' == 'true'"
          DependsOnTargets="CapsuleImportSheetDocuments"
          BeforeTargets="BeforeCompile;CoreCompile">
    <ItemGroup Condition="'@(_CapsuleSheetSource)' != ''">
      <Compile Include="$(CapsuleSpriteRegistryFile)" />
      <FileWrites Include="$(CapsuleSpriteRegistryFile)" />
    </ItemGroup>
  </Target>

</Project>
