<Project>

  <ItemGroup Condition="'$(CapsuleImportSprites)' == 'true'">
    <CapsuleNativeSheet Include="$(CapsuleAssetSourcesDir)/Sprites/**/*.sheet.json"
                        Exclude="@(_CapsuleDevelopmentOnly)">
      <CapsuleDocumentDir>%(RecursiveDir)</CapsuleDocumentDir>
    </CapsuleNativeSheet>
  </ItemGroup>

  <!-- Authoring modules populate CapsuleSheetDocument before this collection target. -->
  <Target Name="CapsuleCollectSheetDocuments"
          Condition="'$(CapsuleImportSprites)' == 'true'"
          DependsOnTargets="CapsuleAssetSourcesInit;$(CapsuleCollectSheetDocumentsDependsOn)" />

  <!-- Target conditions are evaluated before dependencies populate document items. -->
  <Target Name="CapsuleSheetDocumentsInit"
          Condition="'$(CapsuleImportSprites)' == 'true'"
          DependsOnTargets="CapsuleReadKeys">

    <Error Condition="'@(_CapsuleSheetRequest)' != '' and '$(CapsuleBuildToolProject)' == '' and '$(CapsuleBuildToolAssembly)' == ''"
           Text="Capsule: the sprite sheet importer is unavailable. Reference the Capsule.Build package, or import build/Capsule.Build.targets from a Capsule source clone." />

    <PropertyGroup>
      <CapsuleSheetDocumentsOutDir>$(CapsuleObjDir)/sprites</CapsuleSheetDocumentsOutDir>
      <CapsuleSheetDocumentsBatchFile>$(CapsuleKeysDir)/sprites.txt</CapsuleSheetDocumentsBatchFile>
      <CapsuleSheetTextureFile>$(CapsuleKeysDir)/textures.txt</CapsuleSheetTextureFile>
      <CapsuleSpriteRegistryFile>$(CapsuleObjDir)/CapsuleAssets.Sprites.g.cs</CapsuleSpriteRegistryFile>
    </PropertyGroup>
  </Target>

  <!-- The single generated registry makes this target all-or-nothing incremental. -->
  <Target Name="CapsuleImportSheetDocuments"
          Condition="'$(CapsuleImportSprites)' == 'true'"
          DependsOnTargets="CapsuleSheetDocumentsInit;ResolveProjectReferences"
          Inputs="@(_CapsuleSheetRequest);$(CapsuleSheetDocumentsBatchFile);$(CapsuleSheetTextureFile);@(_CapsuleBuildTool);@(_CapsuleBuildToolAssembly)"
          Outputs="$(CapsuleSpriteRegistryFile)">

    <Error Condition="'@(_CapsuleSheetRequest)' != '' and !Exists('@(_CapsuleBuildTool)')"
           Text="Capsule: the sprite sheet importer was not built (expected '@(_CapsuleBuildTool)')." />

    <Exec Command="&quot;$(CapsuleDotNetHost)&quot; &quot;@(_CapsuleBuildTool)&quot; --out &quot;$(CapsuleSheetDocumentsOutDir)&quot; --sheets-from &quot;$(CapsuleSheetDocumentsBatchFile)&quot; --textures &quot;$(CapsuleSheetTextureFile)&quot; --generated &quot;$(CapsuleSpriteRegistryFile)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          LogStandardErrorAsError="true"
          StandardOutputImportance="normal"
          Condition="'@(_CapsuleSheetRequest)' != ''" />
  </Target>

  <!-- Keep generated code in up-to-date and design-time builds. -->
  <Target Name="CapsuleAddSpriteRegistryToCompile"
          Condition="'$(CapsuleImportSprites)' == 'true'"
          DependsOnTargets="CapsuleImportSheetDocuments"
          BeforeTargets="BeforeCompile;CoreCompile">
    <ItemGroup Condition="'@(_CapsuleSheetRequest)' != ''">
      <Compile Include="$(CapsuleSpriteRegistryFile)" />
      <FileWrites Include="$(CapsuleSpriteRegistryFile)" />
    </ItemGroup>
  </Target>

</Project>
