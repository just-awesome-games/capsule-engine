<Project>

  <!-- The two native tools a shader compiles through, one version each, in this file alone. The
       JAG.Capsule.Build package depends on these versions. The game build targets from an engine
       clone, the runtime's own sprite shader and the engine's tests download them with a
       PackageDownload, and all of them name their package folders to Capsule.Build. -->
  <PropertyGroup>
    <CapsuleDxcVersion>1.9.2607.1</CapsuleDxcVersion>
    <CapsuleSpirvCrossVersion>1.4.350</CapsuleSpirvCrossVersion>
  </PropertyGroup>

</Project>
