<Project>

  <!-- The package of the native tools a shader compiles through, DXC and SPIRV-Cross, at one version in
       this file alone. natives/ builds it. JAG.Capsule depends on this version. Restore downloads it for
       every project that references it, from the package or from an engine clone. Capsule.Assets.targets
       names its package folder to the build tool, and the engine's tests read the same folder. -->
  <PropertyGroup>
    <CapsuleShaderToolsVersion>1.0.1</CapsuleShaderToolsVersion>
  </PropertyGroup>

</Project>
