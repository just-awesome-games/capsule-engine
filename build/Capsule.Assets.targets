<Project>

  <!-- The asset pipeline, on when CapsuleBuildAssets is true. MSBuild never walks Assets/. Every
       build runs the game's build project once (CapsuleRunBuildTool), which writes everything under
       obj/capsule/, or obj/capsule-shipping/ for a publish: imported/, assets/, CapsuleAssets.g.cs,
       CapsuleStrings.g.cs when the game authors texts, icon/ when it authors an Icon.png, and
       derivation-cache.json. CapsuleAddBuildOutputs hands assets/ and the generated sources to MSBuild,
       and CapsuleGetApplicationIcon hands icon/ to the shell. -->

  <!-- Every path the run is handed starts from _CapsuleProjectDirectory, Capsule.Defaults.props's
       spelling of the project directory. -->
  <PropertyGroup>
    <CapsuleAssetSourcesDeclared Condition="'$(CapsuleAssetSourcesDir)' != ''">true</CapsuleAssetSourcesDeclared>
    <CapsuleAssetSourcesDir Condition="'$(CapsuleAssetSourcesDir)' == ''">Assets</CapsuleAssetSourcesDir>
    <CapsuleAssetSourcesDir>$([MSBuild]::NormalizePath('$(_CapsuleProjectDirectory)', '$(CapsuleAssetSourcesDir)'))</CapsuleAssetSourcesDir>
    <CapsuleDotNetHost Condition="'$(CapsuleDotNetHost)' == ''">$(DOTNET_HOST_PATH)</CapsuleDotNetHost>
    <CapsuleDotNetHost Condition="'$(CapsuleDotNetHost)' == ''">dotnet</CapsuleDotNetHost>
  </PropertyGroup>

  <!-- No asset file is an MSBuild item. An IDE's own up-to-date check cannot see an edit. It
       always calls MSBuild, and the run decides. -->
  <PropertyGroup Condition="'$(CapsuleBuildAssets)' == 'true'">
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>

  <!-- Every other target of the pipeline runs after this one. CapsuleObjDir is set here because
       IntermediateOutputPath is final only after the SDK's targets, and a project may import this
       file from its own body, ahead of them. Only an explicitly declared asset root must exist. -->
  <Target Name="CapsuleAssetSourcesInit"
          Condition="'$(CapsuleBuildAssets)' == 'true'"
          BeforeTargets="AssignTargetPaths">
    <PropertyGroup>
      <CapsuleObjDir Condition="'$(CapsuleObjDir)' == '' and '$(CapsuleShipping)' == 'true'">$([MSBuild]::NormalizePath('$(_CapsuleProjectDirectory)', '$(IntermediateOutputPath)', 'capsule-shipping'))</CapsuleObjDir>
      <CapsuleObjDir Condition="'$(CapsuleObjDir)' == ''">$([MSBuild]::NormalizePath('$(_CapsuleProjectDirectory)', '$(IntermediateOutputPath)', 'capsule'))</CapsuleObjDir>
    </PropertyGroup>

    <Error Condition="'$(CapsuleAssetSourcesDeclared)' == 'true' and !Exists('$(CapsuleAssetSourcesDir)')"
           Text="Capsule: CapsuleAssetSourcesDir points at '$(CapsuleAssetSourcesDir)', which does not exist. Point it at the directory holding the game's authoring sources, or leave it unset to look for them at &lt;importing project&gt;/Assets." />
  </Target>

  <!-- The logic project builds the game's build project first and adds nothing of it to the game.
       No GlobalPropertiesToRemove: it would request the build project's shared engine subgraph under
       a second global-property set, and two builds would race into one output. -->
  <ItemGroup Condition="'$(CapsuleBuildAssets)' == 'true' and '$(CapsuleBuildProject)' != ''">
    <ProjectReference Include="$(CapsuleBuildProject)"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      ExcludeAssets="all"
                      PrivateAssets="all"
                      Private="false" />
  </ItemGroup>

  <!-- Asks the build project for its output in the configuration the ProjectReference above builds. -->
  <Target Name="CapsuleResolveBuildTool" Condition="'$(CapsuleBuildAssets)' == 'true'">
    <Error Condition="'$(CapsuleBuildProject)' == ''"
           Text="Capsule: $(MSBuildProjectName) builds assets but names no build project. Set CapsuleBuildProject to the game's build project, a console app referencing JAG.Capsule.Build that runs CapsuleBuild, as docs/build-and-publish.md shows." />

    <MSBuild Projects="$(CapsuleBuildProject)"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_CapsuleBuildTool" />
    </MSBuild>
  </Target>

  <!-- One process per build, on every build. Tiered PGO's instrumentation costs the short process
       more than it saves. Each directory argument is trimmed of a trailing separator,
       which would escape its closing quote on Windows. -->
  <Target Name="CapsuleRunBuildTool"
          Condition="'$(CapsuleBuildAssets)' == 'true'"
          DependsOnTargets="CapsuleAssetSourcesInit;CapsuleResolveBuildTool;ResolveProjectReferences">
    <PropertyGroup>
      <_CapsuleAssetsArgument>$([System.IO.Path]::TrimEndingDirectorySeparator('$(CapsuleAssetSourcesDir)'))</_CapsuleAssetsArgument>
      <_CapsuleOutArgument>$([System.IO.Path]::TrimEndingDirectorySeparator('$(CapsuleObjDir)'))</_CapsuleOutArgument>
      <_CapsuleShippingArgument Condition="'$(CapsuleShipping)' == 'true'"> --shipping</_CapsuleShippingArgument>
      <_CapsuleShaderTools>$([MSBuild]::NormalizePath('$(NuGetPackageRoot)', 'jag.capsule.shadertools', '$(CapsuleShaderToolsVersion)'))</_CapsuleShaderTools>
      <!-- A platform module's further GPU formats, each a CapsuleShaderFormat item named for the format
           whose Tool metadata is the absolute path of the compiler every stage goes through, declared
           here or forwarded by the shell. docs/packages.md names the options the tool takes. -->
      <_CapsuleShaderFormatArguments>@(CapsuleShaderFormat->' --shader-format &quot;%(Identity)=%(Tool)&quot;', '')</_CapsuleShaderFormatArguments>
      <_CapsuleShaderFormatArguments Condition="'$(CapsuleShaderFormatTools)' != ''">$(_CapsuleShaderFormatArguments) --shader-format &quot;$(CapsuleShaderFormatTools.Replace('|', '&quot; --shader-format &quot;'))&quot;</_CapsuleShaderFormatArguments>
    </PropertyGroup>

    <MakeDir Directories="$(CapsuleObjDir)" />
    <Exec Command="&quot;$(CapsuleDotNetHost)&quot; &quot;@(_CapsuleBuildTool)&quot; --assets &quot;$(_CapsuleAssetsArgument)&quot; --out &quot;$(_CapsuleOutArgument)&quot;$(_CapsuleShippingArgument) --shader-tools &quot;$(_CapsuleShaderTools)&quot;$(_CapsuleShaderFormatArguments)"
          WorkingDirectory="$(_CapsuleProjectDirectory)"
          EnvironmentVariables="DOTNET_TieredPGO=0"
          LogStandardErrorAsError="true"
          StandardOutputImportance="normal" />
  </Target>

  <!-- A platform module declares its formats on the shell, and the logic library it references builds
       the assets. The shell hands every reference the formats as CapsuleShaderFormatTools, name=tool
       pairs separated by |. -->
  <Target Name="CapsuleForwardShaderFormats"
          Condition="'$(CapsuleGameShell)' == 'true' and '@(CapsuleShaderFormat)' != ''"
          BeforeTargets="AssignProjectConfiguration">
    <PropertyGroup>
      <_CapsuleForwardedShaderFormats>@(CapsuleShaderFormat->'%(Identity)=%(Tool)', '|')</_CapsuleForwardedShaderFormats>
    </PropertyGroup>
    <ItemGroup>
      <ProjectReference>
        <AdditionalProperties>%(ProjectReference.AdditionalProperties);CapsuleShaderFormatTools=$(_CapsuleForwardedShaderFormats)</AdditionalProperties>
      </ProjectReference>
    </ItemGroup>
  </Target>

  <!-- Runs on up-to-date builds too, from what the last run left on disk. It also runs before BeforeCompile,
       because a design-time build enters at Compile and never reaches AssignTargetPaths. -->
  <Target Name="CapsuleAddBuildOutputs"
          Condition="'$(CapsuleBuildAssets)' == 'true'"
          DependsOnTargets="CapsuleRunBuildTool"
          BeforeTargets="AssignTargetPaths;BeforeCompile;CoreCompile">

    <ItemGroup>
      <_CapsuleShipped Include="$(CapsuleObjDir)/assets/**" />
      <Content Include="@(_CapsuleShipped)">
        <Link>assets/%(_CapsuleShipped.RecursiveDir)%(_CapsuleShipped.Filename)%(_CapsuleShipped.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Visible>false</Visible>
      </Content>

      <Compile Condition="'$(CapsuleGameLogic)' == 'true'" Include="$(CapsuleObjDir)/CapsuleAssets.g.cs" />
      <Compile Condition="'$(CapsuleGameLogic)' == 'true' and Exists('$(CapsuleObjDir)/CapsuleStrings.g.cs')" Include="$(CapsuleObjDir)/CapsuleStrings.g.cs" />

      <!-- Everything the tool writes is cleaned together. No clean leaves the cache behind the
           outputs it vouches for. -->
      <FileWrites Include="$(CapsuleObjDir)/**" />
    </ItemGroup>
  </Target>

  <!-- The application icon pair the last run derived from Icon.png, which the shell asks its references
       for once they have built. The run leaves icon/ empty when the game authors no Icon.png. -->
  <Target Name="CapsuleGetApplicationIcon"
          DependsOnTargets="CapsuleAssetSourcesInit"
          Returns="@(_CapsuleApplicationIcon)">
    <ItemGroup Condition="'$(CapsuleBuildAssets)' == 'true' and Exists('$(CapsuleObjDir)/icon/Icon.ico') and Exists('$(CapsuleObjDir)/icon/Icon.png')">
      <_CapsuleApplicationIcon Include="$(CapsuleObjDir)/icon/Icon.ico" CapsuleIcon="Executable" />
      <_CapsuleApplicationIcon Include="$(CapsuleObjDir)/icon/Icon.png" CapsuleIcon="Window" />
    </ItemGroup>
  </Target>

</Project>
