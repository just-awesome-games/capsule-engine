<Project>

  <!-- Ships the game's general assets and names them for its code. asset-sources/ is the
       committed authoring plane; assets/ beside the executable is derived and build-owned, so
       nothing under it is committed and what ships is exactly what is authored.

       Three domain roots under $(CapsuleAssetSourcesDir), each admitting the extensions listed
       below: textures/ (.png), audio/ (.ogg, .wav) and fonts/ (.ttf, .otf). A source's directory
       under its domain root is kept: an asset filed at textures/enemies/bat.png ships at
       assets/textures/enemies/bat.png, its handle is named 'enemies/bat', and the generated
       registry declares it as GameAssets.Textures.Enemies.Bat. A domain gained here is a domain
       gained everywhere, and the handle it hands out is paired with it in
       Capsule.Generators' asset registry — the one other place the domains are named.

       %(CapsuleAssetPath) is that domain-relative path with the extension off. It carries the
       platform's separator, since %(RecursiveDir) does; every consumer that compares it against
       authored text normalises to '/' first.

       A project ships them by declaring:

         <CapsuleShipAssets>true</CapsuleShipAssets>

       A shell is one by definition and needs no line. A logic assembly ships nothing and gets the
       generated GameAssets registry instead: the asset list reaches the generator as
       AdditionalFiles, so a handle is a compile-time name for a file the build has seen, and a
       misspelt asset is a compile error rather than a missing file on somebody else's machine.

       Nothing here transforms bytes: an asset is copied verbatim, and the host reads it back —
       every texture the generated registry holds is decoded onto the device at boot. -->

  <ItemGroup Condition="'$(CapsuleReadsAssetSources)' == 'true'">
    <CapsuleAsset Include="$(CapsuleAssetSourcesDir)/textures/**/*.png">
      <CapsuleAssetDomain>textures</CapsuleAssetDomain>
      <CapsuleAssetPath>%(RecursiveDir)%(Filename)</CapsuleAssetPath>
    </CapsuleAsset>
    <CapsuleAsset Include="$(CapsuleAssetSourcesDir)/audio/**/*.ogg;$(CapsuleAssetSourcesDir)/audio/**/*.wav">
      <CapsuleAssetDomain>audio</CapsuleAssetDomain>
      <CapsuleAssetPath>%(RecursiveDir)%(Filename)</CapsuleAssetPath>
    </CapsuleAsset>
    <CapsuleAsset Include="$(CapsuleAssetSourcesDir)/fonts/**/*.ttf;$(CapsuleAssetSourcesDir)/fonts/**/*.otf">
      <CapsuleAssetDomain>fonts</CapsuleAssetDomain>
      <CapsuleAssetPath>%(RecursiveDir)%(Filename)</CapsuleAssetPath>
    </CapsuleAsset>

    <!-- Everything under a domain root, so whatever the lists above did not admit is caught as a
         typo rather than silently never shipping. A file outside these roots is not an asset and
         is not looked at, which is where an authoring intermediate belongs. -->
    <_CapsuleDomainFile Include="$(CapsuleAssetSourcesDir)/textures/**/*;$(CapsuleAssetSourcesDir)/audio/**/*;$(CapsuleAssetSourcesDir)/fonts/**/*" />
    <_CapsuleUnknownAsset Include="@(_CapsuleDomainFile)" Exclude="@(CapsuleAsset)" />
  </ItemGroup>

  <ItemGroup Condition="'$(CapsuleGameLogic)' == 'true'">
    <AdditionalFiles Include="@(CapsuleAsset)" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="CapsuleAssetDomain" />
    <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="CapsuleAssetPath" />
  </ItemGroup>

  <!-- Hooked into the build in its own right, not only through the copy: the checks below must
       run in a logic assembly too, where nothing ships. -->
  <Target Name="CapsuleAssetsInit"
          Condition="'$(CapsuleReadsAssetSources)' == 'true'"
          DependsOnTargets="CapsuleAssetSourcesInit"
          BeforeTargets="AssignTargetPaths">

    <Error Condition="'@(_CapsuleUnknownAsset)' != ''"
           Text="Capsule: a file under an asset domain root has an extension that domain does not admit — textures/ takes .png, audio/ takes .ogg and .wav, fonts/ takes .ttf and .otf. Correct the extension, or move the file out of the domain roots under '$(CapsuleAssetSourcesDir)': @(_CapsuleUnknownAsset, ' ')" />

    <ItemGroup>
      <_CapsuleAssetName Include="@(CapsuleAsset->'%(CapsuleAssetDomain)/%(CapsuleAssetPath)')" />
      <_CapsuleAssetNameDistinct Include="@(_CapsuleAssetName->Distinct())" />
    </ItemGroup>

    <!-- An asset is named after its path under its domain root, and ships at that path, so a
         repeated path would leave one asset silently overwriting the other. A repeated stem in two
         directories is two assets. -->
    <Error Condition="'@(_CapsuleAssetName->Count())' != '@(_CapsuleAssetNameDistinct->Count())'"
           Text="Capsule: two assets under '$(CapsuleAssetSourcesDir)' share a path within their domain, differing only in extension. Rename one of: @(CapsuleAsset, ' ')" />
  </Target>

  <Target Name="CapsuleAddAssetsToOutput"
          Condition="'$(CapsuleShipAssets)' == 'true' and '@(CapsuleAsset)' != ''"
          DependsOnTargets="CapsuleAssetsInit"
          BeforeTargets="AssignTargetPaths">
    <!-- Qualified metadata, not bare: %() in the Content metadata below would otherwise batch over
         Content, which already carries a game's own files and the derived scene documents. -->
    <ItemGroup>
      <Content Include="@(CapsuleAsset)">
        <Link>assets/%(CapsuleAsset.CapsuleAssetDomain)/%(CapsuleAsset.CapsuleAssetPath)%(CapsuleAsset.Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Visible>false</Visible>
      </Content>
    </ItemGroup>
  </Target>

</Project>
