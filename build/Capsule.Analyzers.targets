<Project>

  <!-- A game's declared role is the complete configuration surface. The analyzer makes that
       role enforceable without requiring consumers to copy rule lists or editor settings.
       Role legality itself — conflicting roles, a role without the module it needs — is
       diagnosed by the registry generator (CAP011 onwards), so it reaches the editor live and
       reads as one family rather than half a build error and half a diagnostic. -->

  <ItemGroup Condition="'$(CapsuleGameLogic)' == 'true' or '$(CapsuleGameShell)' == 'true'">
    <CompilerVisibleProperty Include="CapsuleGameLogic" />
    <CompilerVisibleProperty Include="CapsuleGameShell" />

    <!-- Source-clone development. The private package replaces this with an Analyzer item that
         points at its bundled DLL while preserving the same zero-configuration behavior. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Capsule.Analyzers/Capsule.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      AdditionalProperties="PublishAot=false;PublishTrimmed=false;SelfContained=false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"
                      PrivateAssets="all"
                      Condition="Exists('$(MSBuildThisFileDirectory)../src/Capsule.Analyzers/Capsule.Analyzers.csproj')" />
  </ItemGroup>

</Project>
