<Project>

  <!-- How a Capsule game builds. This file holds the mode switches and imports every concern from
       its own file. A package consumer gets it as buildTransitive/JAG.Capsule.targets, so every
       project referencing JAG.Capsule imports it, whatever it is. Capsule.Build.props imports it for
       a source consumer. The pipeline, the generator, the shell's shape and its publish answer to a
       role. What a role-free library, test or tool receives is marked universal where it is set. -->

  <!-- The mode switches. The files below read them at evaluation. -->
  <PropertyGroup>
    <!-- The build's shape: true for a publish, false for every other build. _IsPublishing flows
         through project references, and CapsuleShipping stays directly testable. -->
    <CapsuleShipping Condition="'$(CapsuleShipping)' == ''">$(_IsPublishing)</CapsuleShipping>
    <CapsuleShipping Condition="'$(CapsuleShipping)' == ''">false</CapsuleShipping>

    <!-- The asset pipeline. A project that sets it reads the authoring tree and ships what it
         derives. The logic role sets it, and a role-free test or tool may. -->
    <CapsuleBuildAssets Condition="'$(CapsuleBuildAssets)' == '' and '$(CapsuleGameLogic)' == 'true'">true</CapsuleBuildAssets>
  </PropertyGroup>

  <!-- A role's JSON goes through the generated contexts only, which is what a NativeAOT publish
       runs. A role-free library keeps the SDK's default. -->
  <PropertyGroup Condition="'$(CapsuleGameLogic)' == 'true' or '$(CapsuleGameShell)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(JsonSerializerIsReflectionEnabledByDefault)' == ''">false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- Capsule.Publish.targets reads CapsuleShipping at evaluation, so the switches come first.
       Targets hooked to the same point run in import order, and this list keeps the order they have
       always run in. -->
  <Import Project="$(MSBuildThisFileDirectory)Capsule.SourceConsumer.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.DevelopmentOnly.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.Publish.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.Compiler.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.Icon.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.ApiReference.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.Assets.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.ShaderTools.targets" />

</Project>
