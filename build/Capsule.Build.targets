<Project>

  <!-- How a Capsule game builds. This file holds the mode switches and the generator, and imports every
       other concern from its own file. A package consumer gets it as buildTransitive/JAG.Capsule.targets.
       Every project referencing JAG.Capsule imports it, whatever it is. Capsule.Build.props imports it
       for a source consumer. The pipeline, the generator, the shell's shape and its publish answer to a
       role. What a role-free library, test or tool receives is marked universal where it is set. -->

  <!-- The mode switches. The files below read them at evaluation. -->
  <PropertyGroup>
    <!-- The build's shape: true for a publish, false for every other build. _IsPublishing flows
         through project references, and CapsuleShipping stays directly testable. -->
    <CapsuleShipping Condition="'$(CapsuleShipping)' == ''">$(_IsPublishing)</CapsuleShipping>
    <CapsuleShipping Condition="'$(CapsuleShipping)' == ''">false</CapsuleShipping>

    <!-- The asset pipeline. A project that sets it reads the authoring tree and ships what it
         derives. The logic role sets it, and a role-free test or tool may. -->
    <CapsuleBuildAssets Condition="'$(CapsuleBuildAssets)' == '' and '$(CapsuleGameLogic)' == 'true'">true</CapsuleBuildAssets>
  </PropertyGroup>

  <!-- A role's JSON goes through the generated contexts only, which is what a NativeAOT publish
       runs. A role-free library keeps the SDK's default. -->
  <PropertyGroup Condition="'$(CapsuleGameLogic)' == 'true' or '$(CapsuleGameShell)' == 'true'">
    <JsonSerializerIsReflectionEnabledByDefault Condition="'$(JsonSerializerIsReflectionEnabledByDefault)' == ''">false</JsonSerializerIsReflectionEnabledByDefault>
  </PropertyGroup>

  <!-- The switches come first because Capsule.Publish.targets reads CapsuleShipping at evaluation.
       Targets hooked to the same point run in import order, and this list keeps the order they have
       always run in. -->
  <Import Project="$(MSBuildThisFileDirectory)Capsule.SourceConsumer.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.DevelopmentOnly.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.Publish.targets" />

  <!-- The generators and analyzers: the project in an engine clone, the packed assembly in the
       package, which keeps it out of analyzers/ so only a role receives it.
       No GlobalPropertiesToRemove. The generator project pins the publish properties with
       TreatAsLocalProperty, and removing them here would request it under a second global-property
       set. Two builds would then race into one output. -->
  <ItemGroup Condition="'$(CapsuleGameLogic)' == 'true' or '$(CapsuleGameShell)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Capsule.Generators/Capsule.Generators.csproj"
                      Condition="Exists('$(MSBuildThisFileDirectory)../src/Capsule.Generators/Capsule.Generators.csproj')"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <Analyzer Include="$(MSBuildThisFileDirectory)../tools/generators/Capsule.Generators.dll"
              Condition="Exists('$(MSBuildThisFileDirectory)../tools/generators/Capsule.Generators.dll')" />

    <CompilerVisibleProperty Include="CapsuleGameLogic" />
    <CompilerVisibleProperty Include="CapsuleGameShell" />
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>

  <Import Project="$(MSBuildThisFileDirectory)Capsule.Executable.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.ApiReference.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.Assets.targets" />
  <Import Project="$(MSBuildThisFileDirectory)Capsule.ShaderTools.targets" />

</Project>
