<Project>

  <!-- What the shell's executable carries: its icons and its application manifest. Everything here
       answers to the shell role. -->
  <PropertyGroup Condition="'$(CapsuleGameShell)' == 'true'">
    <_CapsuleGameManifest>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'app.manifest'))</_CapsuleGameManifest>
    <!-- Defaults are beside the imported hooks in source and package modes. -->
    <_CapsuleDefaultIcon>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'Icon.ico'))</_CapsuleDefaultIcon>
    <_CapsuleDefaultWindowIcon>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'Icon.bmp'))</_CapsuleDefaultWindowIcon>
    <_CapsuleDefaultManifest>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'app.manifest'))</_CapsuleDefaultManifest>

    <!-- CapsuleApplicationIcon replaces the default with the icon a reference derived. -->
    <ApplicationIcon Condition="'$(ApplicationIcon)' == ''">$(_CapsuleDefaultIcon)</ApplicationIcon>

    <!-- The compiler's own default declares no display awareness. Windows stretches a window it draws. -->
    <ApplicationManifest Condition="'$(ApplicationManifest)' == '' and Exists('$(_CapsuleGameManifest)')">$(_CapsuleGameManifest)</ApplicationManifest>
    <ApplicationManifest Condition="'$(ApplicationManifest)' == ''">$(_CapsuleDefaultManifest)</ApplicationManifest>
  </PropertyGroup>

  <!-- The icon pair the logic library's build derived from its Icon.png, else Capsule's defaults. The
       references are asked under the global properties ResolveProjectReferences built them with. The
       call then reuses those builds and builds nothing again. -->
  <Target Name="CapsuleApplicationIcon"
          Condition="'$(CapsuleGameShell)' == 'true'"
          DependsOnTargets="ResolveProjectReferences"
          BeforeTargets="AssignTargetPaths;BeforeCompile;CoreCompile">

    <MSBuild Projects="@(_MSBuildProjectReferenceExistent)"
             Targets="CapsuleGetApplicationIcon"
             BuildInParallel="$(BuildInParallel)"
             Properties="%(_MSBuildProjectReferenceExistent.SetConfiguration); %(_MSBuildProjectReferenceExistent.SetPlatform); %(_MSBuildProjectReferenceExistent.SetTargetFramework)"
             RemoveProperties="%(_MSBuildProjectReferenceExistent.GlobalPropertiesToRemove)$(_GlobalPropertiesToRemoveFromProjectReferences)"
             SkipNonexistentTargets="true"
             Condition="'@(_MSBuildProjectReferenceExistent)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_CapsuleDerivedIcon" />
    </MSBuild>

    <ItemGroup>
      <_CapsuleIconSupplier Include="@(_CapsuleDerivedIcon->'%(MSBuildSourceProjectFile)'->Distinct())" />
    </ItemGroup>
    <Error Condition="'@(_CapsuleIconSupplier->Count())' &gt; '1'"
           Text="Capsule: this shell's references @(_CapsuleIconSupplier, ' and ') each derive an application icon from an Icon.png. Keep the Icon.png of the game's logic library alone." />

    <!-- A project's own ApplicationIcon stands. -->
    <PropertyGroup Condition="'$(ApplicationIcon)' == '$(_CapsuleDefaultIcon)'">
      <ApplicationIcon Condition="'@(_CapsuleDerivedIcon->WithMetadataValue('CapsuleIcon', 'Executable'))' != ''">@(_CapsuleDerivedIcon->WithMetadataValue('CapsuleIcon', 'Executable'))</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <_CapsuleWindowIcon Include="@(_CapsuleDerivedIcon->WithMetadataValue('CapsuleIcon', 'Window'))" />
      <_CapsuleWindowIcon Include="$(_CapsuleDefaultWindowIcon)" Condition="'@(_CapsuleWindowIcon)' == ''" />
      <!-- The host reads the window icon by the literal logical name Icon.bmp. -->
      <EmbeddedResource Include="@(_CapsuleWindowIcon)"
                        LogicalName="Icon.bmp"
                        Visible="false" />
    </ItemGroup>
  </Target>

</Project>
