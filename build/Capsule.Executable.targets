<Project>

  <!-- What the shell's executable carries: its icons and its application manifest. Everything here
       answers to the shell role. -->
  <PropertyGroup Condition="'$(CapsuleGameShell)' == 'true'">
    <_CapsuleGameIcon>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'Icon.ico'))</_CapsuleGameIcon>
    <_CapsuleGameWindowIcon>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'Icon.bmp'))</_CapsuleGameWindowIcon>
    <_CapsuleGameManifest>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'app.manifest'))</_CapsuleGameManifest>
    <!-- Defaults are beside the imported hooks in source and package modes. -->
    <_CapsuleDefaultIcon>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'Icon.ico'))</_CapsuleDefaultIcon>
    <_CapsuleDefaultWindowIcon>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'Icon.bmp'))</_CapsuleDefaultWindowIcon>
    <_CapsuleDefaultManifest>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', 'app.manifest'))</_CapsuleDefaultManifest>

    <ApplicationIcon Condition="'$(ApplicationIcon)' == '' and Exists('$(_CapsuleGameIcon)')">$(_CapsuleGameIcon)</ApplicationIcon>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == ''">$(_CapsuleDefaultIcon)</ApplicationIcon>

    <!-- The compiler's own default declares no display awareness. Windows stretches a window it draws. -->
    <ApplicationManifest Condition="'$(ApplicationManifest)' == '' and Exists('$(_CapsuleGameManifest)')">$(_CapsuleGameManifest)</ApplicationManifest>
    <ApplicationManifest Condition="'$(ApplicationManifest)' == ''">$(_CapsuleDefaultManifest)</ApplicationManifest>
  </PropertyGroup>

  <Target Name="CapsuleIconInit"
          Condition="'$(CapsuleGameShell)' == 'true'"
          BeforeTargets="AssignTargetPaths">

    <!-- Read after the consumer's Directory.Build.targets has declared resources. -->
    <PropertyGroup>
      <_CapsuleGameDeclaredWindowIcon Condition="'@(EmbeddedResource->WithMetadataValue('LogicalName', 'Icon.bmp'))' != ''">true</_CapsuleGameDeclaredWindowIcon>
    </PropertyGroup>

    <ItemGroup Condition="'$(_CapsuleGameDeclaredWindowIcon)' != 'true'">
      <!-- The backend requires the literal logical name Icon.bmp. -->
      <EmbeddedResource Include="$(_CapsuleGameWindowIcon)"
                        LogicalName="Icon.bmp"
                        Visible="false"
                        Condition="Exists('$(_CapsuleGameWindowIcon)')" />
      <EmbeddedResource Include="$(_CapsuleDefaultWindowIcon)"
                        LogicalName="Icon.bmp"
                        Visible="false"
                        Condition="!Exists('$(_CapsuleGameWindowIcon)')" />
    </ItemGroup>

    <Warning Condition="Exists('$(_CapsuleGameIcon)') and !Exists('$(_CapsuleGameWindowIcon)') and '$(_CapsuleGameDeclaredWindowIcon)' != 'true'"
             Text="Capsule: this shell has an Icon.ico but no Icon.bmp. Its window and taskbar keep Capsule's default icon. Add a 128x128 32-bit uncompressed Icon.bmp beside the project, or remove Icon.ico to take both defaults." />
    <Warning Condition="!Exists('$(_CapsuleGameIcon)') and Exists('$(_CapsuleGameWindowIcon)') and '$(ApplicationIcon)' == '$(_CapsuleDefaultIcon)'"
             Text="Capsule: this shell has an Icon.bmp but no Icon.ico. Its executable keeps Capsule's default icon. Add an Icon.ico beside the project, or remove Icon.bmp to take both defaults." />
  </Target>

</Project>
