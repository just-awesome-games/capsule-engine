<Project>

  <!-- The key pass. A key is the authored path normalized segment by segment, which is a C# rule
       shared with the generators, so nothing here derives one: every authored path goes out to the
       build tool and every name the later hooks need comes back in $(CapsuleKeysDir), each file
       holding the exact strings one hook reads. -->

  <Target Name="CapsuleKeyRequests"
          Condition="'$(CapsuleReadsAssetSources)' == 'true'"
          DependsOnTargets="CapsuleAssetsInit;CapsuleCollectSceneDocuments;CapsuleCollectSheetDocuments;CapsuleResolveBuildTool">

    <!-- Configuration is settled only when this target runs. -->
    <PropertyGroup>
      <CapsuleObjDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'capsule'))</CapsuleObjDir>
      <CapsuleKeysDir>$(CapsuleObjDir)/keys</CapsuleKeysDir>
      <CapsuleKeyRequestFile>$(CapsuleObjDir)/key-requests.txt</CapsuleKeyRequestFile>
      <CapsuleKeyProjectDir>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</CapsuleKeyProjectDir>
      <CapsuleSceneDocumentsOutDir>$(CapsuleObjDir)/scenes</CapsuleSceneDocumentsOutDir>
      <CapsuleSceneDocumentsDerivedDir>$(CapsuleSceneDocumentsOutDir)/</CapsuleSceneDocumentsDerivedDir>
    </PropertyGroup>

    <Error Condition="'$(CapsuleUsesBuildTool)' == 'true' and '$(CapsuleBuildToolProject)' == '' and '$(CapsuleBuildToolAssembly)' == ''"
           Text="Capsule: the build tool is unavailable, so no asset can be keyed. Reference the Capsule.Build package, or import build/Capsule.Build.targets from a Capsule source clone." />

    <!-- Qualify metadata to avoid evaluating it on incompatible items. -->
    <ItemGroup>
      <_CapsuleAssetRequest Include="@(CapsuleAsset)"
                            Condition="'@(CapsuleAsset)' != ''">
        <Relative>$([MSBuild]::MakeRelative($(CapsuleKeyProjectDir), %(CapsuleAsset.FullPath)))</Relative>
      </_CapsuleAssetRequest>

      <_CapsuleSceneRequest Include="@(CapsuleNativeScene)"
                            Condition="'@(CapsuleNativeScene)' != ''">
        <RawKey>$([System.String]::Copy('%(CapsuleNativeScene.CapsuleDocumentDir)').Replace('\', '/'))$([System.IO.Path]::GetFileNameWithoutExtension('%(CapsuleNativeScene.Filename)'))</RawKey>
        <Relative>$([MSBuild]::MakeRelative($(CapsuleKeyProjectDir), %(CapsuleNativeScene.FullPath)))</Relative>
      </_CapsuleSceneRequest>
      <_CapsuleSceneRequest Include="@(CapsuleSceneDocument)"
                            Condition="'@(CapsuleSceneDocument)' != ''">
        <RawKey Condition="'%(CapsuleSceneDocument.CapsuleDocumentKey)' != ''">%(CapsuleSceneDocument.CapsuleDocumentKey)</RawKey>
        <RawKey Condition="'%(CapsuleSceneDocument.CapsuleDocumentKey)' == ''">$([System.IO.Path]::GetFileNameWithoutExtension('%(CapsuleSceneDocument.Filename)'))</RawKey>
        <Relative>$([MSBuild]::MakeRelative($(CapsuleKeyProjectDir), %(CapsuleSceneDocument.FullPath)))</Relative>
      </_CapsuleSceneRequest>

      <_CapsuleSheetRequest Include="@(CapsuleNativeSheet)"
                            Condition="'@(CapsuleNativeSheet)' != ''">
        <RawKey>$([System.String]::Copy('%(CapsuleNativeSheet.CapsuleDocumentDir)').Replace('\', '/'))$([System.IO.Path]::GetFileNameWithoutExtension('%(CapsuleNativeSheet.Filename)'))</RawKey>
        <Relative>$([MSBuild]::MakeRelative($(CapsuleKeyProjectDir), %(CapsuleNativeSheet.FullPath)))</Relative>
      </_CapsuleSheetRequest>
      <_CapsuleSheetRequest Include="@(CapsuleSheetDocument)"
                            Condition="'@(CapsuleSheetDocument)' != ''">
        <RawKey Condition="'%(CapsuleSheetDocument.CapsuleDocumentKey)' != ''">%(CapsuleSheetDocument.CapsuleDocumentKey)</RawKey>
        <RawKey Condition="'%(CapsuleSheetDocument.CapsuleDocumentKey)' == ''">$([System.IO.Path]::GetFileNameWithoutExtension('%(CapsuleSheetDocument.Filename)'))</RawKey>
        <Relative>$([MSBuild]::MakeRelative($(CapsuleKeyProjectDir), %(CapsuleSheetDocument.FullPath)))</Relative>
      </_CapsuleSheetRequest>
    </ItemGroup>

    <MakeDir Directories="$(CapsuleObjDir)" />

    <!-- Rewritten only when the authored set changes, so it is the incremental input of the pass. -->
    <WriteLinesToFile File="$(CapsuleKeyRequestFile)"
                      Lines="@(_CapsuleAssetRequest->'%(CapsuleAssetDomain)|%(CapsuleAssetPath)|%(Extension)|%(Relative)');@(_CapsuleSceneRequest->'scenes|%(RawKey)||%(Relative)');@(_CapsuleSheetRequest->'sprites|%(RawKey)||%(Relative)')"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <Target Name="CapsuleDeriveKeys"
          Condition="'$(CapsuleReadsAssetSources)' == 'true'"
          DependsOnTargets="CapsuleKeyRequests;ResolveProjectReferences"
          Inputs="$(CapsuleKeyRequestFile);@(_CapsuleBuildTool);@(_CapsuleBuildToolAssembly)"
          Outputs="$(CapsuleKeysDir)/shipped-assets.txt;$(CapsuleKeysDir)/textures.txt;$(CapsuleKeysDir)/audio.txt;$(CapsuleKeysDir)/scenes.txt;$(CapsuleKeysDir)/sprites.txt;$(CapsuleKeysDir)/scene-content.txt">

    <Error Condition="!Exists('@(_CapsuleBuildTool)')"
           Text="Capsule: the build tool was not built (expected '@(_CapsuleBuildTool)')." />

    <Exec Command="&quot;$(CapsuleDotNetHost)&quot; &quot;@(_CapsuleBuildTool)&quot; --keys-from &quot;$(CapsuleKeyRequestFile)&quot; --keys-to &quot;$(CapsuleKeysDir)&quot; --scenes-out &quot;$(CapsuleSceneDocumentsDerivedDir)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          LogStandardErrorAsError="true"
          StandardOutputImportance="normal" />
  </Target>

  <!-- Runs on up-to-date builds too: the later hooks read their items from here, never from a
       target the pass itself skipped. -->
  <Target Name="CapsuleReadKeys"
          Condition="'$(CapsuleReadsAssetSources)' == 'true'"
          DependsOnTargets="CapsuleDeriveKeys">

    <ReadLinesFromFile File="$(CapsuleKeysDir)/shipped-assets.txt" Condition="Exists('$(CapsuleKeysDir)/shipped-assets.txt')">
      <Output TaskParameter="Lines" ItemName="_CapsuleShippedAssetLine" />
    </ReadLinesFromFile>

    <ReadLinesFromFile File="$(CapsuleKeysDir)/scene-content.txt" Condition="Exists('$(CapsuleKeysDir)/scene-content.txt')">
      <Output TaskParameter="Lines" ItemName="_CapsuleSceneContentLine" />
    </ReadLinesFromFile>

    <!-- Each line is the shipped path, a '|', and the file it comes from; splitting a manifest line
         is not deriving a key. -->
    <ItemGroup>
      <_CapsuleShippedAsset Condition="'@(_CapsuleShippedAssetLine)' != ''"
                            Include="$([System.String]::Copy('%(_CapsuleShippedAssetLine.Identity)').Substring($([MSBuild]::Add(1, $([System.String]::Copy('%(_CapsuleShippedAssetLine.Identity)').IndexOf('|'))))))">
        <ShippedPath>$([System.String]::Copy('%(_CapsuleShippedAssetLine.Identity)').Substring(0, $([System.String]::Copy('%(_CapsuleShippedAssetLine.Identity)').IndexOf('|'))))</ShippedPath>
      </_CapsuleShippedAsset>

      <_CapsuleDerivedScene Condition="'@(_CapsuleSceneContentLine)' != ''"
                            Include="$([System.String]::Copy('%(_CapsuleSceneContentLine.Identity)').Substring($([MSBuild]::Add(1, $([System.String]::Copy('%(_CapsuleSceneContentLine.Identity)').IndexOf('|'))))))">
        <ShippedPath>$([System.String]::Copy('%(_CapsuleSceneContentLine.Identity)').Substring(0, $([System.String]::Copy('%(_CapsuleSceneContentLine.Identity)').IndexOf('|'))))</ShippedPath>
      </_CapsuleDerivedScene>
    </ItemGroup>
  </Target>

</Project>
