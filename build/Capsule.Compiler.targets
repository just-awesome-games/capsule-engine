<Project>

  <!-- Loads Capsule's compiler plug-ins (registry generators and game-boundary analyzer, one assembly)
       into any project declaring a Capsule role. A project declares CapsuleGameLogic or CapsuleGameShell
       once; every generator and analyzer arrives through here. The Exists() condition selects the source
       clone; a package consumer receives the same assembly from analyzers/dotnet/cs/ without this reference.
       Paths use forward slashes for Linux. -->

  <ItemGroup Condition="'$(CapsuleGameLogic)' == 'true' or '$(CapsuleGameShell)' == 'true'">
    <!-- The generator rides the game's own restore and build graph, the way the scene importer
         does. An analyzer is loaded by the compiler and never shipped, so nothing here reaches
         the game's output or its publish set. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Capsule.Generators/Capsule.Generators.csproj"
                      Condition="Exists('$(MSBuildThisFileDirectory)../src/Capsule.Generators/Capsule.Generators.csproj')"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"
                      PrivateAssets="all" />

    <!-- The generator reads the declared role for itself; these conditions only decide whether it
         is loaded at all. -->
    <CompilerVisibleProperty Include="CapsuleGameLogic" />
    <CompilerVisibleProperty Include="CapsuleGameShell" />

    <!-- The root a type's namespace is measured against when it claims its registry key. -->
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>

</Project>
