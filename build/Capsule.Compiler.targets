<Project>

  <!-- Loads Capsule's compiler plug-ins (registry generators and game-boundary analyzer, one
       assembly) into any project declaring a Capsule role. The Exists() condition selects the source
       clone; a package consumer receives the same assembly from analyzers/dotnet/cs/. -->

  <ItemGroup Condition="'$(CapsuleGameLogic)' == 'true' or '$(CapsuleGameShell)' == 'true'">
    <!-- The generator rides the game's own restore and build graph. An analyzer is loaded by the
         compiler and never shipped, so nothing here reaches the game's output. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Capsule.Generators/Capsule.Generators.csproj"
                      Condition="Exists('$(MSBuildThisFileDirectory)../src/Capsule.Generators/Capsule.Generators.csproj')"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"
                      PrivateAssets="all" />

    <!-- The generator reads the declared role for itself; this only decides whether it loads. -->
    <CompilerVisibleProperty Include="CapsuleGameLogic" />
    <CompilerVisibleProperty Include="CapsuleGameShell" />

    <!-- The root a type's namespace is measured against when it claims its registry key. -->
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>

</Project>
