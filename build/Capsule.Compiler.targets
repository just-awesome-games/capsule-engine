<Project>

  <ItemGroup Condition="'$(CapsuleGameLogic)' == 'true' or '$(CapsuleGameShell)' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)../src/Capsule.Generators/Capsule.Generators.csproj"
                      Condition="Exists('$(MSBuildThisFileDirectory)../src/Capsule.Generators/Capsule.Generators.csproj')"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishAot;PublishTrimmed;RuntimeIdentifier;SelfContained"
                      PrivateAssets="all" />

    <CompilerVisibleProperty Include="CapsuleGameLogic" />
    <CompilerVisibleProperty Include="CapsuleGameShell" />
    <CompilerVisibleProperty Include="RootNamespace" />
  </ItemGroup>

</Project>
