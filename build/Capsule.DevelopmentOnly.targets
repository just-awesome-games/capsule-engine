<Project>

  <!-- What CapsuleShipping switches in the compile: the development symbol, the runtime switch, and
       every source under a directory holding a .capsuleignore. The build tool drops development-only
       assets itself, from the manifest's shipping record. Universal: development code in a library
       built on Capsule compiles out of a game's publish as the game's own does. -->

  <!-- The compile symbol Capsule's [Conditional] development calls answer to. Defined for every
       ordinary build and absent from a publish, where those calls and their arguments compile out. -->
  <PropertyGroup Condition="'$(CapsuleShipping)' != 'true'">
    <DefineConstants>$(DefineConstants);CAPSULE_DEVELOPMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(CapsuleShipping)' == 'true'">
    <RuntimeHostConfigurationOption Include="Capsule.Development" Value="false" Trim="true" />

    <!-- Resolve source markers to absolute directories for compile-item comparison. -->
    <_CapsuleSourceMarker Include="**/.capsuleignore" Exclude="$(DefaultItemExcludes)" />
    <_CapsuleDevelopmentOnlySourceDir Include="@(_CapsuleSourceMarker->'%(RootDir)%(Directory)')" />
  </ItemGroup>

  <!-- Paths compare under MSBuild's own rule for the host: ordinal on Linux, where its paths are
       case-sensitive, and case-folded on Windows and macOS. -->
  <PropertyGroup>
    <_CapsulePathComparison>System.StringComparison.OrdinalIgnoreCase</_CapsulePathComparison>
    <_CapsulePathComparison Condition="$([MSBuild]::IsOSPlatform('Linux'))">System.StringComparison.Ordinal</_CapsulePathComparison>
  </PropertyGroup>

  <!-- Removes the Compile items under each marked directory, one directory per batch. It runs after
       compile items exist but before the dependency cache. A design-time build reaches CoreCompile.
       The items stay in MSBuild because only MSBuild can remove a compile item. -->
  <Target Name="CapsuleRemoveDevelopmentOnlySources"
          Condition="'$(CapsuleShipping)' == 'true' and '@(_CapsuleDevelopmentOnlySourceDir)' != ''"
          Outputs="%(_CapsuleDevelopmentOnlySourceDir.Identity)"
          BeforeTargets="_GenerateCompileDependencyCache;CoreCompile">
    <!-- A property avoids cross-batching directory metadata with Compile. -->
    <PropertyGroup>
      <_CapsuleDevelopmentOnlyDirectory>$([System.String]::Copy('%(_CapsuleDevelopmentOnlySourceDir.Identity)').Replace('\', '/'))</_CapsuleDevelopmentOnlyDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_CapsuleDevelopmentOnlyCompile Include="@(Compile)"
                                      Condition="$([System.String]::Copy('%(Compile.FullPath)').Replace('\', '/').StartsWith('$(_CapsuleDevelopmentOnlyDirectory)', $(_CapsulePathComparison)))" />
      <Compile Remove="@(_CapsuleDevelopmentOnlyCompile)" />
    </ItemGroup>
  </Target>

</Project>
