<Project>

  <!-- A directory holding a file named .capsuleignore is development-only: everything under it is
       part of every ordinary build, Debug and Release alike, so a Release measurement can run a
       driver, and part of no publish. Input drivers are the case it exists for — they live in the
       game's logic project to reach the scene, and must not ship.

       One marker, both planes: sources under a marked directory leave the compile, and authoring
       sources under one leave the asset plane, so a shipped build holds neither the code nor the
       files that code would have named.

       The two planes carry the marked set in different spellings on purpose. The asset hooks match
       with Exclude, which compares an item's spec as written, and every spec they write is
       absolute already. The compile carries whatever spelling the consumer wrote — the SDK's
       relative glob, or an absolute Include of its own — so the source plane compares resolved
       locations instead of specs. -->

  <PropertyGroup>
    <!-- _IsPublishing is the SDK's own global property for the duration of dotnet publish, so a
         publish excludes marked directories with no wiring, and a project reference built under one
         inherits it. Overridable because verifying what a publish will hold must not require
         running one. -->
    <CapsuleShipping Condition="'$(CapsuleShipping)' == ''">$(_IsPublishing)</CapsuleShipping>
    <CapsuleShipping Condition="'$(CapsuleShipping)' == ''">false</CapsuleShipping>
  </PropertyGroup>

  <ItemGroup Condition="'$(CapsuleShipping)' == 'true'">
    <!-- Markers in the consuming project's own tree, carried as the directories holding them.
         The glob is relative to the project, which is what DefaultItemExcludes is written
         against; %(RootDir)%(Directory) resolves each hit to the absolute directory the removal
         below compares against. -->
    <_CapsuleSourceMarker Include="**/.capsuleignore" Exclude="$(DefaultItemExcludes)" />
    <_CapsuleDevelopmentOnlySourceDir Include="@(_CapsuleSourceMarker->'%(RootDir)%(Directory)')" />

    <!-- Markers in the authoring plane, which normally sits beside the project rather than under
         it. Skipped when there is no plane, since a wildcard under a missing root is only cost. -->
    <_CapsuleAssetMarker Include="$(CapsuleAssetSourcesDir)/**/.capsuleignore"
                         Condition="'$(CapsuleReadsAssetSources)' == 'true' and Exists('$(CapsuleAssetSourcesDir)')" />
    <_CapsuleDevelopmentOnly Include="@(_CapsuleAssetMarker->'%(RootDir)%(Directory)**/*')" />
  </ItemGroup>

  <!-- Before the compile's dependency cache rather than at evaluation: the SDK's default glob, the
       project's own additions to it and any other hook's are all in by then. It must be before that
       cache and not merely before CoreCompile, or the hash of the unfiltered list would let a build
       that only toggled CapsuleShipping skip the compile and reuse the other direction's assembly.
       CoreCompile stays named because a design-time build reaches it without the cache target.

       The generators read the compilation this leaves, so a shipped build's driver, entity and
       scene registries hold nothing a marked directory declared.

       Batched over the marked directories: each pass drops the compile items resolving under one.
       Comparison is on %(FullPath), lowercased with separators normalised, so a relative spec, an
       absolute one and a mixture of the two all match the file they name. -->
  <Target Name="CapsuleRemoveDevelopmentOnlySources"
          Condition="'$(CapsuleShipping)' == 'true' and '@(_CapsuleDevelopmentOnlySourceDir)' != ''"
          Outputs="%(_CapsuleDevelopmentOnlySourceDir.Identity)"
          BeforeTargets="_GenerateCompileDependencyCache;CoreCompile">
    <!-- Through a property: a metadata reference inside the item condition below would batch it
         over this list as well as over Compile. -->
    <PropertyGroup>
      <_CapsuleDevelopmentOnlyDirectory>$([System.String]::Copy('%(_CapsuleDevelopmentOnlySourceDir.Identity)').Replace('\', '/').ToLowerInvariant())</_CapsuleDevelopmentOnlyDirectory>
    </PropertyGroup>

    <ItemGroup Condition="'$(_CapsuleDevelopmentOnlyDirectory)' != ''">
      <_CapsuleDevelopmentOnlyCompile Include="@(Compile)"
                                      Condition="$([System.String]::Copy('%(Compile.FullPath)').Replace('\', '/').ToLowerInvariant().StartsWith('$(_CapsuleDevelopmentOnlyDirectory)'))" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="@(_CapsuleDevelopmentOnlyCompile)" />
    </ItemGroup>
  </Target>

</Project>
