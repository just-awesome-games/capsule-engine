Capsule's fix for SDL 3.4.18's Direct3D 12 frame latency. The window's fences cycled by the swapchain's
texture count, never below two, and let a second frame into flight when the device allowed one. The
swapchain had no frame latency waitable object, and DXGI queued up to three presents ahead of the
display. The fences now cycle by the frames in flight, the swapchain holds at most that many presents,
and each frame waits for room before it acquires its texture. Drop it once SDL releases a fix.

diff --git a/src/gpu/d3d12/SDL_gpu_d3d12.c b/src/gpu/d3d12/SDL_gpu_d3d12.c
--- a/src/gpu/d3d12/SDL_gpu_d3d12.c
+++ b/src/gpu/d3d12/SDL_gpu_d3d12.c
@@ -844,6 +844,10 @@ typedef struct D3D12WindowData
     D3D12XBOX_FRAME_PIPELINE_TOKEN frameToken;
 #else
     IDXGISwapChain3 *swapchain;
+    // Signalled while the present queue holds fewer frames than the device allows in flight. Waited on
+    // once a frame, before the frame acquires its swapchain texture.
+    HANDLE frameLatencyWaitable;
+    bool frameLatencyWaited;
 #endif
     SDL_GPUPresentMode present_mode;
     SDL_GPUSwapchainComposition swapchainComposition;
@@ -6983,7 +6987,7 @@ static bool D3D12_INTERNAL_ResizeSwapchain(
         0, // use client window width
         0, // use client window height
         DXGI_FORMAT_UNKNOWN, // Keep the old format
-        renderer->supportsTearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0);
+        DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT | (renderer->supportsTearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0));
     CHECK_D3D12_ERROR_AND_RETURN("Could not resize swapchain buffers", false);
 
     // Create texture object for the swapchain
@@ -7025,6 +7029,8 @@ static void D3D12_INTERNAL_DestroySwapchain(
         SDL_free(windowData->textureContainers[i].textures);
     }
 
+    CloseHandle(windowData->frameLatencyWaitable);
+    windowData->frameLatencyWaitable = NULL;
     IDXGISwapChain_Release(windowData->swapchain);
     windowData->swapchain = NULL;
 }
@@ -7077,10 +7083,11 @@ static bool D3D12_INTERNAL_CreateSwapchain(
     fullscreenDesc.Scaling = DXGI_MODE_SCALING_UNSPECIFIED;
     fullscreenDesc.Windowed = true;
 
+    // Without a waitable object DXGI queues up to three presents, each a refresh of latency, whatever
+    // the device's frames in flight.
+    swapchainDesc.Flags = DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT;
