+// Waits once a frame for the present queue to have room, or only checks when block is false. Returns
+// whether the frame may go on. A wait that times out lets the frame go on rather than hang it.
+static bool D3D12_INTERNAL_WaitForFrameLatency(
+    D3D12WindowData *windowData,
+    bool block)
+{
+#if (defined(SDL_PLATFORM_XBOXONE) || defined(SDL_PLATFORM_XBOXSERIES))
+    return true;
+#else
+    if (windowData->frameLatencyWaited || windowData->frameLatencyWaitable == NULL) {
+        return true;
+    }
+
+    DWORD waited = WaitForSingleObjectEx(windowData->frameLatencyWaitable, block ? 1000 : 0, TRUE);
+    if (waited == WAIT_OBJECT_0 || block) {
+        windowData->frameLatencyWaited = true;
+        return true;
+    }
+
+    return false;
+#endif
+}
+
 static bool D3D12_WaitForSwapchain(
     SDL_GPURenderer *driverData,
     SDL_Window *window)
