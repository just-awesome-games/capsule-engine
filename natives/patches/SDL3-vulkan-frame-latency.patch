+// Acquires the next vsync image before the frame begins, and blocks until the display lets it go. A
+// frame that began first sampled its input a refresh before its GPU work could start, since the GPU
+// waited on that image. Acquiring later leaves the device to signal the image's semaphore as before.
+static void VULKAN_INTERNAL_AcquireAhead(
+    VulkanRenderer *renderer,
+    WindowData *windowData)
+{
+    if (windowData->imageAcquired ||
+        windowData->presentMode != SDL_GPU_PRESENTMODE_VSYNC ||
+        windowData->swapchain == VK_NULL_HANDLE ||
+        windowData->needsSwapchainRecreate ||
+        windowData->needsSurfaceRecreate ||
+        (windowData->window->flags & SDL_WINDOW_HIDDEN)) {
+        return;
+    }
+
+    if (windowData->acquireFence == VK_NULL_HANDLE) {
+        VkFenceCreateInfo fenceCreateInfo;
+        fenceCreateInfo.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+        fenceCreateInfo.pNext = NULL;
+        fenceCreateInfo.flags = 0;
+        if (renderer->vkCreateFence(renderer->logicalDevice, &fenceCreateInfo, NULL, &windowData->acquireFence) != VK_SUCCESS) {
+            windowData->acquireFence = VK_NULL_HANDLE;
+            return;
+        }
+    } else {
+        renderer->vkResetFences(renderer->logicalDevice, 1, &windowData->acquireFence);
+    }
+
+    Uint32 imageIndex;
+    VkResult result = renderer->vkAcquireNextImageKHR(
+        renderer->logicalDevice,
+        windowData->swapchain,
+        SDL_MAX_UINT64,
+        windowData->imageAvailableSemaphore[windowData->frameCounter],
+        windowData->acquireFence,
+        &imageIndex);
+
+    if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR) {
+        renderer->vkWaitForFences(renderer->logicalDevice, 1, &windowData->acquireFence, VK_TRUE, SDL_MAX_UINT64);
+        windowData->acquiredImageIndex = imageIndex;
+        windowData->imageAcquired = true;
+    } else if (result == VK_ERROR_SURFACE_LOST_KHR) {
+        windowData->needsSurfaceRecreate = true;
+        windowData->needsSwapchainRecreate = true;
+    } else if (result == VK_ERROR_OUT_OF_DATE_KHR) {
+        windowData->needsSwapchainRecreate = true;
+    }
+}
+
 static bool VULKAN_WaitForSwapchain(
     SDL_GPURenderer *driverData,
     SDL_Window *window)
@@ -10131,6 +10197,8 @@ static bool VULKAN_WaitForSwapchain(
         }
     }
 
+    VULKAN_INTERNAL_AcquireAhead(renderer, windowData);
+
     return true;
 }
 
