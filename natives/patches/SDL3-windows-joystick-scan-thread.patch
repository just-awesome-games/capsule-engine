+// Reads each connected HID game controller: all of a detect's device I/O, and none of SDL's joystick state.
+static BOOL CALLBACK EnumJoystickScanCallback(LPCDIDEVICEINSTANCE pDeviceInstance, LPVOID pContext)
+{
+    ScanContext *context = (ScanContext *)pContext;
+    SDL_DINPUT_Scan *scan = context->scan;
+    struct SDL_DINPUT_ScannedDevice *scanned;
+    LPDIRECTINPUTDEVICE8 device = NULL;
+    char *path = NULL;
+    Uint16 vendor = 0;
+    Uint16 product = 0;
+
+    // We are only supporting HID devices.
+    if (!(pDeviceInstance->dwDevType & DIDEVTYPE_HID) ||
+        FAILED(IDirectInput8_CreateDevice(context->dinput, &pDeviceInstance->guidInstance, &device, NULL))) {
+        return DIENUM_CONTINUE;
+    }
+
+    if (QueryDevicePath(device, &path) && QueryDeviceInfo(device, &vendor, &product)) {
+        if (scan->count == context->capacity) {
+            int capacity = context->capacity ? context->capacity * 2 : 4;
+            struct SDL_DINPUT_ScannedDevice *devices = (struct SDL_DINPUT_ScannedDevice *)SDL_realloc(scan->devices, capacity * sizeof(*devices));
+            if (devices) {
+                scan->devices = devices;
+                context->capacity = capacity;
+            }
+        }
+
+        if (scan->count < context->capacity) {
+            scanned = &scan->devices[scan->count++];
+            SDL_memcpy(&scanned->instance, pDeviceInstance, sizeof(DIDEVICEINSTANCE));
+            scanned->path = path;
+            scanned->vendor = vendor;
+            scanned->product = product;
+            scanned->name = QueryProductName(device);
+            path = NULL;
+        }
+    }
+
+    SDL_free(path);
+    IDirectInputDevice8_Release(device);
+
+    return DIENUM_CONTINUE; // get next device, please
