+// On the joystick thread. False when it has no DirectInput to scan with.
+bool SDL_DINPUT_ScanJoysticks(SDL_DINPUT_Scan *scan)
+{
+    if (!scanner) {
+        SDL_zerop(scan);
+        return false;
+    }
+
+    ScanWith(scanner, scan);
+    return true;
+}
