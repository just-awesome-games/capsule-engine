+// On the joystick thread, which has initialized COM: the DirectInput object its scans use, none while DirectInput is
+// off. The main thread sets dinput before it starts the thread, and releases it after the thread stops.
+void SDL_DINPUT_ScannerInit(void)
+{
+    HINSTANCE instance = GetModuleHandle(NULL);
+
+    if (!dinput || !instance || FAILED(CoCreateInstance(&CLSID_DirectInput8, NULL, CLSCTX_INPROC_SERVER, &IID_IDirectInput8, (LPVOID *)&scanner))) {
+        scanner = NULL;
+        return;
+    }
+
+    if (FAILED(IDirectInput8_Initialize(scanner, instance, DIRECTINPUT_VERSION))) {
+        IDirectInput8_Release(scanner);
+        scanner = NULL;
+    }
