<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDL3 for each runtime identifier a desktop shell publishes, which JAG.Capsule.Runtime.Desktop
       depends on. Until the host leaves the substrate it also carries sdl2-compat, the bridge the
       substrate loads as SDL2 and that forwards to SDL3. Version is SDL3's, and a fourth part counts
       repacks of the same SDL3. -->
  <PropertyGroup>
    <PackageId>JAG.Capsule.Native.SDL3</PackageId>
    <Version>3.4.18</Version>
    <Description>SDL3 for Windows, Linux and macOS, built by Capsule for its desktop host, and the sdl2-compat bridge the host's current graphics substrate loads as SDL2. A game never references it: JAG.Capsule.Runtime.Desktop does.</Description>
    <PackageLicenseExpression>Zlib</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <CapsuleRuntime Include="$(CapsuleRuntimes)" Folder="sdl3/runtimes/%(Identity)/native" />
    <None Include="$(CapsuleNatives)sdl3/**" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

</Project>
