<Project Sdk="Microsoft.NET.Sdk">

  <!-- A dev-time tool. No game references it, which is why every line of Tiled parsing lives
       here rather than in Capsule.Levels: a game runtime never links an authoring format. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Levels.Cli</RootNamespace>
    <AssemblyName>Capsule.Levels.Cli</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capsule.Levels\Capsule.Levels.csproj" />
  </ItemGroup>

</Project>
