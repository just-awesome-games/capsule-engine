<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>JAG.Capsule.Build</PackageId>
    <Description>Build integration, source generators, analyzers, and map tooling for Capsule games.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeCapsuleBuildAssets</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Capsule.Maps.Cli/Capsule.Maps.Cli.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../Capsule.Scenes.Generator/Capsule.Scenes.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <ProjectReference Include="../Capsule.Analyzers/Capsule.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../build/Capsule.Build.targets"
          Pack="true"
          PackagePath="buildTransitive/JAG.Capsule.Build.targets" />
    <None Include="../build/Capsule.Maps.targets"
          Pack="true"
          PackagePath="buildTransitive/" />
    <None Include="../build/Capsule.Assets.targets"
          Pack="true"
          PackagePath="buildTransitive/" />
    <None Include="../build/Capsule.Scenes.targets"
          Pack="true"
          PackagePath="buildTransitive/" />
    <None Include="../build/Capsule.Icon.targets"
          Pack="true"
          PackagePath="buildTransitive/" />
    <!-- Beside the targets that name them, so $(MSBuildThisFileDirectory) resolves to the same
         pair whether a game builds against the packages or an engine clone. -->
    <None Include="../build/Icon.ico"
          Pack="true"
          PackagePath="buildTransitive/" />
    <None Include="../build/Icon.bmp"
          Pack="true"
          PackagePath="buildTransitive/" />
    <None Include="../build/Capsule.Analyzers.targets"
          Pack="true"
          PackagePath="buildTransitive/"
          Condition="Exists('../build/Capsule.Analyzers.targets')" />
  </ItemGroup>

  <Target Name="IncludeCapsuleBuildAssets">
    <ItemGroup>
      <TfmSpecificPackageFile Include="../Capsule.Maps.Cli/bin/$(Configuration)/net10.0/*.dll"
                              PackagePath="tools/net10.0/any/" />
      <TfmSpecificPackageFile Include="../Capsule.Maps.Cli/bin/$(Configuration)/net10.0/*.json"
                              PackagePath="tools/net10.0/any/" />
      <TfmSpecificPackageFile Include="../Capsule.Scenes.Generator/bin/$(Configuration)/netstandard2.0/Capsule.Scenes.Generator.dll"
                              PackagePath="analyzers/dotnet/cs/" />
      <TfmSpecificPackageFile Include="../Capsule.Analyzers/bin/$(Configuration)/netstandard2.0/Capsule.Analyzers.dll"
                              PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>

</Project>
