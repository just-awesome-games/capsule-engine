<Project>

  <Import Project="../Directory.Build.props" />

  <PropertyGroup>
    <!-- Nothing here is a reference a consumer compiles against. It carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- The engine tree the fixture games import Capsule's build and projects from. -->
    <CapsuleSourceRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..'))</CapsuleSourceRoot>
  </PropertyGroup>

</Project>
