<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against. It carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- What Capsule's build defines for a development game build. The specs emit through the
         [Conditional] development calls the way a game does. -->
    <DefineConstants>$(DefineConstants);CAPSULE_DEVELOPMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The registry generator's specs host it the way the compiler does: over a compilation
         they build in memory. A diagnostic is asserted there without failing this build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The reference decoder VorbisDecodeTests checks the vendored one against. -->
    <PackageReference Include="NVorbis" Version="0.10.4" />
    <!-- The reference decoder SingleChannelPngTests checks the build's PNG reads against. The build
         tool and the runtime both keep it private, and it does not flow as a compile reference. -->
    <PackageReference Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Capsule.Build/Capsule.Build.csproj" />
    <ProjectReference Include="../../src/Capsule.Physics/Capsule.Physics.csproj" />
    <ProjectReference Include="../../src/Capsule.Core/Capsule.Core.csproj" />
    <ProjectReference Include="../../src/Capsule.Runtime.Desktop/Capsule.Runtime.Desktop.csproj" />
    <ProjectReference Include="../../src/Capsule.Scenes/Capsule.Scenes.csproj" />
    <!-- Referenced as an ordinary library, not as an analyzer: these specs drive the generator
         directly so that a rejected input is an assertion here rather than a broken build. -->
    <ProjectReference Include="../../src/Capsule.Generators/Capsule.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The shader tools ShaderBuildTests compiles through, named as the build targets name them. They
       arrive through JAG.Capsule, which the runtime references. The checkout holds what packaging, schema,
       shader and generator sample tests read. -->
  <Import Project="../../build/Capsule.ShaderTools.targets" />
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CapsuleCheckout</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '../..'))</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>CapsuleShaderTools</_Parameter1>
      <_Parameter2>$([MSBuild]::NormalizePath('$(NuGetPackageRoot)', 'jag.capsule.shadertools', '$(CapsuleShaderToolsVersion)'))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- loop.ogg is a copy of samples/MinimalGame's room.ogg, mono 44.1 kHz, 176 400 frames, in five
         pages. many-pages.ogg is stereo noise, 44.1 kHz, 88 200 frames, in 31 pages of uneven size:
         more pages than the decoder's page caches hold. -->
    <None Include="Audio/Fixtures/*.ogg" CopyToOutputDirectory="PreserveNewest" />
    <!-- alpha-ramp.png carries every alpha from 0 to 255 over six colours. hd-atlas.png is a copy
         of the bench's RGB atlas, the only colour type the shipped PNGs add. -->
    <None Include="Runtime/Fixtures/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
