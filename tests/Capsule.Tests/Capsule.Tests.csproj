<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- What Capsule's build defines for a development game build, so the specs can emit through
         the [Conditional] development calls the way a game does. -->
    <DefineConstants>$(DefineConstants);CAPSULE_DEVELOPMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- The registry generator's specs host it the way the compiler does: over a compilation
         they build in memory, so a diagnostic can be asserted without failing this build. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The reference decoder VorbisDecodeTests checks the vendored one against. MonoGame carries
         NVorbis as a runtime dependency only, so it does not flow as a compile reference here. -->
    <PackageReference Include="NVorbis" Version="0.10.4" />
  </ItemGroup>

  <!-- Referencing the runtime through its desktop module also makes this project a live probe
       of the MonoGame-hiding contract: these specs compile without any Microsoft.Xna reference
       being available. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Capsule.Build/Capsule.Build.csproj" />
    <ProjectReference Include="../../src/Capsule.Physics/Capsule.Physics.csproj" />
    <ProjectReference Include="../../src/Capsule.Core/Capsule.Core.csproj" />
    <ProjectReference Include="../../src/Capsule.Runtime.Desktop/Capsule.Runtime.Desktop.csproj" />
    <ProjectReference Include="../../src/Capsule.Scenes/Capsule.Scenes.csproj" />
    <!-- Referenced as an ordinary library, not as an analyzer: these specs drive the generator
         directly so that a rejected input is an assertion here rather than a broken build. -->
    <ProjectReference Include="../../src/Capsule.Generators/Capsule.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- A copy of samples/MinimalGame's room.ogg, mono 44.1 kHz, 176 400 frames; the fixture
         VorbisAllocationTests plays and loops. -->
    <None Include="Audio/Fixtures/loop.ogg" CopyToOutputDirectory="PreserveNewest" />
    <!-- alpha-ramp.png carries every alpha from 0 to 255 over six colours. hd-atlas.png is a copy
         of the bench's RGB atlas, the only colour type the shipped PNGs add. -->
    <None Include="Runtime/Fixtures/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
