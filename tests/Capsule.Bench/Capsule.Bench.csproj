<Project Sdk="Microsoft.NET.Sdk">

  <!-- The standing performance harness: a windowed game whose scenes are measured workloads, run
       by hand, never by CI or the hook beyond compiling. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Bench</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CapsuleGameShell>true</CapsuleGameShell>
    <!-- Every method is compiled optimised on first call, as a NativeAOT publish ships it: under
         tiering the first hundred-odd frames run tier-0 code and the warm-up drop would not cover
         them. -->
    <TieredCompilation>false</TieredCompilation>
    <CapsuleSourceRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../..'))</CapsuleSourceRoot>
  </PropertyGroup>

  <Import Project="$(CapsuleSourceRoot)/build/Capsule.Build.targets" />

  <ItemGroup>
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule/Capsule.csproj" />
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule.Runtime.Desktop/Capsule.Runtime.Desktop.csproj" />
    <ProjectReference Include="../Capsule.Bench.Logic/Capsule.Bench.Logic.csproj" />
  </ItemGroup>

</Project>
