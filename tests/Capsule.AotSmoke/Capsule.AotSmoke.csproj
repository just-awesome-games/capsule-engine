<Project Sdk="Microsoft.NET.Sdk">

  <!-- NativeAOT publishing proves the graph is ILC-analysable; running proves the trimmed JSON,
       generated registries, render intent, and shipped fixtures survive. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.AotSmoke</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- An AOT publish restores a runtime-specific ILC compiler pack per CI matrix leg, so no one
         lock file describes this project's restore. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <CapsuleImportScenes>true</CapsuleImportScenes>
    <CapsuleShipAssets>true</CapsuleShipAssets>
    <CapsuleAssetSourcesDir>asset-sources</CapsuleAssetSourcesDir>
    <CapsuleSourceRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../..'))</CapsuleSourceRoot>
  </PropertyGroup>

  <Import Project="$(CapsuleSourceRoot)/build/Capsule.Build.targets" />

  <ItemGroup>
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule/Capsule.csproj" />
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule.Runtime/Capsule.Runtime.csproj" />
    <ProjectReference Include="../Capsule.AotSmoke.Logic/Capsule.AotSmoke.Logic.csproj" />
  </ItemGroup>

</Project>
