<Project>

  <!-- What this project exists to assert. Each check names both directions, so a hook that stopped
       excluding and one that started excluding everything both fail here rather than downstream.

       The kept halves are not ceremony: without them a glob that matched nothing at all would let
       every shipping assertion pass. -->

  <PropertyGroup>
    <!-- The case-variant checks below need casevariant/drivers/ and casevariant/Drivers/ to be two
         directories, which only a case-sensitive filesystem grants. MSBuild names Linux as the one
         such host, and CI runs there; elsewhere the checks announce themselves skipped rather than
         passing quietly. A global property overrides both of these, which is how the Linux branch
         is dry-run on a host that would fold the pair into one directory. -->
    <_CapsuleProofCaseSensitiveFileSystem>$([MSBuild]::IsOSPlatform('Linux'))</_CapsuleProofCaseSensitiveFileSystem>
    <_CapsuleProofCaseVariantDir>drivers</_CapsuleProofCaseVariantDir>
  </PropertyGroup>

  <!-- The compile item for this file is declared in the csproj, at evaluation; only the file itself
       has to be here by the time the compiler reads it. Its marked sibling is committed instead:
       the marker glob runs at evaluation, so a marker a target placed would be found a build late. -->
  <Target Name="CapsuleProofPlaceCaseVariantSource"
          Condition="'$(_CapsuleProofCaseSensitiveFileSystem)' == 'true'"
          BeforeTargets="_GenerateCompileDependencyCache;CoreCompile">
    <Copy SourceFiles="$(MSBuildThisFileDirectory)casevariant/CaseVariantDriver.cs"
          DestinationFolder="$(MSBuildThisFileDirectory)casevariant/$(_CapsuleProofCaseVariantDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- An authoring module as the sheet seam documents one: a sheet derived into this project's own
       obj/ space and added as AdditionalFiles from the seam target. The hook is the whole point —
       the metadata below reaches the generator only through the analyzer configuration the SDK
       writes before the compile, so BeforeTargets="CoreCompile" here would leave the sheet domainless
       and silently unread. -->
  <Target Name="CapsuleProofDeriveModuleSheet" BeforeTargets="CapsuleCollectSheetDocuments">
    <PropertyGroup>
      <_ProofModuleSheetDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'proofmodule'))</_ProofModuleSheetDir>
    </PropertyGroup>

    <Copy SourceFiles="$(MSBuildThisFileDirectory)module/module.sheet.json"
          DestinationFolder="$(_ProofModuleSheetDir)"
          SkipUnchangedFiles="true" />

    <ItemGroup>
      <AdditionalFiles Include="$(_ProofModuleSheetDir)/module.sheet.json">
        <CapsuleAssetDomain>sprites</CapsuleAssetDomain>
        <CapsuleAssetPath>proof/module</CapsuleAssetPath>
      </AdditionalFiles>
    </ItemGroup>
  </Target>

  <Target Name="CapsuleProveModuleSheetRegistry" AfterTargets="CoreCompile">
    <ItemGroup>
      <_ProofAssetRegistry Include="$(IntermediateOutputPath)generated/**/CapsuleAssets.g.cs" />
    </ItemGroup>

    <Error Condition="'@(_ProofAssetRegistry)' == ''"
           Text="BuildProof: no generated CapsuleAssets.g.cs under '$(IntermediateOutputPath)generated'." />

    <ReadLinesFromFile File="@(_ProofAssetRegistry)">
      <Output TaskParameter="Lines" ItemName="_ProofAssetRegistryLine" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_ProofAssetRegistryText>@(_ProofAssetRegistryLine, '%0A')</_ProofAssetRegistryText>
    </PropertyGroup>

    <Error Condition="!$(_ProofAssetRegistryText.Contains('class Proof')) or !$(_ProofAssetRegistryText.Contains('class Module'))"
           Text="BuildProof: the generated asset registry declares no Sprites.Proof.Module, so the module-derived sheet reached the generator without its CapsuleAssetDomain metadata." />
  </Target>

  <Target Name="CapsuleProveDevelopmentOnlyCompile"
          DependsOnTargets="CapsuleRemoveDevelopmentOnlySources"
          BeforeTargets="CoreCompile">
    <ItemGroup>
      <_ProofMarkedSource Include="@(Compile)" Condition="'%(Filename)' == 'DevelopmentOnlyDriver'" />
      <_ProofMarkedAbsoluteSource Include="@(Compile)" Condition="'%(Filename)' == 'AbsoluteDriver'" />
      <_ProofKeptSource Include="@(Compile)" Condition="'%(Filename)' == 'KeptDriver'" />
      <_ProofCaseVariantSource Include="@(Compile)" Condition="'%(Filename)' == 'CaseVariantDriver'" />
      <_ProofCaseVariantMarkedSource Include="@(Compile)" Condition="'%(Filename)' == 'CaseVariantDevDriver'" />
    </ItemGroup>

    <Message Importance="high"
             Condition="'$(_CapsuleProofCaseSensitiveFileSystem)' != 'true'"
             Text="BuildProof: skipping the case-variant checks; this filesystem cannot hold casevariant/drivers/ apart from casevariant/Drivers/. They run on Linux." />

    <Error Condition="'@(_ProofKeptSource)' == ''"
           Text="BuildProof: KeptDriver.cs is not in the compile, so nothing here proves anything." />
    <Error Condition="'$(CapsuleShipping)' == 'true' and '@(_ProofMarkedSource)' != ''"
           Text="BuildProof: a shipping build still compiles Drivers/DevelopmentOnlyDriver.cs, under a .capsuleignore marker." />
    <Error Condition="'$(CapsuleShipping)' != 'true' and '@(_ProofMarkedSource)' == ''"
           Text="BuildProof: an ordinary build does not compile Drivers/DevelopmentOnlyDriver.cs, which a marker must not remove." />
    <Error Condition="'$(CapsuleShipping)' == 'true' and '@(_ProofMarkedAbsoluteSource)' != ''"
           Text="BuildProof: a shipping build still compiles AbsoluteDrivers/AbsoluteDriver.cs, which reaches the compile as an absolute spec under a .capsuleignore marker." />
    <Error Condition="'$(CapsuleShipping)' != 'true' and '@(_ProofMarkedAbsoluteSource)' == ''"
           Text="BuildProof: an ordinary build does not compile AbsoluteDrivers/AbsoluteDriver.cs, which a marker must not remove." />
    <Error Condition="'$(_CapsuleProofCaseSensitiveFileSystem)' == 'true' and '@(_ProofCaseVariantSource)' == ''"
           Text="BuildProof: this build does not compile casevariant/drivers/CaseVariantDriver.cs, an unmarked sibling of the marked casevariant/Drivers/ differing only by case. Either the copy did not land or the removal folded case." />
    <Error Condition="'$(_CapsuleProofCaseSensitiveFileSystem)' == 'true' and '$(CapsuleShipping)' == 'true' and '@(_ProofCaseVariantMarkedSource)' != ''"
           Text="BuildProof: a shipping build still compiles casevariant/Drivers/CaseVariantDevDriver.cs, under a .capsuleignore marker." />
    <Error Condition="'$(_CapsuleProofCaseSensitiveFileSystem)' == 'true' and '$(CapsuleShipping)' != 'true' and '@(_ProofCaseVariantMarkedSource)' == ''"
           Text="BuildProof: an ordinary build does not compile casevariant/Drivers/CaseVariantDevDriver.cs, so the marker beside the case-variant sibling was never found and its survival proves nothing." />
  </Target>

  <Target Name="CapsuleProveDevelopmentOnlyAssets" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_ProofMarkedAsset Include="@(CapsuleAsset)" Condition="'%(Filename)' == 'scratch'" />
      <_ProofKeptAsset Include="@(CapsuleAsset)" Condition="'%(Filename)' == 'kept'" />
    </ItemGroup>

    <Error Condition="'@(_ProofKeptAsset)' == ''"
           Text="BuildProof: Assets/Textures/kept.png is not an asset, so nothing here proves anything." />
    <Error Condition="'$(CapsuleShipping)' == 'true' and '@(_ProofMarkedAsset)' != ''"
           Text="BuildProof: a shipping build still admits Assets/Textures/development/scratch.png, under a .capsuleignore marker." />
    <Error Condition="'$(CapsuleShipping)' != 'true' and '@(_ProofMarkedAsset)' == ''"
           Text="BuildProof: an ordinary build does not admit Assets/Textures/development/scratch.png, which a marker must not remove." />
  </Target>

  <!-- The registry the compiler actually emitted, rather than the compile item list it was built
       from: this is what says a marked driver is unreachable by name in a shipped game. -->
  <Target Name="CapsuleProveDriverRegistry" AfterTargets="CoreCompile">
    <ItemGroup>
      <_ProofDriverRegistry Include="$(IntermediateOutputPath)generated/**/CapsuleInputDrivers.g.cs" />
    </ItemGroup>

    <Error Condition="'@(_ProofDriverRegistry)' == ''"
           Text="BuildProof: no generated CapsuleInputDrivers.g.cs under '$(IntermediateOutputPath)generated'." />

    <ReadLinesFromFile File="@(_ProofDriverRegistry)">
      <Output TaskParameter="Lines" ItemName="_ProofDriverRegistryLine" />
    </ReadLinesFromFile>

    <PropertyGroup>
      <_ProofDriverRegistryText>@(_ProofDriverRegistryLine, '%0A')</_ProofDriverRegistryText>
    </PropertyGroup>

    <Error Condition="!$(_ProofDriverRegistryText.Contains('KeptDriver'))"
           Text="BuildProof: the generated driver registry does not register KeptDriver." />
    <Error Condition="'$(CapsuleShipping)' == 'true' and $(_ProofDriverRegistryText.Contains('DevelopmentOnlyDriver'))"
           Text="BuildProof: a shipping build's driver registry still names DevelopmentOnlyDriver, so --driver would answer to it." />
    <Error Condition="'$(CapsuleShipping)' != 'true' and !$(_ProofDriverRegistryText.Contains('DevelopmentOnlyDriver'))"
           Text="BuildProof: an ordinary build's driver registry does not name DevelopmentOnlyDriver." />
    <Error Condition="'$(CapsuleShipping)' == 'true' and $(_ProofDriverRegistryText.Contains('AbsoluteDriver'))"
           Text="BuildProof: a shipping build's driver registry still names AbsoluteDriver, so an absolute Compile spec escaped the marker." />
    <Error Condition="'$(CapsuleShipping)' != 'true' and !$(_ProofDriverRegistryText.Contains('AbsoluteDriver'))"
           Text="BuildProof: an ordinary build's driver registry does not name AbsoluteDriver." />
    <Error Condition="'$(_CapsuleProofCaseSensitiveFileSystem)' == 'true' and !$(_ProofDriverRegistryText.Contains('CaseVariantDriver'))"
           Text="BuildProof: this build's driver registry does not name CaseVariantDriver, which sits in unmarked casevariant/drivers/ beside the marked casevariant/Drivers/." />
    <Error Condition="'$(_CapsuleProofCaseSensitiveFileSystem)' == 'true' and '$(CapsuleShipping)' == 'true' and $(_ProofDriverRegistryText.Contains('CaseVariantDevDriver'))"
           Text="BuildProof: a shipping build's driver registry still names CaseVariantDevDriver, which sits in the marked casevariant/Drivers/." />
    <Error Condition="'$(_CapsuleProofCaseSensitiveFileSystem)' == 'true' and '$(CapsuleShipping)' != 'true' and !$(_ProofDriverRegistryText.Contains('CaseVariantDevDriver'))"
           Text="BuildProof: an ordinary build's driver registry does not name CaseVariantDevDriver." />
  </Target>

</Project>
