<Project Sdk="Microsoft.NET.Sdk">

  <!-- A consuming logic assembly whose only job is to hold the build's own hooks to their contract:
       it declares a Capsule role, owns an authoring plane, and asserts what the compile and the
       asset plane contain. The assertions are in BuildProof.targets and fail the build.

       CapsuleShipping picks which direction is asserted, so the ordinary build proves a marked
       directory is kept and a build carrying the property proves it is gone. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.BuildProof</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CapsuleGameLogic>true</CapsuleGameLogic>
    <!-- No sheets to import, and the document tool is proved by the sample. -->
    <CapsuleImportSprites>false</CapsuleImportSprites>
    <!-- Its own plane, so the assertions below own every file they count. -->
    <CapsuleAssetSourcesDir>asset-sources</CapsuleAssetSourcesDir>
    <!-- The generated registries on disk are what the driver assertion reads. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CapsuleSourceRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../..'))</CapsuleSourceRoot>
  </PropertyGroup>

  <Import Project="$(CapsuleSourceRoot)/build/Capsule.Build.targets" />
  <Import Project="$(MSBuildThisFileDirectory)BuildProof.targets" />

  <!-- The compile carries one marked source as an absolute spec, which is what a project disabling
       the SDK's default items and globbing from $(MSBuildProjectDirectory) writes. Removed from the
       relative glob first, so the file reaches the compile once, under the other spelling. -->
  <ItemGroup>
    <Compile Remove="AbsoluteDrivers/**/*.cs" />
    <Compile Include="$(MSBuildProjectDirectory)/AbsoluteDrivers/**/*.cs" />
  </ItemGroup>

  <!-- The case-variant proof: drivers/ is an unmarked sibling of the marked Drivers/, which only a
       case-sensitive filesystem can hold apart and no git checkout can carry on one that cannot.
       So it is committed under CaseVariantProof/ and BuildProof.targets copies it into place there;
       the compile item is declared here, at evaluation, so the removal target sees it as the SDK's
       glob would. -->
  <ItemGroup>
    <Compile Remove="CaseVariantProof/**/*.cs" />
  </ItemGroup>

  <!-- The glob removal is conditional too: where case folds it would match the marked Drivers/ and
       empty out the proof above. Where it does not fold it takes the copy's landing site out of the
       SDK's glob, so a second build does not include the file twice. -->
  <ItemGroup Condition="'$(_CapsuleProofCaseSensitiveFileSystem)' == 'true'">
    <Compile Remove="drivers/**/*.cs" />
    <Compile Include="$(MSBuildProjectDirectory)/drivers/CaseVariantDriver.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule/Capsule.csproj" />
  </ItemGroup>

</Project>
