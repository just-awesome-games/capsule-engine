<Project Sdk="Microsoft.NET.Sdk">

  <!-- A consuming logic assembly whose only job is to hold the build's own hooks to their contract:
       it declares a Capsule role, owns an authoring plane, and asserts what the compile and the
       asset plane contain. The assertions are in BuildProof.targets and fail the build.

       CapsuleShipping picks which direction is asserted, so the ordinary build proves a marked
       directory is kept and a build carrying the property proves it is gone. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.BuildProof</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CapsuleGameLogic>true</CapsuleGameLogic>
    <!-- No sheets to import, and the document tool is proved by the sample. -->
    <CapsuleImportSprites>false</CapsuleImportSprites>
    <!-- Its own plane, so the assertions below own every file they count. -->
    <CapsuleAssetSourcesDir>asset-sources</CapsuleAssetSourcesDir>
    <!-- The generated registries on disk are what the driver assertion reads. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CapsuleSourceRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../..'))</CapsuleSourceRoot>
  </PropertyGroup>

  <Import Project="$(CapsuleSourceRoot)/build/Capsule.Build.targets" />
  <Import Project="$(MSBuildThisFileDirectory)BuildProof.targets" />

  <ItemGroup>
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule/Capsule.csproj" />
  </ItemGroup>

</Project>
