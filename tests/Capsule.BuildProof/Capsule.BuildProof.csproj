<Project Sdk="Microsoft.NET.Sdk">

  <!-- A consuming logic assembly whose only job is to hold the build's own hooks to their contract:
       it declares a Capsule role, owns an authoring plane, and asserts what the compile and the
       asset plane contain. The assertions are in BuildProof.targets and fail the build.

       CapsuleShipping picks which direction is asserted, so the ordinary build proves a marked
       directory is kept and a build carrying the property proves it is gone. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.BuildProof</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CapsuleGameLogic>true</CapsuleGameLogic>
    <!-- The generated registries on disk are what the driver assertion reads. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CapsuleSourceRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../..'))</CapsuleSourceRoot>
    <!-- casevariant/ holds the case-variant proof, whose unmarked half the build places rather than
         git. Taking its sources out of the SDK's glob is what lets the compile items be declared
         explicitly below: a second build would otherwise glob the placed file and compile it twice.
         The pattern names *.cs alone, so the marker under casevariant/Drivers/ stays visible to the
         marker glob, which excludes DefaultItemExcludes as well. Set here rather than in a props
         file because MSBuild evaluates every property before any item, including the SDK's own
         default globs. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);casevariant/**/*.cs</DefaultItemExcludes>
  </PropertyGroup>

  <Import Project="$(CapsuleSourceRoot)/build/Capsule.Build.targets" />
  <Import Project="$(MSBuildThisFileDirectory)BuildProof.targets" />

  <!-- The compile carries one marked source as an absolute spec, which is what a project disabling
       the SDK's default items and globbing from $(MSBuildProjectDirectory) writes. Removed from the
       relative glob first, so the file reaches the compile once, under the other spelling. -->
  <ItemGroup>
    <Compile Remove="AbsoluteDrivers/**/*.cs" />
    <Compile Include="$(MSBuildProjectDirectory)/AbsoluteDrivers/**/*.cs" />
  </ItemGroup>

  <!-- The case-variant proof: casevariant/drivers/ is an unmarked sibling of the marked
       casevariant/Drivers/, and only a case-sensitive filesystem holds the two apart. The marked
       half is committed, since the marker must be on disk before evaluation for the marker glob to
       find it; the unmarked half is a name no case-insensitive checkout can carry beside it, so
       BuildProof.targets places it from casevariant/CaseVariantDriver.cs.

       Both compile items are declared here, at evaluation, so the removal target sees them as the
       SDK's glob would. Literal specs, never a wildcard Remove: MSBuild matches a Remove's wildcard
       case-insensitively on every host, so `drivers/**` would also take the marked Drivers/ out on
       the one filesystem this proof runs on. -->
  <ItemGroup Condition="'$(_CapsuleProofCaseSensitiveFileSystem)' == 'true'">
    <Compile Include="$(MSBuildProjectDirectory)/casevariant/Drivers/CaseVariantDevDriver.cs" />
    <Compile Include="$(MSBuildProjectDirectory)/casevariant/$(_CapsuleProofCaseVariantDir)/CaseVariantDriver.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule/Capsule.csproj" />
  </ItemGroup>

</Project>
