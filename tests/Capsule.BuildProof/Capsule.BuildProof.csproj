<Project Sdk="Microsoft.NET.Sdk">

  <!-- A consuming logic assembly whose only job is to hold the build's own hooks to their contract.
       The assertions are in BuildProof.targets and fail the build; CapsuleShipping picks which
       direction each one asserts. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.BuildProof</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CapsuleGameLogic>true</CapsuleGameLogic>
    <!-- The generated registries on disk are what the driver assertion reads. -->
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CapsuleSourceRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../..'))</CapsuleSourceRoot>
  </PropertyGroup>

  <Import Project="$(CapsuleSourceRoot)/build/Capsule.Build.targets" />
  <Import Project="$(MSBuildThisFileDirectory)BuildProof.targets" />

  <ItemGroup>
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule/Capsule.csproj" />
  </ItemGroup>

</Project>
