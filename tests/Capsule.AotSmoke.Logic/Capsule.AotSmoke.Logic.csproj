<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.AotSmoke.Logic</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CapsuleGameLogic>true</CapsuleGameLogic>
    <CapsuleBuildProject>../Capsule.FixtureBuild/Capsule.FixtureBuild.csproj</CapsuleBuildProject>
    <CapsuleSourceRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../..'))</CapsuleSourceRoot>
  </PropertyGroup>

  <!-- Assets/Textures/Packed/.config.json is the only file joining a texture to the smoke atlas.
       A platform whose asset glob skipped a nested dotfile fails this build on an unjoined atlas. -->
  <Import Project="$(CapsuleSourceRoot)/build/Capsule.Build.targets" />

  <ItemGroup>
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule/Capsule.csproj" />
  </ItemGroup>

</Project>
