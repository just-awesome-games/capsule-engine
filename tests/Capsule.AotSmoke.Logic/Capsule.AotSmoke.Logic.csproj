<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.AotSmoke.Logic</RootNamespace>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CapsuleGameLogic>true</CapsuleGameLogic>
    <CapsuleSourceRoot>$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '../..'))</CapsuleSourceRoot>
  </PropertyGroup>

  <Import Project="$(CapsuleSourceRoot)/build/Capsule.Build.targets" />

  <ItemGroup>
    <ProjectReference Include="$(CapsuleSourceRoot)/src/Capsule/Capsule.csproj" />
  </ItemGroup>

  <!-- An authoring module as the sheet seam documents one: a sheet derived into this project's own
       obj/ space and handed to the build tool from the seam target, keyed by %(CapsuleDocumentKey).
       The shell references the sprite it generates, so a key that stopped arriving is a compile
       error there. -->
  <Target Name="CapsuleSmokeDeriveModuleSheet" BeforeTargets="CapsuleCollectSheetDocuments">
    <PropertyGroup>
      <_SmokeModuleSheetDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'smokemodule'))</_SmokeModuleSheetDir>
    </PropertyGroup>

    <Copy SourceFiles="$(MSBuildThisFileDirectory)module/module.sheet.json"
          DestinationFolder="$(_SmokeModuleSheetDir)"
          SkipUnchangedFiles="true" />

    <ItemGroup>
      <CapsuleSheetDocument Include="$(_SmokeModuleSheetDir)/module.sheet.json">
        <CapsuleDocumentKey>smoke/module</CapsuleDocumentKey>
      </CapsuleSheetDocument>
    </ItemGroup>
  </Target>

</Project>
