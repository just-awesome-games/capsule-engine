<Project Sdk="Microsoft.NET.Sdk">

  <!-- The specs that need a window and a device. Each skips on a machine with no display. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.DeviceTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- The reference texture loader the runtime's decode is held equal to. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Capsule.Runtime.Desktop/Capsule.Runtime.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Every alpha from 0 to 255 over six colours, which no shipped PNG exercises. -->
    <None Include="Fixtures/alpha-ramp.png" Link="Pngs/fixtures/alpha-ramp.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Capsule.Bench.Logic/Assets/Textures/*.png" LinkBase="Pngs/bench" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/MinimalGame/src/MinimalGame.Game/Assets/**/*.png" LinkBase="Pngs/sample" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Capsule.Bench.Logic/Assets/Audio/hum.wav" Link="Media/hum.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
