#!/bin/sh
# The local gate on every commit. Release, the whole format pass, pack, the consumer lanes and the
# NativeAOT publishes are CI's. Activate once with: git config core.hooksPath .githooks
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

run() {
    step=$1
    shift
    echo "pre-commit: $step"
    if ! "$@"; then
        echo "pre-commit: $step FAILED"
        exit 1
    fi
}

run "whitespace check" dotnet format whitespace . --folder --verify-no-changes --exclude "**/bin/**" "**/obj/**" "**/artifacts/**"

# Locked first, and every later step with --no-restore: an implicit unlocked restore would
# regenerate a drifted lock file locally instead of failing the way CI does.
run "locked restore" dotnet restore --locked-mode
run "build" dotnet build --no-restore
run "tests" dotnet test --no-build

echo "pre-commit: all gates passed"
