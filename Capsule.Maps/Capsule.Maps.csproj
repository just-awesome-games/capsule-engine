<Project Sdk="Microsoft.NET.Sdk">

  <!-- The map format and its loader. Core only: a map is data, so nothing here may reach a
       device, and a tool that authors maps is never a runtime dependency. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Maps</RootNamespace>
    <PackageId>JAG.Capsule.Maps</PackageId>
    <Description>Capsule's map format and its runtime loader: a tile grid, the palette its tiles draw from, and the typed objects placed over it. Takes no dependency on any authoring tool.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capsule.Core\Capsule.Core.csproj" />
  </ItemGroup>

</Project>
