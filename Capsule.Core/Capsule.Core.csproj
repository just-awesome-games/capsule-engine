<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure engine contracts. Carries no package references at all, so a
       MonoGame type cannot reach game logic: the absence is the enforcement. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule</RootNamespace>
    <PackageId>JAG.Capsule.Core</PackageId>
    <Description>The pure contracts a Capsule game codes against: the simulation seam, the fixed step, input as named actions, and render intent. No package references, so game logic cannot reach a graphics device.</Description>
  </PropertyGroup>

</Project>
