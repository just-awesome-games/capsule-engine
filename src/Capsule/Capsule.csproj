<Project Sdk="Microsoft.NET.Sdk">

  <!-- The pack root for JAG.Capsule: the ProjectReference list below is the package's admission
       list, gated by Capsule.Architecture.targets. This project holds no code, and its empty
       assembly ships anyway, so a reference to the package and one to this project are one graph. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>JAG.Capsule</PackageId>
    <Description>Everything a Capsule game's logic is written against: the simulation seam and its fixed step, input as named actions, render intent, tile grids, collision shapes and queries, and the world of scenes, entities, components and the camera, together with the scene document format and its loader. Substrate-free throughout, so game logic cannot reach a graphics device and a scene is assertable headlessly.</Description>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <!-- NU5128 wants a dependency group beside lib assets. This package deliberately declares no
         dependencies at all. Scoped here; every other package still answers to it. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeCapsulePureModules</TargetsForTfmSpecificContentInPackage>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);IncludeCapsulePureModuleSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Capsule.Core/Capsule.Core.csproj" />
    <ProjectReference Include="../Capsule.Physics/Capsule.Physics.csproj" />
    <ProjectReference Include="../Capsule.Scenes/Capsule.Scenes.csproj" />
  </ItemGroup>

  <!-- The prose documentation ships in the package a game references, so a consumer who never
       clones the repository has it. -->
  <ItemGroup>
    <None Include="../../docs/*.md" Pack="true" PackagePath="docs/" Visible="false" />
  </ItemGroup>

  <!-- Derived from the reference list rather than restated, so a module joins the package by
       being admitted above and nowhere else. -->
  <Target Name="_CapsuleCollectPureModuleAssets">
    <ItemGroup>
      <_CapsulePureModuleAssembly Include="@(ProjectReference->'$(OutputPath)%(Filename).dll')" />
      <_CapsulePureModuleApiReference Include="@(ProjectReference->'$(OutputPath)%(Filename).xml')" />
      <_CapsulePureModuleSymbols Include="@(ProjectReference->'$(OutputPath)%(Filename).pdb')" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeCapsulePureModules" DependsOnTargets="_CapsuleCollectPureModuleAssets">
    <ItemGroup>
      <_CapsuleMissingModuleAssembly Include="@(_CapsulePureModuleAssembly)" Condition="!Exists('%(FullPath)')" />
    </ItemGroup>
    <Error Condition="'@(_CapsuleMissingModuleAssembly)' != ''"
           Text="JAG.Capsule packs every admitted module or none; not built: @(_CapsuleMissingModuleAssembly)." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_CapsulePureModuleAssembly);@(_CapsulePureModuleApiReference)"
                              PackagePath="lib/$(TargetFramework)/" />
    </ItemGroup>
  </Target>

  <Target Name="IncludeCapsulePureModuleSymbols" DependsOnTargets="_CapsuleCollectPureModuleAssets">
    <ItemGroup>
      <TfmSpecificDebugSymbolsFile Include="@(_CapsulePureModuleSymbols)"
                                   TargetPath="%(_CapsulePureModuleSymbols.Filename)%(_CapsulePureModuleSymbols.Extension)"
                                   TargetFramework="$(TargetFramework)" />
    </ItemGroup>
  </Target>

</Project>
