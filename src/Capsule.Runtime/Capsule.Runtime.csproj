<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Runtime</RootNamespace>
    <PackageId>JAG.Capsule.Runtime</PackageId>
    <Description>The platform-neutral Capsule host: window, graphics device, clock, keyboard and gamepad sampling, the interpolating renderer, sound playback, scene hosting and the HostPlatform contract a platform module fills in. The only module that links the graphics backend.</Description>
    <!-- The substrate is one property pair, so a private platform module retargets an unmodified
         source checkout without editing it. -->
    <CapsuleSubstratePackage Condition="'$(CapsuleSubstratePackage)' == ''">MonoGame.Framework.DesktopGL</CapsuleSubstratePackage>
    <CapsuleSubstrateVersion Condition="'$(CapsuleSubstrateVersion)' == ''">3.8.5.1</CapsuleSubstrateVersion>
    <!-- The texture decoder's entry point takes and returns pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/default-font.png"
                      LogicalName="Capsule.Runtime.Assets.default-font.png"
                      Visible="false" />
    <!-- Capsule's sprite shader, compiled by CapsuleBuildSpriteShader below, so a game drawing only
         with it needs no shader tools. -->
    <EmbeddedResource Include="$(IntermediateOutputPath)capsule/sprite.mgfx"
                      LogicalName="Capsule.Runtime.Rendering.Shaders.sprite.mgfx"
                      Visible="false" />
    <None Include="../../THIRD-PARTY-NOTICES.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />

    <!-- "compile" in PrivateAssets is load-bearing: without it MonoGame's reference assemblies
         flow to consumers and a game can write a Microsoft.Xna.Framework using. -->
    <PackageReference Include="$(CapsuleSubstratePackage)" Version="$(CapsuleSubstrateVersion)">
      <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
    </PackageReference>

    <!-- The neutral host holds no implicit location and no native binding; BannedSymbols.txt is
         the list, each entry with its reason. A site that seems to need one belongs in a platform
         module, never under a suppression. -->
    <!-- The decoder MonoGame bundles internally, referenced so a texture decodes off the game
         thread into memory the runtime owns. Hidden from games like the substrate. -->
    <PackageReference Include="StbImageSharp" Version="2.30.16">
      <PrivateAssets>compile</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!-- The pure modules arrive through their pack root, not one by one: referencing them directly
       would emit no package dependency at all, because none of them is a package. -->
  <ItemGroup>
    <ProjectReference Include="../Capsule/Capsule.csproj" />
  </ItemGroup>

  <!-- The sprite shader is built from the template in Capsule.Build, through the same tools and
       code a game's shaders compile through. The tool is referenced for build order only, and no
       package this project packs depends on it. -->
  <Import Project="../../build/Capsule.ShaderTools.targets" />
  <ItemGroup>
    <PackageDownload Include="MonoGame.Tool.Dxc" Version="[$(CapsuleDxcVersion)]" />
    <PackageDownload Include="MonoGame.Tool.Spirvcross" Version="[$(CapsuleSpirvCrossVersion)]" />
    <ProjectReference Include="../Capsule.Build/Capsule.Build.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      ExcludeAssets="all"
                      PrivateAssets="all"
                      Private="false" />
  </ItemGroup>

  <Target Name="CapsuleResolveSpriteShaderTool" DependsOnTargets="ResolveProjectReferences">
    <MSBuild Projects="../Capsule.Build/Capsule.Build.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_CapsuleSpriteShaderTool" />
    </MSBuild>
    <ItemGroup>
      <_CapsuleSpriteShaderToolAssembly Include="%(_CapsuleSpriteShaderTool.RootDir)%(_CapsuleSpriteShaderTool.Directory)*.dll" />
    </ItemGroup>
  </Target>

  <Target Name="CapsuleBuildSpriteShader"
          BeforeTargets="PrepareResources"
          DependsOnTargets="CapsuleResolveSpriteShaderTool"
          Inputs="@(_CapsuleSpriteShaderToolAssembly);../../build/Capsule.ShaderTools.targets"
          Outputs="$(IntermediateOutputPath)capsule/sprite.mgfx">
    <PropertyGroup>
      <_CapsuleDotNetHost>$(DOTNET_HOST_PATH)</_CapsuleDotNetHost>
      <_CapsuleDotNetHost Condition="'$(_CapsuleDotNetHost)' == ''">dotnet</_CapsuleDotNetHost>
    </PropertyGroup>
    <Exec Command="&quot;$(_CapsuleDotNetHost)&quot; &quot;@(_CapsuleSpriteShaderTool)&quot; --engine-shader &quot;$(IntermediateOutputPath)capsule/sprite.mgfx&quot; --dxc &quot;$([MSBuild]::NormalizePath('$(NuGetPackageRoot)', 'monogame.tool.dxc', '$(CapsuleDxcVersion)'))&quot; --spirv-cross &quot;$([MSBuild]::NormalizePath('$(NuGetPackageRoot)', 'monogame.tool.spirvcross', '$(CapsuleSpirvCrossVersion)'))&quot;"
          LogStandardErrorAsError="true"
          StandardOutputImportance="normal" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)capsule/sprite.mgfx;$(IntermediateOutputPath)capsule/capsule-sprite.fx" />
    </ItemGroup>
  </Target>

  <!-- Test access; see AGENTS.md section Public surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Capsule.Tests" />
    <InternalsVisibleTo Include="Capsule.AotSmoke" />
  </ItemGroup>

  <ItemGroup>
    <!-- The serializer generator documents every member of the context it emits; the shipped
         reference lists only the public surface. -->
    <CapsuleGeneratedInternalType Include="Capsule.Runtime.Assets.AtlasMapJsonContext" />
    <CapsuleGeneratedInternalType Include="Capsule.Runtime.Persistence.SaveFileJsonContext" />
  </ItemGroup>

</Project>
