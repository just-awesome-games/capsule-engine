<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Runtime</RootNamespace>
    <PackageId>JAG.Capsule.Runtime</PackageId>
    <Description>The Capsule host a game's shell boots: window, graphics device, clock, keyboard and gamepad sampling, the interpolating renderer, and the crash log. The only module that links the graphics backend.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- "compile" in PrivateAssets is load-bearing: it keeps MonoGame's reference assemblies from
         flowing to consumers, so a game cannot write a Microsoft.Xna.Framework using. Runtime and
         native assets still flow. Dropping it silently reopens the boundary. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1">
      <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The pure modules arrive through their pack root, not one by one: referencing them directly
       would emit no package dependency at all, because none of them is a package. -->
  <ItemGroup>
    <ProjectReference Include="../Capsule/Capsule.csproj" />
  </ItemGroup>

  <!-- NuGet emits a project reference as a minimum-version dependency, but the packages of one
       release are a matched set. The item belongs to NuGet's own pack targets, so the Error is the
       tripwire for it going away rather than silently reverting to the open range. -->
  <Target Name="CapsulePinPureModuleDependency" AfterTargets="_GetProjectReferenceVersions">
    <Error Condition="'@(_ProjectReferencesWithVersions)' == ''"
           Text="Capsule.Runtime could not pin its JAG.Capsule dependency: NuGet no longer exposes _ProjectReferencesWithVersions." />
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'Capsule'"
                                      ProjectVersion="[$(PackageVersion)]" />
    </ItemGroup>
  </Target>

  <!-- The specs assert the headless internals — deadzone filtering, scheduling, letterboxing —
       without widening the public surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Capsule.Tests" />
  </ItemGroup>

</Project>
