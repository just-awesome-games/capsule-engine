<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Runtime</RootNamespace>
    <PackageId>JAG.Capsule.Runtime</PackageId>
    <Description>The platform-neutral Capsule host: window, graphics device, clock, keyboard and gamepad sampling, the interpolating renderer, sound playback, scene hosting and the HostPlatform contract a platform module fills in. The only module that links the graphics backend.</Description>
    <!-- The substrate is one property pair. A private platform module retargets an unmodified
         source checkout without editing it. -->
    <CapsuleSubstratePackage Condition="'$(CapsuleSubstratePackage)' == ''">MonoGame.Framework.DesktopGL</CapsuleSubstratePackage>
    <CapsuleSubstrateVersion Condition="'$(CapsuleSubstrateVersion)' == ''">3.8.5.1</CapsuleSubstrateVersion>
    <!-- The texture decoder's entry point takes and returns pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/default-font.png"
                      LogicalName="Capsule.Runtime.Assets.default-font.png"
                      Visible="false" />
    <!-- Capsule's sprite shader, committed compiled in every format the engine reads, its fragment
         as sprite and its vertex stage as vertex. A game drawing only with it needs no shader tools.
         ShaderBuildTests holds each equal to what the template compiles to, and a native publish
         keeps only the formats its runtime identifier reads. -->
    <EmbeddedResource Include="Rendering/Shaders/*.shader"
                      LogicalName="Capsule.Runtime.Rendering.Shaders.%(Filename)%(Extension)"
                      Visible="false" />
    <None Include="../../THIRD-PARTY-NOTICES.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />

    <!-- "compile" in PrivateAssets is load-bearing: without it MonoGame's reference assemblies
         flow to consumers and a game can write a Microsoft.Xna.Framework using. -->
    <PackageReference Include="$(CapsuleSubstratePackage)" Version="$(CapsuleSubstrateVersion)">
      <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
    </PackageReference>

    <!-- The decoder MonoGame bundles internally, referenced so a texture decodes off the game
         thread into memory the runtime owns. Hidden from games like the substrate. -->
    <PackageReference Include="StbImageSharp" Version="2.30.16">
      <PrivateAssets>compile</PrivateAssets>
    </PackageReference>

    <!-- A site that seems to need a banned symbol belongs in a platform module, never under a
         suppression. Sdl/ alone holds a native binding, the SDL3 every platform shares, which its
         own .editorconfig admits. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!-- The pure modules arrive through their pack root, not one by one: referencing them directly
       would emit no package dependency at all, because none of them is a package. -->
  <ItemGroup>
    <ProjectReference Include="../Capsule/Capsule.csproj" />
  </ItemGroup>

  <!-- The community controller database, committed as plain text so an update is a reviewable diff
       and embedded gzipped. The shipping runtime already links gzip for scene documents. -->
  <UsingTask TaskName="CapsuleGzipFile"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <Destination ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // SmallestSize is 3, which an MSBuild on .NET Framework lacks.
        CompressionLevel level = Enum.IsDefined(typeof(CompressionLevel), 3) ? (CompressionLevel)3 : CompressionLevel.Optimal;
        Directory.CreateDirectory(Path.GetDirectoryName(Destination));
        using (FileStream input = File.OpenRead(Source))
        using (FileStream output = File.Create(Destination))
        using (GZipStream gzip = new GZipStream(output, level))
        {
            input.CopyTo(gzip);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <_CapsuleGamepadMappings>$(MSBuildThisFileDirectory)Input/gamecontrollerdb.txt</_CapsuleGamepadMappings>
  </PropertyGroup>

  <Target Name="CapsuleCompressGamepadMappings"
          Inputs="$(_CapsuleGamepadMappings)"
          Outputs="$(IntermediateOutputPath)gamecontrollerdb.txt.gz">
    <CapsuleGzipFile Source="$(_CapsuleGamepadMappings)" Destination="$(IntermediateOutputPath)gamecontrollerdb.txt.gz" />
  </Target>

  <!-- Apart from the compression so the resource is declared even when that target is up to date. -->
  <Target Name="CapsuleEmbedGamepadMappings"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="CapsuleCompressGamepadMappings">
    <ItemGroup>
      <EmbeddedResource Include="$(IntermediateOutputPath)gamecontrollerdb.txt.gz"
                        LogicalName="Capsule.Runtime.Input.gamecontrollerdb.txt.gz" />
      <FileWrites Include="$(IntermediateOutputPath)gamecontrollerdb.txt.gz" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Capsule.Tests" />
    <InternalsVisibleTo Include="Capsule.AotSmoke" />
    <InternalsVisibleTo Include="Capsule.Bench" />
  </ItemGroup>

  <ItemGroup>
    <!-- The serializer generator documents every member of the context it emits; the shipped
         reference lists only the public surface. -->
    <CapsuleGeneratedInternalType Include="Capsule.Runtime.Persistence.SaveFileJsonContext" />
  </ItemGroup>

</Project>
