<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Runtime</RootNamespace>
    <PackageId>JAG.Capsule.Runtime</PackageId>
    <Description>The Capsule host a game's shell references, on SDL3 for Windows, Linux and macOS: window, GPU device, clock, input sampling, the renderer, sound playback, scene hosting, content and saves, and the HostPlatform a port overrides.</Description>
    <!-- The texture decoder's entry point and the SDL3 bindings take and return pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/default-font.png"
                      LogicalName="Capsule.Runtime.Assets.default-font.png"
                      Visible="false" />
    <!-- Capsule's sprite shader, committed compiled in every format the engine reads, its fragment
         as sprite and its vertex stage as vertex. A game drawing only with it needs no shader tools.
         ShaderBuildTests holds each equal to what the template compiles to, and a native publish
         keeps only the formats its runtime identifier reads. -->
    <EmbeddedResource Include="Rendering/Shaders/*.shader"
                      LogicalName="Capsule.Runtime.Rendering.Shaders.%(Filename)%(Extension)"
                      Visible="false" />
    <None Include="../../THIRD-PARTY-NOTICES.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />

    <!-- A site that seems to need a banned symbol belongs in Platform/, whose .editorconfig admits
         it, never under a suppression. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <!-- SDL3 for each desktop runtime identifier, which natives/ builds. A port supplies its own. -->
  <ItemGroup>
    <PackageReference Include="JAG.Capsule.Native.SDL3" Version="3.4.18.5" />
  </ItemGroup>

  <!-- The pure modules arrive through their pack root, not one by one: referencing them directly
       would emit no package dependency at all, because none of them is a package. -->
  <ItemGroup>
    <ProjectReference Include="../Capsule/Capsule.csproj" />
  </ItemGroup>

  <!-- The community controller database, committed as plain text so an update is a reviewable diff,
       and embedded gzipped once per desktop platform so the runtime reads only its own lines and a
       native publish drops the others. A line naming no platform goes into every one. The shipping
       runtime already links gzip for scene documents. -->
  <UsingTask TaskName="CapsuleSplitGamepadMappings"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <OutputDirectory ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.IO.Compression" />
      <Using Namespace="System.Text" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // SDL's platform names, keyed to the file each platform's lines go in.
        Dictionary<string, string> files = new Dictionary<string, string>
        {
            { "Windows", "windows" },
            { "Linux", "linux" },
            { "Mac OS X", "macos" },
        };
        Dictionary<string, StringBuilder> lines = new Dictionary<string, StringBuilder>();
        foreach (string file in files.Values)
        {
            lines[file] = new StringBuilder();
        }

        foreach (string line in File.ReadAllLines(Source))
        {
            if (line.Length == 0 || line[0] == '#')
            {
                continue;
            }

            int field = line.IndexOf("platform:", StringComparison.Ordinal);
            if (field < 0)
            {
                foreach (StringBuilder text in lines.Values)
                {
                    text.Append(line).Append('\n');
                }

                continue;
            }

            int start = field + "platform:".Length;
            int end = line.IndexOf(',', start);
            string file;
            if (files.TryGetValue(end < 0 ? line.Substring(start) : line.Substring(start, end - start), out file))
            {
                lines[file].Append(line).Append('\n');
            }
        }

        // SmallestSize is 3, which an MSBuild on .NET Framework lacks.
        CompressionLevel level = Enum.IsDefined(typeof(CompressionLevel), 3) ? (CompressionLevel)3 : CompressionLevel.Optimal;
        Directory.CreateDirectory(OutputDirectory);
        foreach (KeyValuePair<string, StringBuilder> entry in lines)
        {
            using (FileStream output = File.Create(Path.Combine(OutputDirectory, "gamecontrollerdb." + entry.Key + ".txt.gz")))
            using (GZipStream gzip = new GZipStream(output, level))
            {
                byte[] text = new UTF8Encoding(false).GetBytes(entry.Value.ToString());
                gzip.Write(text, 0, text.Length);
            }
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <PropertyGroup>
    <_CapsuleGamepadMappings>$(MSBuildThisFileDirectory)Input/gamecontrollerdb.txt</_CapsuleGamepadMappings>
  </PropertyGroup>

  <ItemGroup>
    <_CapsuleGamepadMappingsFile Include="windows;linux;macos" Path="$(IntermediateOutputPath)gamecontrollerdb.%(Identity).txt.gz" />
  </ItemGroup>

  <Target Name="CapsuleSplitGamepadMappings"
          Inputs="$(_CapsuleGamepadMappings)"
          Outputs="@(_CapsuleGamepadMappingsFile->'%(Path)')">
    <CapsuleSplitGamepadMappings Source="$(_CapsuleGamepadMappings)" OutputDirectory="$(IntermediateOutputPath)" />
  </Target>

  <!-- Apart from the split so the resources are declared even when that target is up to date. -->
  <Target Name="CapsuleEmbedGamepadMappings"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="CapsuleSplitGamepadMappings">
    <ItemGroup>
      <EmbeddedResource Include="@(_CapsuleGamepadMappingsFile->'%(Path)')"
                        LogicalName="Capsule.Runtime.Input.gamecontrollerdb.%(_CapsuleGamepadMappingsFile.Identity).txt.gz" />
      <FileWrites Include="@(_CapsuleGamepadMappingsFile->'%(Path)')" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Capsule.Tests" />
    <InternalsVisibleTo Include="Capsule.AotSmoke" />
    <InternalsVisibleTo Include="Capsule.Bench" />
  </ItemGroup>

  <ItemGroup>
    <!-- The serializer generator documents every member of the context it emits; the shipped
         reference lists only the public surface. -->
    <CapsuleGeneratedInternalType Include="Capsule.Runtime.Persistence.SaveFileJsonContext" />
  </ItemGroup>

</Project>
