<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Runtime</RootNamespace>
    <PackageId>JAG.Capsule.Runtime</PackageId>
    <Description>The Capsule host a game's shell boots: window, graphics device, clock, keyboard and gamepad sampling, the interpolating renderer, and the crash log. The only module that links the graphics backend.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/default-font.png"
                      LogicalName="Capsule.Runtime.Assets.default-font.png"
                      Visible="false" />
    <None Include="../../THIRD-PARTY-NOTICES.md"
          Pack="true"
          PackagePath="/"
          Visible="false" />

    <!-- "compile" in PrivateAssets is load-bearing: without it MonoGame's reference assemblies
         flow to consumers and a game can write a Microsoft.Xna.Framework using. -->
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1">
      <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
    </PackageReference>

    <!-- Already in the graph as MonoGame's dependency; named here because the streaming voice
         decodes against it directly. Pinned to the version MonoGame resolves. -->
    <PackageReference Include="NVorbis" Version="0.10.4">
      <PrivateAssets>compile;contentfiles;analyzers;build</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The pure modules arrive through their pack root, not one by one: referencing them directly
       would emit no package dependency at all, because none of them is a package. -->
  <ItemGroup>
    <ProjectReference Include="../Capsule/Capsule.csproj" />
  </ItemGroup>

  <!-- NuGet emits a project reference as a minimum-version dependency, but the packages of one
       release are a matched set. The Error is the tripwire for NuGet's item going away rather than
       this silently reverting to the open range. -->
  <Target Name="CapsulePinPureModuleDependency" AfterTargets="_GetProjectReferenceVersions">
    <Error Condition="'@(_ProjectReferencesWithVersions)' == ''"
           Text="Capsule.Runtime could not pin its JAG.Capsule dependency: NuGet no longer exposes _ProjectReferencesWithVersions." />
    <ItemGroup>
      <_ProjectReferencesWithVersions Condition="'%(Filename)' == 'Capsule'"
                                      ProjectVersion="[$(PackageVersion)]" />
    </ItemGroup>
  </Target>

  <!-- Test access; see AGENTS.md section Public surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Capsule.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The serializer generator documents every member of the context it emits; the shipped
         reference lists only the public surface. -->
    <CapsuleGeneratedInternalType Include="Capsule.Runtime.Assets.AtlasMapJsonContext" />
  </ItemGroup>

</Project>
