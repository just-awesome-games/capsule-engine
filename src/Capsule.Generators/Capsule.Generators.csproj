<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;SelfContained;RuntimeIdentifier">

  <!-- Registry generators (entity, scene, asset) and game-boundary analyzer. netstandard2.0 because
       the compiler loads an analyzer into its own process, pinned to the oldest Roslyn whose API this
       needs; a generator runs on any newer compiler, never an older one. It ships to no game output. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Capsule.Generators</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- RS2008 tracks diagnostic IDs across released analyzer packages. This generator is
         consumed from a source clone at a pinned ref, so the ref is the release record. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- Local, never global, with TreatAsLocalProperty on the Project element: NuGet's restore
         walk strips nothing, so without the guard it evaluates this project for a consumer's
         NativeAOT publish runtime and fails (NETSDK1207 on netstandard2.0). -->
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The key rule, compiled rather than referenced: a generator loads no engine assembly, and a
         second copy of the rule would let the compile-time and run-time halves drift apart. -->
    <Compile Include="../Capsule.Core/Assets/AssetPaths.cs" Link="AssetPaths.cs" />
  </ItemGroup>

</Project>
