<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;SelfContained;RuntimeIdentifier">

  <!-- The drawer of Capsule's dev-time command-line utilities. No game references it, which is why
       every line of Tiled parsing lives here rather than in Capsule.Scenes: a game runtime never
       links an authoring format. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Cli</RootNamespace>
    <AssemblyName>Capsule.Cli</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capsule.Scenes\Capsule.Scenes.csproj" />
  </ItemGroup>

</Project>
