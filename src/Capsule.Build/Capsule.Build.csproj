<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;SelfContained;RuntimeIdentifier">

  <!-- The package and the process at once. JAG.Capsule.Build ships the build targets, the
       generators and this assembly, which is the scene-document process those targets run out of
       process: it validates and canonically re-emits every *.scene.json a game ships. No game
       references it and nothing invokes it by hand, so it packs unlisted under tools/ with no
       reference assembly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Build</RootNamespace>
    <AssemblyName>Capsule.Build</AssemblyName>
    <PackageId>JAG.Capsule.Build</PackageId>
    <Description>Build integration, source generators, analyzers, and scene-document tooling for Capsule games.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <IncludeSymbols>false</IncludeSymbols>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier></RuntimeIdentifier>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeCapsuleBuildAssets</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Capsule.Scenes/Capsule.Scenes.csproj" />
    <ProjectReference Include="../Capsule.Generators/Capsule.Generators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../build/Capsule.Build.targets" Pack="true" PackagePath="buildTransitive/JAG.Capsule.Build.targets" />
    <None Include="../../build/Capsule.SceneDocuments.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../build/Capsule.Assets.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../build/Capsule.Compiler.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../build/Capsule.Icon.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../build/Capsule.ApiReference.targets" Pack="true" PackagePath="buildTransitive/" />
    <!-- Beside the targets that name them, so $(MSBuildThisFileDirectory) resolves to the same
         pair whether a game builds against the packages or an engine clone. -->
    <None Include="../../build/Icon.ico" Pack="true" PackagePath="buildTransitive/" />
    <None Include="../../build/Icon.bmp" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <!-- The whole output directory, not the entry assembly: the process loads Capsule.Scenes and
       its spine, and those ship beside it so it resolves without a game's package graph. -->
  <Target Name="IncludeCapsuleBuildAssets">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutDir)*.dll" PackagePath="tools/net10.0/any/" />
      <TfmSpecificPackageFile Include="$(OutDir)*.json" PackagePath="tools/net10.0/any/" />
      <TfmSpecificPackageFile Include="../Capsule.Generators/bin/$(Configuration)/netstandard2.0/Capsule.Generators.dll" PackagePath="analyzers/dotnet/cs/" />
    </ItemGroup>
  </Target>

</Project>
