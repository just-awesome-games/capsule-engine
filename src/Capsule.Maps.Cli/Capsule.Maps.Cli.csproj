<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;SelfContained;RuntimeIdentifier">

  <!-- A dev-time tool. No game references it, which is why every line of Tiled parsing lives
       here rather than in Capsule.Maps: a game runtime never links an authoring format. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Maps.Cli</RootNamespace>
    <AssemblyName>Capsule.Maps.Cli</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- Nothing here is a reference a consumer compiles against, so it carries no API reference. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier></RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capsule.Maps\Capsule.Maps.csproj" />
  </ItemGroup>

</Project>
