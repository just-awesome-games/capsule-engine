<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure engine contracts. No package references at all, so no backend type can reach game
       logic: the absence is the enforcement. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule</RootNamespace>
    <!-- Packed as part of JAG.Capsule, never as an ID of its own: Capsule/Capsule.csproj. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Host seams and test access; see AGENTS.md section Public surface. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Capsule.Physics" />
    <InternalsVisibleTo Include="Capsule.Scenes" />
    <InternalsVisibleTo Include="Capsule.Runtime" />
    <InternalsVisibleTo Include="Capsule.Tests" />
    <InternalsVisibleTo Include="Capsule.Build" />
  </ItemGroup>

</Project>
