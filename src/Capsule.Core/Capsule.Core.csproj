<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pure engine contracts. No package references at all, so no backend type can reach game
       logic: the absence is the enforcement. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule</RootNamespace>
    <!-- Packed as part of JAG.Capsule, never as an ID of its own: Capsule/Capsule.csproj. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- ISimulation is the host's seam, not a surface a game implements, and FrameView.Space is how a
       scene routes a renderer onto the layer its entity lives in. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Capsule.Scenes" />

    <!-- Also SnapshotLatch, which carries a frame's sample to the step that consumes it; the
         audio the host plays: AssetCollection.Clips, and Voice.Slot and Voice.Generation, which
         are how a command addresses the host's voice table; and StepInterpolation, the one form
         every frame-alpha interpolation takes so a stationary sample cannot drift. -->
    <InternalsVisibleTo Include="Capsule.Runtime" />
    <InternalsVisibleTo Include="Capsule.Tests" />

    <!-- AssetPaths is the grammar both document formats name a texture by, and the sheet format
         lives in the build tool. -->
    <InternalsVisibleTo Include="Capsule.Build" />
  </ItemGroup>

</Project>
