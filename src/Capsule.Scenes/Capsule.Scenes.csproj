<Project Sdk="Microsoft.NET.Sdk">

  <!-- The world: a scene, its entities and their components, the tile grid its terrain is, and the
       scene document it is composed from. Substrate-free — Core only. Parsers for authoring formats
       live outside this repository. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Scenes</RootNamespace>
    <!-- Packed as part of JAG.Capsule, never as an ID of its own: Capsule/Capsule.csproj. -->
    <IsPackable>false</IsPackable>
    <!-- The engine's own DebugDraw emitters are compiled into the one package build; in a shipping
         game they stop at the seam's null check, since no host attaches a buffer there. -->
    <DefineConstants>$(DefineConstants);CAPSULE_DEVELOPMENT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Capsule.Physics/Capsule.Physics.csproj" />
    <ProjectReference Include="../Capsule.Core/Capsule.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime and tests access the scene registry, document composition, and the empty input
         driver registry a game declaring no driver is configured with; the runtime also sets
         Run.Canvas, only on the run it owns for its debug overlay, to follow the back buffer, and
         its debug menu requests a registered scene through Run.TryRequest by whichever form the
         registry composes it from, rewrites that overlay's frame through
         SceneSimulation.RewriteView between steps, and fills its inspection panel through
         Entity.RunInspect. -->
    <InternalsVisibleTo Include="Capsule.Runtime" />
    <InternalsVisibleTo Include="Capsule.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The serializer generator documents every member of the context it emits; the shipped
         reference lists only the public surface. -->
    <CapsuleGeneratedInternalType Include="Capsule.Scenes.Documents.SceneDocumentJsonContext" />
  </ItemGroup>

</Project>
