<Project Sdk="Microsoft.NET.Sdk">

  <!-- The world: a scene, the entities on it and their components, the tile grid its terrain is,
       and the scene document a scene is composed from. Substrate-free — Core only — so it passes
       the purity admission test and a game's logic and its headless tests reference it directly.
       Parsers for authoring formats belong in Capsule.Cli, never here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Capsule.Scenes</RootNamespace>
    <!-- Packed as part of JAG.Capsule, never as an ID of its own: Capsule/Capsule.csproj. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Capsule.Collision\Capsule.Collision.csproj" />
    <ProjectReference Include="..\Capsule.Core\Capsule.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime and tests access the scene registry and document composition. -->
    <InternalsVisibleTo Include="Capsule.Runtime" />
    <InternalsVisibleTo Include="Capsule.Tests" />
  </ItemGroup>

</Project>
